     y -= 120;
     p->tag.len = 3;
     p->code = 0x60; /* TILE */
-    p->r = r;
-    p->g = g;
-    p->b = b;
+    p->r = rgb >> 16;
+    p->g = rgb >> 8;
+    p->b = rgb;
     p->x = x << sx;
     p->y = y << sy;
     p->w = w << sx;
@@ -448,44 +455,109 @@ static void Stg30_EvoTile(GfxPartOTag *ot, s32 x, s32 y, s32 w, s32 h, s32 r, s3
     Sys_State.packet.addr = (sptr)(p + 1);
 }
 
-/* The bar's place: above the slot's HUD box, under its name (Stg30_FighterHudNamePos). */
-#define EVO_BAR_X0 17
-#define EVO_BAR_STEP 99
-#define EVO_BAR_Y 197
-#define EVO_BAR_W 84
-#define EVO_BAR_H 3
+s32 Stg30_EvoHudLift(void) {
+    return Stg30_EvoLift;
+}
+
+/* The party HUD box (slot 0; slots 99 apart), as the game draws it: x 13..107, its bottom edge
+ * (grey, navy, grey, shadow) at y 225..228 before the lift. The DP row extends the box downwards
+ * under the name strip, in the box's colours, with an "HP"-style label and gauge. */
+#define EVO_BOX_X 13
+#define EVO_BOX_STEP 99
+#define EVO_BOX_W 95
+#define EVO_ROW_Y 215 /* where the lifted box's bottom edge was: the row starts there */
+#define EVO_ROW_H 14
+#define EVO_LABEL_X 50 /* the "HP" / "MP" labels' x */
+#define EVO_GAUGE_X 62 /* the HP / MP gauges: 40 wide, 4 rows and a shadow row */
+#define EVO_GAUGE_W 40
+
+/* "DP" in the labels' 4 x 5 letters */
+static const u8 Stg30_EvoGlyphs[2][5] = { { 0xE, 0x9, 0x9, 0x9, 0xE }, { 0xE, 0x9, 0xE, 0x8, 0x8 } };
+
+static void Stg30_EvoGauge(GfxPartOTag *ot, s32 x, s32 y, s32 fill, const u32 *rows) {
+    s32 i;
+
+    /* drawn last = on top: the filled part, then the empty part under it */
+    for (i = 0; i < 4; i++) {
+        Stg30_EvoTile(ot, x, y + i, fill, 1, rows[i]);
+    }
+    Stg30_EvoTile(ot, x, y, EVO_GAUGE_W, 4, 0x082163);
+    Stg30_EvoTile(ot, x, y + 4, EVO_GAUGE_W, 1, 0x0C2567);
+}
 
 void Stg30_EvoDrawBar(s32 slot, void *parts) {
+    static const u32 green[4] = { 0x04461C, 0xCAFBE2, 0x25FB88, 0x04461C };  /* the HP gauge's rows */
+    static const u32 gold[4] = { 0x463A04, 0xFFF6C8, 0xFBC825, 0x463A04 };
+    static const u32 white[4] = { 0x464646, 0xFFFFFF, 0xE8F4FF, 0x464646 };
+    static const u32 blue[4] = { 0x042A46, 0xC8EEFF, 0x28B4FB, 0x042A46 };
     Stg30Evo *e;
     GfxPartOTag *ot;
     s32 x;
+    s32 y;
+    s32 i;
+    s32 j;
     s32 fill;
-    s32 blink;
 
-    if (!Host_FpBattleEvo() || slot < 0 || slot >= 3 || parts == NULL) {
+    if (Stg30_EvoLift == 0 || slot < 0 || slot >= 3 || parts == NULL) {
         return;
     }
     e = &Stg30_Evo[slot];
-    if (e->turnsLeft == 0 && !e->revert && Stg30_EvoTarget(slot) == 0) {
-        return; /* no Champion form to reach */
-    }
     ot = (GfxPartOTag *)Sys_State.otLayers.addr[((u8 *)parts)[0x0B]]; /* the first part's otLayer (Rec1D6B4) */
-    x = EVO_BAR_X0 + slot * EVO_BAR_STEP;
-    /* drawn last = on top: the fill first, then its frame */
+    x = EVO_BOX_X + slot * EVO_BOX_STEP;
+    y = EVO_ROW_Y;
+    /* drawn last = on top, so the contents first: the gauge */
     if (e->turnsLeft != 0 || e->revert) {
-        /* in the Champion form: the turns it has left, light blue */
+        /* in the Champion form: the turns it has left, in blue */
         s32 n = e->revert ? 0 : e->turnsLeft > EVO_TURNS ? EVO_TURNS : e->turnsLeft;
 
-        fill = EVO_BAR_W * n / EVO_TURNS;
-        Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0x40, 0xC0, 0xFF);
+        Stg30_EvoGauge(ot, x - EVO_BOX_X + EVO_GAUGE_X, y + 2, EVO_GAUGE_W * n / EVO_TURNS, blue);
+    } else if (Stg30_EvoTarget(slot) == 0) {
+        Stg30_EvoGauge(ot, x - EVO_BOX_X + EVO_GAUGE_X, y + 2, 0, green); /* no Champion form: empty */
     } else {
-        fill = EVO_BAR_W * e->energy / EVO_MAX;
+        fill = EVO_GAUGE_W * e->energy / EVO_MAX;
+        if (e->energy > 0 && fill == 0) {
+            fill = 1;
+        }
         if (e->energy >= EVO_MAX && Stg30_Battle.digis[slot].hp != 0) {
-            blink = (Sys_State.frameCount >> 3) & 1; /* full: flashes gold and white */
-            Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0xFF, blink ? 0xFF : 0xD0, blink ? 0xFF : 0x20);
+            /* full: Digivolve is in its menu; flashes gold and white */
+            Stg30_EvoGauge(ot, x - EVO_BOX_X + EVO_GAUGE_X, y + 2, fill, (Sys_State.frameCount >> 3) & 1 ? white : gold);
         } else {
-            Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0xFF, 0x80, 0x10);
+            Stg30_EvoGauge(ot, x - EVO_BOX_X + EVO_GAUGE_X, y + 2, fill, green);
+        }
+    }
+    /* the label, with the labels' dark shadow down and right */
+    for (j = 0; j < 2; j++) {
+        for (i = 0; i < 5; i++) {
+            s32 b;
+
+            for (b = 0; b < 4; b++) {
+                if (Stg30_EvoGlyphs[j][i] & (8 >> b)) {
+                    Stg30_EvoTile(ot, x - EVO_BOX_X + EVO_LABEL_X + j * 6 + b, y + 2 + i, 1, 1, 0x8CCECE);
+                }
+            }
+        }
+    }
+    for (j = 0; j < 2; j++) {
+        for (i = 0; i < 5; i++) {
+            s32 b;
+
+            for (b = 0; b < 4; b++) {
+                if (Stg30_EvoGlyphs[j][i] & (8 >> b)) {
+                    Stg30_EvoTile(ot, x - EVO_BOX_X + EVO_LABEL_X + j * 6 + b + 1, y + 3 + i, 1, 1, 0x000004);
+                }
+            }
         }
     }
-    Stg30_EvoTile(ot, x - 1, EVO_BAR_Y - 1, EVO_BAR_W + 2, EVO_BAR_H + 2, 0x10, 0x10, 0x20);
+    /* the box's own edges, continued: bottom (grey, navy, grey, shadow), sides, then the fill */
+    Stg30_EvoTile(ot, x, y + EVO_ROW_H - 4, EVO_BOX_W, 1, 0x5A5A5A);
+    Stg30_EvoTile(ot, x + 1, y + EVO_ROW_H - 3, EVO_BOX_W - 2, 1, 0x001873);
+    Stg30_EvoTile(ot, x, y + EVO_ROW_H - 2, EVO_BOX_W, 1, 0x5A5A5A);
+    Stg30_EvoTile(ot, x + 1, y + EVO_ROW_H - 1, EVO_BOX_W, 1, 0x000010);
+    Stg30_EvoTile(ot, x, y, 1, EVO_ROW_H - 4, 0xB5B5B5);
+    Stg30_EvoTile(ot, x + 1, y, 1, EVO_ROW_H - 3, 0x00106B);
+    Stg30_EvoTile(ot, x + 2, y, 1, EVO_ROW_H - 4, 0xB5B5B5);
+    Stg30_EvoTile(ot, x + EVO_BOX_W - 3, y, 1, EVO_ROW_H - 4, 0x525252);
+    Stg30_EvoTile(ot, x + EVO_BOX_W - 2, y, 1, EVO_ROW_H - 3, 0x001873);
+    Stg30_EvoTile(ot, x + EVO_BOX_W - 1, y, 1, EVO_ROW_H - 4, 0x525252);
+    Stg30_EvoTile(ot, x + 3, y, EVO_BOX_W - 6, EVO_ROW_H - 4, 0x4A638C);
 }
