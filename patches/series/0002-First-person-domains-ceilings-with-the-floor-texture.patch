From 787f77b293afb1d0f433577d2f29f7ada38cce93 Mon Sep 17 00:00:00 2001
From: FP mod <fpmod@localhost>
Date: Sun, 25 Oct 2026 22:02:23 +0000
Subject: [PATCH 02/28] First-person domains: ceilings with the floor texture
 on walled floors

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01B1oHeiADE8njqFxkaQnJAX
---
 doc/FPVIEW.md                  | 4 +++-
 src/stag4000/fpview_math.inc   | 2 ++
 src/stag4000/fpview_native.inc | 9 +++++++++
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/doc/FPVIEW.md b/doc/FPVIEW.md
index f65207f..8fb9122 100644
--- a/doc/FPVIEW.md
+++ b/doc/FPVIEW.md
@@ -34,6 +34,9 @@ before, and the PS1 matching build is untouched: every change is inside `#ifdef
   double-buffered area, a static array inside the 16 MB window the 24-bit OT links reach, so
   the floor never takes room from the game's models. Without precise geometry (no wobble and
   smooth frames both off) floors are cut 2 x 2 and walls 2 x 1 against affine texture warp.
+- **Ceilings** on walled floors (walls going up): each floor tile gets a ceiling at the wall
+  tops with its own floor texture, a little darker (`FP_CEILING`, `FP_CEILING_SHADE`).
+  Platform floors have no walls above them, so they stay open to the black background.
 - **Walls** keep the retail templates and the retail cull rule (`Stg40_DrawTileWalls`), so
   walled floors show walls from inside, and platform floors (cliffs going down) show the
   cliffs that face you.
@@ -52,7 +55,6 @@ before, and the PS1 matching build is untouched: every change is inside `#ifdef
 
 ## Known limits
 
-- No ceilings: above the walls is the black background.
 - Camera scripts (floor intro, scrolls to a target when shooting a Gift or reading enemy info)
   are not shown; the view stays in the beetle.
 - Entities far from the beetle need their files in the CD cache, as the 16:9 side columns do.
diff --git a/src/stag4000/fpview_math.inc b/src/stag4000/fpview_math.inc
index 3e88435..3f09645 100644
--- a/src/stag4000/fpview_math.inc
+++ b/src/stag4000/fpview_math.inc
@@ -18,6 +18,8 @@
 #define FP_FOG_END (FP_TILE * (STG40_FP_RADIUS - 0.5f))
 #define FP_FLOOR_BIAS 96        /* OT entries a floor sorts behind its centre (entities on it) */
 #define FP_SHADOW_BIAS (FP_FLOOR_BIAS - 6)
+#define FP_CEILING 1            /* ceilings over floor tiles on walled floors, floor texture */
+#define FP_CEILING_SHADE 0x58   /* ceilings a little darker than the floor (0x7F) */
 #define FP_TURN_STEP 0x100      /* camera yaw per frame (as the beetle turns) */
 #define FP_PACKET_BYTES 0x18000 /* the floor's own packet area per frame buffer */
 #define FP_MAXV 12              /* vertices of a clipped polygon (4 + 5 planes, rounded up) */
diff --git a/src/stag4000/fpview_native.inc b/src/stag4000/fpview_native.inc
index f170711..3f12481 100644
--- a/src/stag4000/fpview_native.inc
+++ b/src/stag4000/fpview_native.inc
@@ -403,6 +403,15 @@ static void Stg40_FpDrawCell(Stg40FpCtx *c, Stg40FloorWork *w, s32 mapCol, s32 m
         }
         Stg40_FpQuadN(c, (const float(*)[3])p, &w->prims[Stg40_FloorPrimIdx[prim & 0x7F]], 0x7F, 0,
                       FP_FLOOR_BIAS, sub, sub);
+        /* ceiling: the same tile's floor texture at the wall tops, on floors whose walls go
+         * up (step < 0); platform floors have no walls above to close it */
+        if (FP_CEILING && step < 0) {
+            for (i = 0; i < 4; i++) {
+                p[i][1] = (float)step;
+            }
+            Stg40_FpQuadN(c, (const float(*)[3])p, &w->prims[Stg40_FloorPrimIdx[prim & 0x7F]], FP_CEILING_SHADE, 0,
+                          FP_FLOOR_BIAS, sub, sub);
+        }
     }
     if (flags & 0xF00) {
         const u8 *base = &Stg40_WallPrimIdx[(u16)hdr->wallStyle * 5];
-- 
