@@ -1183,20 +1183,46 @@ void edit_log(void) {
     }
 }
 
+/* Tamer rank titles (Save_GameState.rank 0..10; the same in all three title sets in English) */
+const char *const k_rank_titles[11] = { "Cadet", "Beginner", "Amateur", "Rookie", "Normal", "Pro",
+                                        "Expert", "Elite", "Commander", "Chief", "Master" };
+
 void edit_tamer(const DevSnap &s) {
-    static Field bits, rank, progress;
+    static Field bits, progress;
+    char preview[32];
 
     if (int_set("bits", bits, s.bits, 9)) {
         push(edit_rec(DEVEDIT_BITS, bits.buf));
     }
     ImGui::SameLine();
-    if (int_set("rank", rank, s.rank, 4)) {
-        push(edit_rec(DEVEDIT_RANK, rank.buf));
-    }
-    ImGui::SameLine();
     if (int_set("progress", progress, s.progress, 4)) {
         push(edit_rec(DEVEDIT_PROGRESS, progress.buf));
     }
+    /* Forbs Hidden Mods testing: tamer rank by title, and the battle digivolution DP gauge */
+    if (s.rank <= 10) {
+        snprintf(preview, sizeof(preview), "%d %s", s.rank, k_rank_titles[s.rank]);
+    } else {
+        snprintf(preview, sizeof(preview), "%d (not a rank)", s.rank);
+    }
+    ImGui::SetNextItemWidth(ImGui::CalcTextSize("10 Commander").x + ImGui::GetFrameHeight() * 2);
+    if (ImGui::BeginCombo("tamer rank", preview)) {
+        for (int i = 0; i <= 10; i++) {
+            char item[32];
+
+            snprintf(item, sizeof(item), "%d %s", i, k_rank_titles[i]);
+            if (ImGui::Selectable(item, s.rank == i)) {
+                push(edit_rec(DEVEDIT_RANK, i));
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::SameLine();
+    ImGui::TextDisabled("(battle digivolution: Champion from 5, Ultimate from 8)");
+    if (ImGui::SmallButton("Fill DP")) {
+        push(edit_rec(DEVEDIT_EVOFILL));
+    }
+    ImGui::SameLine();
+    ImGui::TextDisabled("in battle: every party Digimon that can digivolve gets a full DP gauge");
 }
 
 void edit_digi(const DevSnap &s, int slot) {
