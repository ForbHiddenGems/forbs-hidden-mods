  * how far the party HUD is raised for it (0: off this battle) */
 void Stg30_EvoDrawBar(s32 slot, void *parts);
 s32 Stg30_EvoHudLift(void);
+/* host/devedit.c (F2, in battle): fill the DP gauge of every party Digimon that can digivolve;
