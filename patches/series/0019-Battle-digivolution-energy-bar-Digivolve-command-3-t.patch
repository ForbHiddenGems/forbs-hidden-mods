+/* commandinput.c: the Digimon in `slot` chose Digivolve (1) or the choice was taken back (0) */
+void Stg30_EvoRequest(s32 slot, s32 on);
+/* commandmenu.c: the command's text, glyphs, 0xFF ended */
+extern u8 Stg30_EvoCommandText[];
+/* fighterhud.c: the energy bar of party slot 0..2, under the HUD parts `parts` (drawn first) */
+void Stg30_EvoDrawBar(s32 slot, void *parts);
+
+#endif
+#endif
