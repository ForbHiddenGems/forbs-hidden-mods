diff --git a/src/stag3000/evo_native.inc b/src/stag3000/evo_native.inc
new file mode 100644
index 0000000..f84a607
--- /dev/null
+++ b/src/stag3000/evo_native.inc
@@ -0,0 +1,491 @@
+/* Battle digivolution (Forbs Hidden Mods, native only; include/stag3000/evo_native.h).
+ * Included by battle.c under DW2_NATIVE.
+ *
+ * Energy: 0..EVO_MAX per party slot, charged after every action from the HP lost since the last
+ * one: taking damage (EVO_TAKE for a whole max HP), dealing it (EVO_DEAL for a whole enemy max HP)
+ * and EVO_ACT for having had a turn. Full, a Rookie whose digivolution table names a Champion
+ * (Digi_GetEvolutionTarget at its DP) can choose Digivolve: that is its turn (it guards, turn type
+ * 5). After the commands, before the turns run, the Digi-Lab's effect (model 0xDD9, animation 0xDDB,
+ * as Stg20_LabDigivolve) plays on it and halfway through it becomes the Champion: battle copy
+ * digiId, the fighter's model and animations, HP / MP and attack / defense / speed up by EVO_BOOST
+ * percent. It fights 3 turns like that; at the start of the round after, the effect plays again and
+ * it returns, keeping the damage it took (its HP is never brought below 1 by the return). The end of
+ * the battle (won, lost, escaped) returns it at once, before the battle writes the party back. */
+
+#include <stdio.h>
+
+#include "stag3000/evo_native.h"
+
+extern u8 Digi_GetEvolutionTarget(s32 id, s32 val);
+extern void Mem_Free(ActorWork *arg0);
+extern s32 Cd_GetFileSync(s32 arg0);
+
+#define EVO_MAX 100
+#define EVO_TAKE 60  /* energy for losing a whole max HP */
+#define EVO_DEAL 45  /* energy for taking a whole max HP from enemies */
+#define EVO_ACT 4    /* energy for having had a turn */
+#define EVO_TURNS 3  /* turns it fights in the Champion form */
+#define EVO_BOOST 30 /* percent more HP, MP, attack, defense and speed in the Champion form */
+#define EVO_FX_MODEL 0xDD9
+#define EVO_FX_ANIM 0xDDB
+#define EVO_FX_FRAMES 0x78
+#define EVO_SWAP_AT 0x3C /* frame of the effect at which the form changes */
+
+typedef struct {
+    s32 energy;
+    s32 requested;  /* chose Digivolve this round */
+    s32 turnsLeft;  /* > 0: in the Champion form; rounds still to end */
+    s32 revert;     /* return at the start of the next round */
+    /* the Rookie it was */
+    s32 fromId;
+    s32 hpBonus;
+    s32 mpBonus;
+    s16 maxHp;
+    s16 maxMp;
+    s16 attack;
+    s16 defense;
+    s16 speed;
+} Stg30Evo;
+
+static Stg30Evo Stg30_Evo[3];
+static s16 Stg30_EvoHpSeen[6];
+static s32 Stg30_EvoFxSlot;
+static s32 Stg30_EvoSeqSlot = -1; /* party slot whose effect is playing, -1 none */
+static s32 Stg30_EvoSeqTimer;
+static s32 Stg30_EvoSeqBack;      /* the effect returns it (1) or digivolves it (0) */
+static s32 Stg30_EvoSeqSwapped;
+
+/* "Digivolve" */
+u8 Stg30_EvoCommandText[] = { 0x0D, 0x2C, 0x2A, 0x2C, 0x39, 0x32, 0x2F, 0x39, 0x28, 0xFF };
+
+typedef struct {
+    s32 modelFileId;
+    s32 animFileId;
+    s32 x;
+    s32 y;
+    s32 z;
+    s32 rotY;
+    s32 duration;
+} Stg30EvoFxArgs; /* Fx_ModelInit's 7 words (Stg20WarpFx) */
+
+static s32 Stg30_EvoTarget(s32 slot) {
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+    s32 t;
+
+    if (d->state < 3 || d->digiId == 0 || Digi_GetRank(d->digiId) != 0) {
+        return 0; /* only Rookies, for now */
+    }
+    t = Digi_GetEvolutionTarget(d->digiId, d->dp);
+    if (t == 0 || Digi_GetRank(t) != 1 || Digi_GetModelFile(t) <= 0) {
+        return 0;
+    }
+    return t;
+}
+
+s32 Stg30_EvoCanDigivolve(s32 slot) {
+    if (!Host_FpBattleEvo() || slot < 0 || slot >= 3) {
+        return 0;
+    }
+    return Stg30_Evo[slot].energy >= EVO_MAX && Stg30_Evo[slot].turnsLeft == 0 && !Stg30_Evo[slot].revert &&
+           Stg30_Battle.digis[slot].hp != 0 && Stg30_EvoTarget(slot) != 0;
+}
+
+void Stg30_EvoRequest(s32 slot, s32 on) {
+    if (slot >= 0 && slot < 3) {
+        Stg30_Evo[slot].requested = on && Stg30_EvoCanDigivolve(slot);
+    }
+}
+
+static void Stg30_EvoSeenNow(void) {
+    s32 i;
+
+    for (i = 0; i < 6; i++) {
+        Stg30_EvoHpSeen[i] = Stg30_Battle.digis[i].hp;
+    }
+}
+
+static void Stg30_EvoBattleInit(void) {
+    Mem_Zero(Stg30_Evo, sizeof(Stg30_Evo));
+    Stg30_EvoFxSlot = 0;
+    Stg30_EvoSeqSlot = -1;
+    Stg30_EvoSeenNow();
+}
+
+static void Stg30_EvoAdd(s32 slot, s32 v) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+
+    if (v <= 0 || e->turnsLeft != 0 || e->revert || Stg30_EvoTarget(slot) == 0) {
+        return;
+    }
+    e->energy += v;
+    if (e->energy > EVO_MAX) {
+        e->energy = EVO_MAX;
+    }
+}
+
+/* After an action (battle.c, before the turn order moves on): charge from the HP lost since. */
+static void Stg30_EvoCredit(s32 actor) {
+    s32 dealt = 0;
+    s32 lost;
+    s32 i;
+
+    if (!Host_FpBattleEvo()) {
+        Stg30_EvoSeenNow();
+        return;
+    }
+    for (i = 0; i < 6; i++) {
+        DigiRosterEntry *d = &Stg30_Battle.digis[i];
+
+        lost = Stg30_EvoHpSeen[i] - d->hp;
+        if (lost <= 0 || d->maxHp <= 0) {
+            continue;
+        }
+        if (i < 3) {
+            Stg30_EvoAdd(i, (lost * EVO_TAKE + d->maxHp - 1) / d->maxHp);
+        } else {
+            dealt += (lost * EVO_DEAL + d->maxHp - 1) / d->maxHp;
+        }
+    }
+    if (actor >= 0 && actor < 3 && Stg30_Battle.digis[actor].hp != 0) {
+        Stg30_EvoAdd(actor, dealt + EVO_ACT);
+    }
+    Stg30_EvoSeenNow();
+}
+
+static Actor *Stg30_EvoFighter(s32 slot) {
+    return (Actor *)Task_FindFirst(0x509, -1, slot);
+}
+
+/* The fighter's model and animations become those of digiId: its model is built again (the old
+ * one's bone and vertex buffers are sized for the old model). */
+static void Stg30_EvoSwapModel(s32 slot, s32 digiId) {
+    Actor *a = Stg30_EvoFighter(slot);
+    Stg30FighterWork *w;
+    ActorModel *m;
+    Stg30ModelTint *t;
+
+    if (a == NULL) {
+        return;
+    }
+    w = (Stg30FighterWork *)a->work;
+    m = a->model;
+    if (m != NULL) {
+        if (m->screenXY != NULL) {
+            Mem_Free((ActorWork *)m->screenXY);
+        }
+        if (m->vertOtz != NULL) {
+            Mem_Free((ActorWork *)m->vertOtz);
+        }
+        if (m->vertColors != NULL) {
+            Mem_Free((ActorWork *)m->vertColors);
+        }
+        if (m->bones != NULL) {
+            Mem_Free((ActorWork *)m->bones);
+        }
+        Mem_Free((ActorWork *)m);
+        a->model = NULL;
+    }
+    a->digiId = digiId;
+    w->modelFile = Digi_GetModelFile(digiId);
+    Cd_GetFileSync(w->modelFile);
+    Cd_GetFileSync(Digi_GetAnimFile(digiId, 0));
+    t = (Stg30ModelTint *)Gfx_AttachModel(a, w->modelFile);
+    t->otIndex = 3;
+    t->flatR = t->flatG = t->flatB = 0x80;
+    t->clutRow = 0;
+    t->tpageBits = 0;
+    w->drawTex = 1;
+    w->drawWire = 0;
+    w->color.r = w->color.g = w->color.b = 0;
+    w->anim = -1;
+    if (Stg30_Battle.digis[slot].hp == 0) {
+        Stg30_FighterSetAnim(a, 0x64); /* stays down */
+    } else {
+        Stg30_FighterSetAnim(a, 0);
+    }
+}
+
+static s16 Stg30_EvoUp(s32 v) {
+    v += v * EVO_BOOST / 100;
+    return (s16)(v > 999 ? 999 : v);
+}
+
+static s16 Stg30_EvoDown(s32 v) {
+    v = v * 100 / (100 + EVO_BOOST);
+    return (s16)(v < 1 ? 1 : v);
+}
+
+static void Stg30_EvoBecome(s32 slot) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+    s32 t = Stg30_EvoTarget(slot);
+    s16 v;
+
+    if (t == 0) {
+        return;
+    }
+    e->fromId = d->digiId;
+    e->maxHp = d->maxHp;
+    e->maxMp = d->maxMp;
+    e->attack = Stg30_Battle.attackBase[slot];
+    e->defense = Stg30_Battle.defenseBase[slot];
+    e->speed = Stg30_Battle.speedBase[slot];
+    d->digiId = t;
+    v = Stg30_EvoUp(d->maxHp);
+    e->hpBonus = v - d->maxHp;
+    d->maxHp = v;
+    d->hp = d->hp + e->hpBonus > d->maxHp ? d->maxHp : d->hp + e->hpBonus;
+    v = Stg30_EvoUp(d->maxMp);
+    e->mpBonus = v - d->maxMp;
+    d->maxMp = v;
+    d->mp = d->mp + e->mpBonus > d->maxMp ? d->maxMp : d->mp + e->mpBonus;
+    Stg30_Battle.attackBase[slot] = Stg30_EvoUp(Stg30_Battle.attackBase[slot]);
+    Stg30_Battle.defenseBase[slot] = Stg30_EvoUp(Stg30_Battle.defenseBase[slot]);
+    Stg30_Battle.speedBase[slot] = Stg30_EvoUp(Stg30_Battle.speedBase[slot]);
+    Stg30_Battle.attackCur[slot] = Stg30_EvoUp(Stg30_Battle.attackCur[slot]);
+    Stg30_Battle.defenseCur[slot] = Stg30_EvoUp(Stg30_Battle.defenseCur[slot]);
+    Stg30_Battle.speedCur[slot] = Stg30_EvoUp(Stg30_Battle.speedCur[slot]);
+    d->attack = Stg30_Battle.attackCur[slot];
+    d->defense = Stg30_Battle.defenseCur[slot];
+    d->speed = Stg30_Battle.speedCur[slot];
+    e->energy = 0;
+    e->requested = 0;
+    e->turnsLeft = EVO_TURNS + 1; /* the round it digivolves in (it guards) ends first */
+    e->revert = 0;
+    Stg30_EvoHpSeen[slot] = d->hp;
+    printf("[evo] slot %d digivolves: %d -> %d\n", slot, e->fromId, t);
+}
+
+/* Back to the Rookie: data only (the end of the battle calls this for every slot). */
+static void Stg30_EvoReturnData(s32 slot) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+
+    if (e->turnsLeft == 0 && !e->revert) {
+        return;
+    }
+    d->digiId = (u8)e->fromId;
+    d->maxHp = e->maxHp;
+    if (d->hp != 0) {
+        d->hp -= e->hpBonus;
+        if (d->hp < 1) {
+            d->hp = 1;
+        }
+        if (d->hp > d->maxHp) {
+            d->hp = d->maxHp;
+        }
+    }
+    d->maxMp = e->maxMp;
+    d->mp -= e->mpBonus;
+    if (d->mp < 0) {
+        d->mp = 0;
+    }
+    if (d->mp > d->maxMp) {
+        d->mp = d->maxMp;
+    }
+    Stg30_Battle.attackBase[slot] = e->attack;
+    Stg30_Battle.defenseBase[slot] = e->defense;
+    Stg30_Battle.speedBase[slot] = e->speed;
+    Stg30_Battle.attackCur[slot] = Stg30_EvoDown(Stg30_Battle.attackCur[slot]);
+    Stg30_Battle.defenseCur[slot] = Stg30_EvoDown(Stg30_Battle.defenseCur[slot]);
+    Stg30_Battle.speedCur[slot] = Stg30_EvoDown(Stg30_Battle.speedCur[slot]);
+    d->attack = Stg30_Battle.attackCur[slot];
+    d->defense = Stg30_Battle.defenseCur[slot];
+    d->speed = Stg30_Battle.speedCur[slot];
+    e->turnsLeft = 0;
+    e->revert = 0;
+    e->energy = 0;
+    Stg30_EvoHpSeen[slot] = d->hp;
+    printf("[evo] slot %d returns to %d\n", slot, e->fromId);
+}
+
+/* The end of the battle: every Champion form back at once (model too: the victory poses use the
+ * Rookie's animations), before the party is written back. */
+static void Stg30_EvoReturnAll(void) {
+    s32 i;
+
+    if (Stg30_EvoFxSlot != 0) {
+        Task_Destroy(&Stg30_EvoFxSlot);
+    }
+    Stg30_EvoSeqSlot = -1;
+    for (i = 0; i < 3; i++) {
+        if (Stg30_Evo[i].turnsLeft != 0 || Stg30_Evo[i].revert) {
+            Stg30_EvoReturnData(i);
+            Stg30_EvoSwapModel(i, Stg30_Battle.digis[i].digiId);
+        }
+        Stg30_Evo[i].requested = 0;
+    }
+}
+
+/* The end of a round (battle.c): count the Champion forms' turns. */
+static void Stg30_EvoRoundEnd(void) {
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        Stg30Evo *e = &Stg30_Evo[i];
+
+        e->requested = 0;
+        if (e->turnsLeft != 0) {
+            if (--e->turnsLeft == 0 || Stg30_Battle.digis[i].hp == 0) {
+                e->turnsLeft = 1; /* still the Champion until the effect returns it */
+                e->revert = 1;
+            }
+        }
+    }
+}
+
+/* Runs the effect for one slot; 1 while it plays. */
+static s32 Stg30_EvoSequence(void) {
+    s32 slot = Stg30_EvoSeqSlot;
+    Actor *f = Stg30_EvoFighter(slot);
+    Stg30FighterWork *w;
+    Stg30EvoFxArgs args;
+    Actor *fx;
+
+    if (f == NULL) {
+        Stg30_EvoSeqSlot = -1;
+        return 0;
+    }
+    w = (Stg30FighterWork *)f->work;
+    if (Stg30_EvoSeqTimer == 0) {
+        Stg30_SetCameraShot(slot + 2);
+        Cd_GetFileSync(EVO_FX_MODEL);
+        Cd_GetFileSync(EVO_FX_ANIM);
+        args.modelFileId = EVO_FX_MODEL;
+        args.animFileId = EVO_FX_ANIM;
+        args.x = w->homeX;
+        args.y = w->homeY;
+        args.z = w->homeZ;
+        args.rotY = w->facing;
+        args.duration = EVO_FX_FRAMES;
+        Task_Create(7, &Stg30_EvoFxSlot, (s32)(sptr)&args);
+        Stg30_EvoSeqSwapped = 0;
+        Snd_PlayById(0xA, 0);
+    }
+    Stg30_EvoSeqTimer++;
+    if (!Stg30_EvoSeqSwapped && Stg30_EvoSeqTimer >= EVO_SWAP_AT) {
+        Stg30_EvoSeqSwapped = 1;
+        if (Stg30_EvoSeqBack) {
+            Stg30_EvoReturnData(slot);
+        } else {
+            Stg30_EvoBecome(slot);
+        }
+        Stg30_EvoSwapModel(slot, Stg30_Battle.digis[slot].digiId);
+    }
+    fx = (Actor *)P32(Actor, Stg30_EvoFxSlot);
+    if (Stg30_EvoSeqTimer < EVO_FX_FRAMES + 20 && (fx == NULL || fx->stateLevel0 != 3 ||
+                                                   Stg30_EvoSeqTimer < EVO_SWAP_AT + 20)) {
+        return 1;
+    }
+    if (Stg30_EvoFxSlot != 0) {
+        Task_Destroy(&Stg30_EvoFxSlot);
+    }
+    Stg30_SetCameraShot(1);
+    Stg30_EvoSeqSlot = -1;
+    return 0;
+}
+
+/* battle.c: phase 0 at the start of a round (returns), phase 1 after the commands (digivolves).
+ * 1 while an effect plays (the battle waits). */
+static s32 Stg30_EvoStep(s32 phase) {
+    s32 i;
+
+    if (Stg30_EvoSeqSlot >= 0 && Stg30_EvoSequence()) {
+        return 1;
+    }
+    for (i = 0; i < 3; i++) { /* the next one, if two or three digivolve at once */
+        Stg30Evo *e = &Stg30_Evo[i];
+
+        if (phase == 0 && e->revert) {
+            Stg30_EvoSeqBack = 1;
+        } else if (phase == 1 && e->requested && Stg30_Battle.turns[i].turnType == 5 &&
+                   Stg30_EvoCanDigivolve(i)) {
+            Stg30_EvoSeqBack = 0;
+        } else {
+            if (phase == 1) {
+                e->requested = 0;
+            }
+            continue;
+        }
+        e->requested = 0;
+        Stg30_EvoSeqSlot = i;
+        Stg30_EvoSeqTimer = 0;
+        return Stg30_EvoSequence();
+    }
+    return 0;
+}
+
+/* ---- the energy bar (fighterhud.c) ---- */
+
+typedef struct {
+    GfxPartOTag tag;
+    u8 r, g, b, code;
+    s16 x, y;
+    u16 w, h;
+} Stg30EvoTile;
+
+static void Stg30_EvoTile(GfxPartOTag *ot, s32 x, s32 y, s32 w, s32 h, s32 r, s32 g, s32 b) {
+    Stg30EvoTile *p = (Stg30EvoTile *)Sys_State.packet.addr;
+    s32 sx = Sys_State.centerX.s == 0x140; /* as Gfx_DrawPartsEx: 640 wide, 480 high */
+    s32 sy = Sys_State.centerY.s == 0xF0;
+
+    if (w <= 0) {
+        return;
+    }
+    x -= 160; /* 320 x 240 screen to centred coordinates */
+    y -= 120;
+    p->tag.len = 3;
+    p->code = 0x60; /* TILE */
+    p->r = r;
+    p->g = g;
+    p->b = b;
+    p->x = x << sx;
+    p->y = y << sy;
+    p->w = w << sx;
+    p->h = h << sy;
+    p->tag.addr = ot->addr;
+    ot->addr = (u32)(uptr)p;
+    Sys_State.packet.addr = (sptr)(p + 1);
+}
+
+/* The bar's place: above the slot's HUD box, under its name (Stg30_FighterHudNamePos). */
+#define EVO_BAR_X0 17
+#define EVO_BAR_STEP 99
+#define EVO_BAR_Y 197
+#define EVO_BAR_W 84
+#define EVO_BAR_H 3
+
+void Stg30_EvoDrawBar(s32 slot, void *parts) {
+    Stg30Evo *e;
+    GfxPartOTag *ot;
+    s32 x;
+    s32 fill;
+    s32 blink;
+
+    if (!Host_FpBattleEvo() || slot < 0 || slot >= 3 || parts == NULL) {
+        return;
+    }
+    e = &Stg30_Evo[slot];
+    if (e->turnsLeft == 0 && !e->revert && Stg30_EvoTarget(slot) == 0) {
+        return; /* no Champion form to reach */
+    }
+    ot = (GfxPartOTag *)Sys_State.otLayers.addr[((u8 *)parts)[0x0B]]; /* the first part's otLayer (Rec1D6B4) */
+    x = EVO_BAR_X0 + slot * EVO_BAR_STEP;
+    /* drawn last = on top: the fill first, then its frame */
+    if (e->turnsLeft != 0 || e->revert) {
+        /* in the Champion form: the turns it has left, light blue */
+        s32 n = e->revert ? 0 : e->turnsLeft > EVO_TURNS ? EVO_TURNS : e->turnsLeft;
+
+        fill = EVO_BAR_W * n / EVO_TURNS;
+        Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0x40, 0xC0, 0xFF);
+    } else {
+        fill = EVO_BAR_W * e->energy / EVO_MAX;
+        if (e->energy >= EVO_MAX && Stg30_Battle.digis[slot].hp != 0) {
+            blink = (Sys_State.frameCount >> 3) & 1; /* full: flashes gold and white */
+            Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0xFF, blink ? 0xFF : 0xD0, blink ? 0xFF : 0x20);
+        } else {
+            Stg30_EvoTile(ot, x, EVO_BAR_Y, fill, EVO_BAR_H, 0xFF, 0x80, 0x10);
+        }
+    }
+    Stg30_EvoTile(ot, x - 1, EVO_BAR_Y - 1, EVO_BAR_W + 2, EVO_BAR_H + 2, 0x10, 0x10, 0x20);
+}
