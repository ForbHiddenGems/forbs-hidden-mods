+/* FP: random numbers of the mod's own (xorshift, seeded from the clock), so the mod never
+ * draws from the game's generator: battles, drops and encounters stay the game's. */
+unsigned int Host_FpRandom(void) {
+    if (fp_rng == 0) {
+        fp_rng = (unsigned int)SDL_GetTicksNS() | 1u;
+    }
+    fp_rng ^= fp_rng << 13;
+    fp_rng ^= fp_rng >> 17;
+    fp_rng ^= fp_rng << 5;
