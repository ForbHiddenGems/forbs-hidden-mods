From 424f0fb780145ee42ee71bc573ff5e91357c61a6 Mon Sep 17 00:00:00 2001
From: FP mod <fpmod@localhost>
Date: Thu, 29 Oct 2026 12:13:46 +0000
Subject: [PATCH 21/26] Battle digivolution: the Digimon spins in the effect,
 Champion gets its technique

As on the Digi-Lab's platform, the fighter turns during the effect: faster and
faster up to the change, then slowing to face the front again. The Champion
form also gets its own technique (Digi_GetLearnedSkill, the one the Digi-Lab
gives) in its battle skill list for its turns; it goes with the form.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01B1oHeiADE8njqFxkaQnJAX
---
 src/stag3000/evo_native.inc | 59 +++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/src/stag3000/evo_native.inc b/src/stag3000/evo_native.inc
index c5de7ef..a50b7af 100644
--- a/src/stag3000/evo_native.inc
+++ b/src/stag3000/evo_native.inc
@@ -19,6 +19,13 @@
 extern u8 Digi_GetEvolutionTarget(s32 id, s32 val);
 extern void Mem_Free(ActorWork *arg0);
 extern s32 Cd_GetFileSync(s32 arg0);
+extern u8 Digi_GetLearnedSkill(s32 digiId);
+
+/* Actor.u38 transform with its Y rotation (Stg20Rot): the fighter spins in the effect. */
+typedef struct {
+    u8 _pad00[0x42];
+    /* 0x42 */ s16 rotY;
+} Stg30EvoXform;
 
 #define EVO_MAX 100
 #define EVO_TAKE 60  /* energy for losing a whole max HP */
@@ -38,6 +45,8 @@ typedef struct {
     s32 revert;     /* return at the start of the next round */
     /* the Rookie it was */
     s32 fromId;
+    s32 skillSlot; /* its battle copy's skill list slot holding the Champion's technique, -1 none */
+    s32 skillOld;  /* what that slot held */
     s32 hpBonus;
     s32 mpBonus;
     s16 maxHp;
@@ -57,6 +66,7 @@ static s32 Stg30_EvoSeqSlot = -1; /* party slot whose effect is playing, -1 none
 static s32 Stg30_EvoSeqTimer;
 static s32 Stg30_EvoSeqBack;      /* the effect returns it (1) or digivolves it (0) */
 static s32 Stg30_EvoSeqSwapped;
+static s32 Stg30_EvoSeqSpinning;
 
 /* "Digivolve" */
 u8 Stg30_EvoCommandText[] = { 0x0D, 0x2C, 0x2A, 0x2C, 0x39, 0x32, 0x2F, 0x39, 0x28, 0xFF };
@@ -255,6 +265,25 @@ static void Stg30_EvoBecome(s32 slot) {
     e->energy = 0;
     e->requested = 0;
     e->turnsLeft = EVO_TURNS + 1; /* the round it digivolves in (it guards) ends first */
+    /* the Champion's own technique (Digi_GetLearnedSkill, as the Digi-Lab gives it), for these
+     * turns only: in a free slot of its list, else in the last one */
+    e->skillSlot = -1;
+    {
+        s32 k = Digi_GetLearnedSkill(t);
+        s32 i;
+        s32 known = 0;
+
+        for (i = 0; i < 12; i++) {
+            known |= d->skills[i] == k;
+        }
+        if (k != 0 && !known) {
+            for (i = 0; i < 12 && d->skills[i] != 0; i++) {
+            }
+            e->skillSlot = i < 12 ? i : 11;
+            e->skillOld = d->skills[e->skillSlot];
+            d->skills[e->skillSlot] = (u8)k;
+        }
+    }
     e->revert = 0;
     Stg30_EvoHpSeen[slot] = d->hp;
     printf("[evo] slot %d digivolves: %d -> %d\n", slot, e->fromId, t);
@@ -279,6 +308,10 @@ static void Stg30_EvoReturnData(s32 slot) {
             d->hp = d->maxHp;
         }
     }
+    if (e->skillSlot >= 0) {
+        d->skills[e->skillSlot] = (u8)e->skillOld; /* the Champion's technique goes with it */
+        e->skillSlot = -1;
+    }
     d->maxMp = e->maxMp;
     d->mp -= e->mpBonus;
     if (d->mp < 0) {
@@ -369,6 +402,22 @@ static s32 Stg30_EvoSequence(void) {
         Snd_PlayById(0xA, 0);
     }
     Stg30_EvoSeqTimer++;
+    {
+        /* it spins, faster and faster up to the change, then slows to face the front again */
+        Stg30EvoXform *o = (Stg30EvoXform *)f->u38.ptr38;
+        s32 t = Stg30_EvoSeqTimer;
+        s32 v = t < EVO_SWAP_AT ? 0x18 + t * 6 : EVO_FX_FRAMES - t > 0 ? 0x18 + (EVO_FX_FRAMES - t) * 6 : 0x30;
+
+        if (o != NULL) {
+            if (t < EVO_FX_FRAMES || ((o->rotY - w->facing) & 0xFFF) > v) {
+                o->rotY = (s16)((o->rotY + v) & 0xFFF);
+                Stg30_EvoSeqSpinning = 1;
+            } else {
+                o->rotY = (s16)w->facing;
+                Stg30_EvoSeqSpinning = 0;
+            }
+        }
+    }
     if (!Stg30_EvoSeqSwapped && Stg30_EvoSeqTimer >= EVO_SWAP_AT) {
         Stg30_EvoSeqSwapped = 1;
         if (Stg30_EvoSeqBack) {
@@ -379,10 +428,20 @@ static s32 Stg30_EvoSequence(void) {
         Stg30_EvoSwapModel(slot, Stg30_Battle.digis[slot].digiId);
     }
     fx = Stg30_EvoFxSlot != NULL ? (Actor *)P32(Actor, *Stg30_EvoFxSlot) : NULL;
+    if (Stg30_EvoSeqSpinning && Stg30_EvoSeqTimer < EVO_FX_FRAMES + 90) {
+        return 1; /* still turning back to the front */
+    }
     if (Stg30_EvoSeqTimer < EVO_FX_FRAMES + 20 && (fx == NULL || fx->stateLevel0 != 3 ||
                                                    Stg30_EvoSeqTimer < EVO_SWAP_AT + 20)) {
         return 1;
     }
+    {
+        Stg30EvoXform *o = (Stg30EvoXform *)f->u38.ptr38;
+
+        if (o != NULL) {
+            o->rotY = (s16)w->facing;
+        }
+    }
     if (Stg30_EvoFxSlot != NULL && *Stg30_EvoFxSlot != 0) {
         Task_Destroy(Stg30_EvoFxSlot);
     }
-- 
2.43.0

