+        Settings_Set(SET_FPCEIL, Host_FpCeiling());
+        fflush(stdout);
+    }
     if (r & REQ_FPVIEW) {
         Host_SetFpView(!Host_FpView());
         printf("[host] first-person view %s (F4)\n", Host_FpView() ? "on" : "off");
