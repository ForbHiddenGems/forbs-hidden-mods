+/* ---- minimap arrow ----------------------------------------------------------------------- */
+
+/* POLY_F3 (flat triangle), 0x14 bytes, 4 words after the tag. */
+typedef struct {
+    Stg40Tag tag;
+    u8 r0, g0, b0, code;
+    s16 x0, y0;
+    s16 x1, y1;
+    s16 x2, y2;
+} Stg40FpF3;
+
+static void Stg40_FpMapTri(s32 *ot, const float *pts, u8 r, u8 g, u8 b) {
+    Stg40FpF3 *t = (Stg40FpF3 *)(sptr)Sys_State.packet.addr;
+
+    t->tag.word = 0;
+    t->tag.b.len = 4;
+    t->code = 0x20;
+    t->r0 = r;
+    t->g0 = g;
+    t->b0 = b;
+    t->x0 = (s16)lrintf(pts[0]);
+    t->y0 = (s16)lrintf(pts[1]);
+    t->x1 = (s16)lrintf(pts[2]);
+    t->y1 = (s16)lrintf(pts[3]);
+    t->x2 = (s16)lrintf(pts[4]);
+    t->y2 = (s16)lrintf(pts[5]);
+    t->tag.word = (t->tag.word & 0xFF000000) | (*ot & 0xFFFFFF);
+    *ot = (*ot & 0xFF000000) | ((s32)(sptr)t & 0xFFFFFF);
+    Sys_State.packet.addr = (s32)(sptr)(t + 1);
+}
+
+/* The beetle's facing on the automap window Stg40_AutomapDrawWindow draws at x, y around cell
+ * (cx, cy) with `scale` pixels per cell: an arrow over the beetle's dot. Called before that
+ * window links its quads into the same OT entry, so it draws over them (an entry draws its
+ * packets newest first). A cell's texel is col + 4 (pix rows start one halfword in) and the
+ * window shows texel left + 3 at x + (left - cx) * scale, so cell col sits at
+ * x + (col + 1 - cx) * scale, row at y + (row + 1 - cy) * scale. */
+void Stg40_FpDrawMapArrow(s32 x, s32 y, s32 cx, s32 cy, s32 scale, s32 fade) {
+    Stg40Loc *loc = Dung_StatePtr->playerLoc;
+    s32 *ot = Sys_State.otLayers.s[1];
+    float sx;
+    float sy;
+    float a;
+    float dx;
+    float dy;
+    float px;
+    float py;
+    float pts[6];
+    float k;
+    s32 pass;
+
+    if (!Stg40_FpActive() || loc == NULL || fade <= 0) {
+        return;
+    }
+    Stg40_FpSync(Stg40_RootState->playerEnt);
+    sx = x + (loc->posX / 64.0f + 1.5f - cx) * scale;
+    sy = y + (loc->posY / 64.0f + 1.5f - cy) * scale;
+    a = Stg40_FpYaw * (float)(2.0 * 3.14159265358979323846 / 4096.0);
+    dx = -sinf(a); /* map direction of the view (x right, y down, as on screen) */
+    dy = cosf(a);
+    px = -dy;      /* perpendicular */
+    py = dx;
+    /* the arrow first, then its dark outline: the outline (linked later) draws first */
+    for (pass = 0; pass < 2; pass++) {
+        k = pass == 0 ? 1.0f : 1.45f;
+        pts[0] = sx + dx * 1.7f * scale * k;
+        pts[1] = sy + dy * 1.7f * scale * k;
+        pts[2] = sx - dx * 1.0f * scale * k + px * 1.1f * scale * k;
+        pts[3] = sy - dy * 1.0f * scale * k + py * 1.1f * scale * k;
+        pts[4] = sx - dx * 1.0f * scale * k - px * 1.1f * scale * k;
+        pts[5] = sy - dy * 1.0f * scale * k - py * 1.1f * scale * k;
+        if (pass == 0) {
+            Stg40_FpMapTri(ot, pts, (u8)(0xFF * fade / 0xFF), (u8)(0xDC * fade / 0xFF), (u8)(0x28 * fade / 0xFF));
+        } else {
+            Stg40_FpMapTri(ot, pts, (u8)(0x20 * fade / 0xFF), (u8)(0x18 * fade / 0xFF), 0);
+        }
+    }
+}
