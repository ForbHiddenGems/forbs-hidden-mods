+#ifndef STAG4000_FPVIEW_H
+#define STAG4000_FPVIEW_H
+
+/* FP: first-person view in the domains (native build only, F4 / settings "fpview").
+ *
+ * The camera sits in the Digi-Beetle and looks along its facing; the floor and its walls are
+ * drawn by Stg40_FpDrawFloor (floor.c) instead of the retail 9x9 window: cells all around the
+ * beetle out to STG40_FP_RADIUS, clipped against the near plane and the screen guard band in
+ * world space before the GTE projects them, so nothing behind the camera reaches the GTE, and
+ * faded to black with distance. Tiles are made square in this view (z * 40 like x, retail
+ * z * 32): entity positions go through Stg40_FpWorldX / Stg40_FpWorldZ for that.
+ *
+ * Presentation only: game state, turns, RNG and the retail window logic run as before. The
+ * pad mapping in Stg40_PlayerTryMove becomes relative to the facing (Up forward, Left / Right
+ * turn 90 degrees, Down turns around, Up + Left / Right steps diagonally). */
+
+#ifdef DW2_NATIVE
+
+#define STG40_FP_RADIUS 8 /* tiles drawn around the beetle */
+
+/* The view is on (setting) and the dungeon has a player to look from. */
+s32 Stg40_FpActive(void);
+/* World x / z (s16 range) of a map position for models: player-centred and square in FP,
+ * the retail view-centred values otherwise. */
+s32 Stg40_FpWorldX(s32 posX);
+s32 Stg40_FpWorldZ(s32 posY);
+/* A map position too far from the player for s16 world coordinates in FP. */
+s32 Stg40_FpOutOfRange(s32 posX, s32 posY);
+/* The entity / actor is the player, hidden in FP (the camera is inside it). */
+s32 Stg40_FpHidesEnt(void *ent);
+s32 Stg40_FpHidesActor(void *actor);
+/* The pad as an absolute octant 0..7 for Stg40_PlayerTryMove, or -1 = no step this frame
+ * (turns in place are applied to the entity here). */
+s32 Stg40_FpPadOctant(void *ent);
+/* camera.c: GsWSMATRIX / projection for this frame from inside the beetle. */
+void Stg40_FpSetCamera(void *cameraWork);
+/* floor.c */
+void Stg40_FpDrawFloor(void *floorWork);
+void Stg40_FpDrawShadow(void *loc);
+void Stg40_FpReset(void);
+
+#endif
+
+#endif /* STAG4000_FPVIEW_H */
