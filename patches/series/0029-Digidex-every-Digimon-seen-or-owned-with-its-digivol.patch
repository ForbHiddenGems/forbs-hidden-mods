diff --git a/src/main/digidex.c b/src/main/digidex.c
new file mode 100644
index 0000000..ae81c33
--- /dev/null
+++ b/src/main/digidex.c
@@ -0,0 +1,694 @@
+/* Digidex (Forbs Hidden Mods, native only; include/main/digidex.h).
+ *
+ * Opened from the top menu's Digidex entry (task 0x17, topmenu.c). A list of every Digimon in the
+ * base data table (0xC6C, id order) on the left; on the right the selected one's model, turning,
+ * and what it is: name, level and type, its technique, what it digivolves from and, by DP, into.
+ * Unmet Digimon are a black silhouette named "?????"; seen ones (fought) show name and model;
+ * owned ones (had it, or digivolved into it in battle) show their technique too. Up / down move,
+ * left / right a page, Triangle or Circle closes. Windows are the top menu's box sprite (0x457
+ * cells 1 and 2) drawn in slices to any size. */
+#ifdef DW2_NATIVE
+
+#include "common.h"
+#include "main/game.h"
+#include "main/task.h"
+#include "main/digibase.h"
+#include "main/skill.h"
+#include "main/digidex.h"
+#include "main/topmenu.h"
+
+extern GfxTexSlot *Gfx_FindOrLoadTexSlot(s32 id);
+extern s32 GsSetRefView2(GsRVIEW2 *);
+
+/* ---------------------------------------------------------------- what the tamer has met */
+
+static u8 *Dex_SeenBits(void) {
+    return Save_GameState._padFD4; /* 32 bytes: ids 0..255 */
+}
+
+static u8 *Dex_OwnedByte(s32 digiId) {
+    return digiId < 128 ? &Save_GameState._padFD4[32 + (digiId >> 3)] : &Save_GameState._pad1048[(digiId - 128) >> 3];
+}
+
+s32 Dex_Level(s32 digiId) {
+    if (digiId <= 0 || digiId > 255) {
+        return 0;
+    }
+    if (*Dex_OwnedByte(digiId) & (1 << (digiId & 7))) {
+        return 2;
+    }
+    return (Dex_SeenBits()[digiId >> 3] >> (digiId & 7)) & 1;
+}
+
+void Dex_MarkSeen(s32 digiId) {
+    if (digiId > 0 && digiId <= 255) {
+        Dex_SeenBits()[digiId >> 3] |= 1 << (digiId & 7);
+    }
+}
+
+void Dex_MarkOwned(s32 digiId) {
+    if (digiId > 0 && digiId <= 255) {
+        Dex_MarkSeen(digiId);
+        *Dex_OwnedByte(digiId) |= 1 << (digiId & 7);
+    }
+}
+
+void Dex_ScanRoster(void) {
+    s32 i;
+
+    for (i = 0; i < 0x24; i++) {
+        if (Save_GameState.elems[i].state != 0) {
+            Dex_MarkOwned(Save_GameState.elems[i].digiId);
+        }
+    }
+}
+
+/* what the screen shows: the F2 "show all" box shows every Digimon as owned */
+static s32 Dex_Shown(s32 digiId) {
+    return Host_DexShowAll() ? 2 : Dex_Level(digiId);
+}
+
+/* ---------------------------------------------------------------- boxes from the menu sprite */
+
+/* The top menu's box (0x457 cell 1) and its shadow (cell 2, 2 px right and down): 128 x 47, five
+ * columns of cells (16 | 32 | 32 | 32 | 16; the middle three are the same texture). Drawn any size:
+ * the left and right columns as they are, the middle one repeated; rows 0..14 at the top, rows
+ * 15..22 (one band of the interior's lines) repeated, rows 31..46 at the bottom. */
+#define DEX_BOX_W 128
+#define DEX_BOX_H 47
+#define DEX_TOP 15
+#define DEX_BAND 8
+#define DEX_BOTTOM 16
+
+static void Dex_Quad(GfxPartOTag *ot, GfxPartCell *e, GfxPartTexSlot *t, s32 x, s32 y, s32 w, s32 h, s32 u, s32 v,
+                     s32 uw, s32 vh) {
+    GfxPartPolyFT4 *p = (GfxPartPolyFT4 *)Sys_State.packet.addr;
+    s32 sx = Sys_State.centerX.s == 0x140;
+    s32 sy = Sys_State.centerY.s == 0xF0;
+    s32 i;
+
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    p->c.r = p->c.g = p->c.b = 0x80;
+    p->tag.len = 9;
+    if (e->blend & 0x80) {
+        p->c.code = 0x2E;
+        p->v[1].extra = t->tpage | ((e->blend & 3) << 5);
+    } else {
+        p->c.code = 0x2C;
+        p->v[1].extra = t->tpage;
+    }
+    for (i = 0; i < 4; i++) {
+        p->v[i].x = (u16)((x + ((i & 1) ? w : 0)) << sx);
+        p->v[i].y = (u16)((y + ((i & 2) ? h : 0)) << sy);
+        p->v[i].u = (u8)(u + ((i & 1) ? uw : 0));
+        p->v[i].v = (u8)(v + ((i & 2) ? vh : 0));
+    }
+    if (p->v[1].u == 0) {
+        p->v[1].u = p->v[3].u = 0xFF;
+    }
+    p->v[0].extra = ((e->clutY + t->clutY + e->clutRow) << 6) | (((e->clutX + t->clutX) >> 4) & 0x3F);
+    p->tag.addr = ot->addr;
+    ot->addr = (u32)(uptr)p;
+    Sys_State.packet.addr = (sptr)(p + 1);
+}
+
+/* One column of the box sprite (cell e: its u, its width) at screen x, rows sliced to height h. */
+static void Dex_BoxColumn(GfxPartOTag *ot, GfxPartCell *e, GfxPartTexSlot *t, s32 x, s32 y, s32 w, s32 h) {
+    s32 u = e->u + t->u;
+    s32 r;
+    s32 n;
+
+    Dex_Quad(ot, e, t, x, y, w, DEX_TOP, u, e->v, w, DEX_TOP);
+    for (r = DEX_TOP; r < h - DEX_BOTTOM; r += n) {
+        n = h - DEX_BOTTOM - r < DEX_BAND ? h - DEX_BOTTOM - r : DEX_BAND;
+        Dex_Quad(ot, e, t, x, y + r, w, n, u, e->v + DEX_TOP, w, n);
+    }
+    Dex_Quad(ot, e, t, x, y + h - DEX_BOTTOM, w, DEX_BOTTOM, u, e->v + DEX_BOX_H - DEX_BOTTOM, w, DEX_BOTTOM);
+}
+
+static void Dex_BoxCell(GfxPartOTag *ot, s32 fileId, s32 x, s32 y, s32 w, s32 h) {
+    GfxPartCell *e = (GfxPartCell *)Cd_GetFileEntry(fileId);
+    GfxPartTexSlot *t = (GfxPartTexSlot *)Gfx_FindOrLoadTexSlot(fileId & 0xFFFF0000);
+    GfxPartCell *left = NULL;
+    GfxPartCell *mid = NULL;
+    GfxPartCell *right = NULL;
+    s32 c;
+    s32 n;
+
+    for (; e->u != 0xFF; e++) {
+        if (e->frame != 0) {
+            continue;
+        }
+        if ((s16)e->x == -DEX_BOX_W / 2) {
+            left = e;
+        } else if ((s16)e->x + e->w == DEX_BOX_W / 2) {
+            right = e;
+        } else if (mid == NULL) {
+            mid = e;
+        }
+    }
+    if (left == NULL || mid == NULL || right == NULL) {
+        return;
+    }
+    Dex_BoxColumn(ot, left, t, x, y, left->w, h);
+    for (c = left->w; c < w - right->w; c += n) {
+        n = w - right->w - c < mid->w ? w - right->w - c : mid->w;
+        Dex_BoxColumn(ot, mid, t, x + c, y, n, h);
+    }
+    Dex_BoxColumn(ot, right, t, x + w - right->w, y, right->w, h);
+}
+
+/* A menu box at screen x, y (0..319, 0..239), w x h, in ordering table layer `layer` (0 is the
+ * menus' own; the Digidex puts its windows lower, under its model). */
+void Dex_DrawBoxLayer(s32 x, s32 y, s32 w, s32 h, s32 layer) {
+    GfxPartOTag *ot = (GfxPartOTag *)Sys_State.otLayers.addr[layer];
+
+    x -= 160;
+    y -= 120;
+    Dex_BoxCell(ot, 0x04570001, x, y, w, h);     /* the box (inserted first: drawn after its shadow) */
+    Dex_BoxCell(ot, 0x04570002, x + 2, y + 2, w, h); /* its shadow */
+}
+
+void Dex_DrawBox(s32 x, s32 y, s32 w, s32 h) {
+    Dex_DrawBoxLayer(x, y, w, h, 0);
+}
+
+/* ---------------------------------------------------------------- text */
+
+#define G_SPACE 0xFD
+#define G_END 0xFF
+
+static u8 Dex_Glyph(char c) {
+    if (c >= '0' && c <= '9') {
+        return (u8)(c - '0');
+    }
+    if (c >= 'A' && c <= 'Z') {
+        return (u8)(c - 'A' + 10);
+    }
+    if (c >= 'a' && c <= 'z') {
+        return (u8)(c - 'a' + 0x24);
+    }
+    switch (c) {
+    case '&': return 0x42;
+    case '?': return 0x44;
+    case '!': return 0x45;
+    case '/': return 0x46;
+    case '-': return 0x49;
+    case ',': return 0x54;
+    case '.': return 0x55;
+    case '\'': return 0x56;
+    case ':': return 0x59;
+    case '+': return 0x5B;
+    default: return G_SPACE;
+    }
+}
+
+/* Builds game text: Dex_Cat(buf, &n, ...) appends ASCII, Dex_CatGame game text (0xFF ended). */
+static void Dex_Cat(u8 *buf, s32 *n, s32 max, const char *s) {
+    while (*s != 0 && *n < max - 1) {
+        buf[(*n)++] = Dex_Glyph(*s++);
+    }
+    buf[*n] = G_END;
+}
+
+static void Dex_CatGame(u8 *buf, s32 *n, s32 max, const u8 *s) {
+    while (s != NULL && *s != G_END && *n < max - 1) {
+        if (*s >= 0xF0 && *s != G_SPACE) { /* escapes (builtin strings) take two bytes */
+            if (*n >= max - 2) {
+                break;
+            }
+            buf[(*n)++] = *s++;
+        }
+        buf[(*n)++] = *s++;
+    }
+    buf[*n] = G_END;
+}
+
+static void Dex_CatNum(u8 *buf, s32 *n, s32 max, s32 v, s32 width) {
+    char t[12];
+    s32 i = 0;
+    s32 k;
+
+    do {
+        t[i++] = (char)('0' + v % 10);
+        v /= 10;
+    } while (v != 0 && i < 10);
+    for (k = i; k < width; k++) {
+        Dex_Cat(buf, n, max, "0");
+    }
+    while (i > 0) {
+        char c[2] = { t[--i], 0 };
+        Dex_Cat(buf, n, max, c);
+    }
+}
+
+static void Dex_Text(s32 *slot, u8 *text, s32 x, s32 y, s32 color) {
+    TextOpenArgs a;
+
+    Mem_Zero(&a, sizeof(a));
+    a.text = (s32)(sptr)text;
+    a.bigFont = 0;
+    a.color = color;
+    a.x = (s16)x;
+    a.y = (s16)y;
+    a.charDelay = 0;
+    Text_Open(slot, &a);
+}
+
+/* ---------------------------------------------------------------- the screen */
+
+#define DEX_ROWS 17
+#define DEX_LIST_X 8
+#define DEX_LIST_Y 24
+#define DEX_ROW_H 11
+#define DEX_INFO_LINES 9
+#define DEX_NAME_MAX 24
+#define DEX_LINE_MAX 40
+#define DEX_MAX 256
+#define DEX_MODEL_H 84  /* rows from the feet to the top of the head */
+#define DEX_MODEL_CY 48 /* screen row the model is centred on (its feet project a little below row 0) */
+#define DEX_BOX_LAYER 5
+#define DEX_MODEL_Z -0x1E00
+
+typedef struct {
+    s32 listText[DEX_ROWS];
+    s32 infoText[DEX_INFO_LINES];
+    s32 titleText;
+    s32 count;          /* Digimon in the table */
+    s32 top;            /* first row shown */
+    s32 sel;            /* selected index */
+    s32 shownSel;       /* the info shows this one (-1: nothing yet) */
+    s32 shownAll;       /* Host_DexShowAll when the texts were made */
+    s32 ramp;
+    s32 modelId;        /* digiId whose model is attached (0 none) */
+    s32 modelFile;
+    s32 silhouette;
+    s32 fitScale;       /* the model's scale and screen offset, fitted to the window (0: not yet) */
+    s32 fitY;
+    s16 rot[4];
+    s32 dirty;
+} DexWork;
+
+static u8 Dex_Ids[DEX_MAX];
+static u8 Dex_ListBuf[DEX_ROWS][DEX_LINE_MAX];
+static u8 Dex_InfoBuf[DEX_INFO_LINES][DEX_LINE_MAX];
+static u8 Dex_TitleBuf[DEX_LINE_MAX];
+static const u8 Dex_Unknown[] = { 0x44, 0x44, 0x44, 0x44, 0x44, G_END }; /* "?????" */
+
+void Menu_DigidexInit(Actor *a, s32 arg);
+void Menu_DigidexTask(Actor *a);
+void Menu_DigidexDraw(Actor *a);
+void Menu_DigidexDestroy(Actor *a);
+TaskDesc Menu_DigidexDesc = {
+    (TaskInitFn)Menu_DigidexInit, Menu_DigidexTask, Menu_DigidexDestroy, Menu_DigidexDraw, sizeof(DexWork), 4,
+};
+
+static const u8 *Dex_NameOf(s32 id) {
+    return Dex_Shown(id) != 0 ? Digi_GetDefaultName(id) : Dex_Unknown;
+}
+
+static void Dex_ListTexts(DexWork *w) {
+    s32 r;
+
+    for (r = 0; r < DEX_ROWS; r++) {
+        s32 i = w->top + r;
+        s32 n = 0;
+        u8 *b = Dex_ListBuf[r];
+
+        if (i >= w->count) {
+            Text_Close(&w->listText[r]);
+            continue;
+        }
+        Dex_CatNum(b, &n, DEX_LINE_MAX, i + 1, 3);
+        Dex_Cat(b, &n, DEX_LINE_MAX, " ");
+        Dex_CatGame(b, &n, DEX_LINE_MAX, Dex_NameOf(Dex_Ids[i]));
+        Dex_Text(&w->listText[r], b, DEX_LIST_X + 10, DEX_LIST_Y + 6 + r * DEX_ROW_H, Dex_Shown(Dex_Ids[i]) == 0);
+    }
+}
+
+static const char *const Dex_LevelNames[] = { "Rookie", "Champion", "Ultimate", "Mega" };
+
+static void Dex_InfoTexts(DexWork *w) {
+    s32 id = Dex_Ids[w->sel];
+    s32 lv = Dex_Shown(id);
+    DigiBaseData *b = Digi_FindBaseData(id);
+    s32 line = 0;
+    s32 i;
+    s32 k;
+    s32 n;
+    u8 *t;
+
+#define LINE() (t = Dex_InfoBuf[line], n = 0)
+#define PUT(color) (Dex_Text(&w->infoText[line], Dex_InfoBuf[line], 146, 136 + line * DEX_ROW_H, (color)), line++)
+    /* name and number */
+    LINE();
+    Dex_CatNum(t, &n, DEX_LINE_MAX, w->sel + 1, 3);
+    Dex_Cat(t, &n, DEX_LINE_MAX, " ");
+    Dex_CatGame(t, &n, DEX_LINE_MAX, Dex_NameOf(id));
+    PUT(0);
+    /* level and type */
+    LINE();
+    k = Digi_GetRank(id);
+    Dex_Cat(t, &n, DEX_LINE_MAX, k >= 0 && k < 4 ? Dex_LevelNames[k] : "?");
+    if (lv != 0) {
+        Dex_Cat(t, &n, DEX_LINE_MAX, "  ");
+        Dex_CatGame(t, &n, DEX_LINE_MAX, (u8 *)Cd_GetFileEntry(Digi_GetType(id) + 0x1FD00C3));
+    }
+    PUT(lv == 0);
+    /* technique: owned only */
+    LINE();
+    Dex_Cat(t, &n, DEX_LINE_MAX, "Tech: ");
+    k = Digi_GetLearnedSkill(id);
+    if (lv == 2 && k != 0) {
+        Dex_CatGame(t, &n, DEX_LINE_MAX, (u8 *)(sptr)Skill_GetNameText(k));
+    } else {
+        Dex_CatGame(t, &n, DEX_LINE_MAX, lv == 2 ? (const u8 *)"\xFF" : Dex_Unknown);
+    }
+    PUT(lv != 2);
+    /* from: every Digimon whose table names this one */
+    LINE();
+    Dex_Cat(t, &n, DEX_LINE_MAX, "From: ");
+    k = 0;
+    for (i = 0; i < w->count && k < 2; i++) {
+        DigiBaseData *p = Digi_FindBaseData(Dex_Ids[i]);
+        s32 j;
+
+        for (j = 0; j < 4; j++) {
+            if (p->rangeValues[j] == id) {
+                if (k++ != 0) {
+                    Dex_Cat(t, &n, DEX_LINE_MAX, ", ");
+                }
+                Dex_CatGame(t, &n, DEX_LINE_MAX, Dex_NameOf(Dex_Ids[i]));
+                break;
+            }
+        }
+    }
+    if (k == 0) {
+        Dex_Cat(t, &n, DEX_LINE_MAX, "-");
+    }
+    PUT(0);
+    /* into, by DP (Digi_GetEvolutionTarget's ranges) */
+    LINE();
+    Dex_Cat(t, &n, DEX_LINE_MAX, "Digivolves into:");
+    PUT(0);
+    k = 0;
+    if (b != NULL && b->rangeValues[0] != 0) {
+        for (i = 0; i < 4 && b->rangeValues[i] != 0 && line < DEX_INFO_LINES; i++) {
+            s32 hi = i < 4 && b->rangeBounds[i + 1] != 0 ? b->rangeBounds[i + 1] - 1 : -1;
+
+            LINE();
+            Dex_Cat(t, &n, DEX_LINE_MAX, " DP ");
+            Dex_CatNum(t, &n, DEX_LINE_MAX, b->rangeBounds[i], 1);
+            if (hi < 0) {
+                Dex_Cat(t, &n, DEX_LINE_MAX, "+");
+            } else if (hi != b->rangeBounds[i]) {
+                Dex_Cat(t, &n, DEX_LINE_MAX, "-");
+                Dex_CatNum(t, &n, DEX_LINE_MAX, hi, 1);
+            }
+            Dex_Cat(t, &n, DEX_LINE_MAX, "  ");
+            Dex_CatGame(t, &n, DEX_LINE_MAX, Dex_NameOf(b->rangeValues[i]));
+            PUT(Dex_Shown(b->rangeValues[i]) == 0);
+            k++;
+        }
+    }
+    if (k == 0) {
+        LINE();
+        Dex_Cat(t, &n, DEX_LINE_MAX, " -");
+        PUT(0);
+    }
+    while (line < DEX_INFO_LINES) {
+        Text_Close(&w->infoText[line++]);
+    }
+#undef LINE
+#undef PUT
+}
+
+static void Dex_TitleText(DexWork *w) {
+    s32 seen = 0;
+    s32 owned = 0;
+    s32 i;
+    s32 n = 0;
+
+    for (i = 0; i < w->count; i++) {
+        s32 lv = Dex_Shown(Dex_Ids[i]);
+
+        seen += lv != 0;
+        owned += lv == 2;
+    }
+    Dex_Cat(Dex_TitleBuf, &n, DEX_LINE_MAX, "DIGIDEX   Seen ");
+    Dex_CatNum(Dex_TitleBuf, &n, DEX_LINE_MAX, seen, 1);
+    Dex_Cat(Dex_TitleBuf, &n, DEX_LINE_MAX, "  Owned ");
+    Dex_CatNum(Dex_TitleBuf, &n, DEX_LINE_MAX, owned, 1);
+    Dex_Cat(Dex_TitleBuf, &n, DEX_LINE_MAX, "  of ");
+    Dex_CatNum(Dex_TitleBuf, &n, DEX_LINE_MAX, w->count, 1);
+    Dex_Text(&w->titleText, Dex_TitleBuf, 14, 8, 0);
+}
+
+static void Dex_FreeModel(Actor *a) {
+    ActorModel *m = a->model;
+
+    if (m != NULL) {
+        if (m->screenXY != NULL) {
+            Mem_Free((ActorWork *)m->screenXY);
+        }
+        if (m->vertOtz != NULL) {
+            Mem_Free((ActorWork *)m->vertOtz);
+        }
+        if (m->vertColors != NULL) {
+            Mem_Free((ActorWork *)m->vertColors);
+        }
+        if (m->bones != NULL) {
+            Mem_Free((ActorWork *)m->bones);
+        }
+        Mem_Free((ActorWork *)m);
+        a->model = NULL;
+    }
+}
+
+static void Dex_SetModel(Actor *a, DexWork *w, s32 id) {
+    s32 file = Digi_GetModelFile(id);
+
+    if (id == w->modelId) {
+        return;
+    }
+    Dex_FreeModel(a);
+    w->modelId = 0;
+    if (file <= 0) {
+        return;
+    }
+    Cd_GetFileSync(file);
+    Cd_GetFileSync(Digi_GetAnimFile(id, 0));
+    a->digiId = id;
+    Gfx_AttachModel(a, file)->otIndex = 3;
+    Anim_SetModelAnim(a, 0);
+    w->modelId = id;
+    w->modelFile = file;
+    w->fitScale = 0;
+}
+
+void Menu_DigidexInit(Actor *a, s32 arg) {
+    DexWork *w = (DexWork *)a->work;
+    s32 pos[3] = { 0, 0, 0 };
+    s32 n = 0;
+    s32 id;
+    Blk16 *b;
+    s32 *q;
+    s32 i;
+
+    (void)arg;
+    Mem_Zero(w, sizeof(*w));
+    Mem_FillWordsNeg1(w->listText, DEX_ROWS);
+    Mem_FillWordsNeg1(w->infoText, DEX_INFO_LINES);
+    w->titleText = -1;
+    for (id = 1; id < DEX_MAX && n < DEX_MAX; id++) {
+        DigiBaseData *d = Digi_FindBaseData(id);
+
+        if (d != NULL && d->id == id && Digi_GetModelFile(id) > 0) {
+            Dex_Ids[n++] = (u8)id;
+        }
+    }
+    w->count = n;
+    w->shownSel = -1;
+    w->rot[0] = -0xE3;
+    Actor_InitTransform((ContC40 *)a, pos, 0);
+    b = (Blk16 *)Cd_GetFileEntry(0x513001F); /* the status screen's lights */
+    q = (s32 *)Cd_GetFileEntry(0x5130020);
+    for (i = 0; i < 3; i++) {
+        GsSetFlatLight(i, (GsF_LIGHT *)&b[i]);
+    }
+    GsSetAmbient(q[0], q[1], q[2]);
+    GsSetLightMode(0);
+    Dex_ScanRoster();
+}
+
+void Menu_DigidexDestroy(Actor *a) {
+    Dex_FreeModel(a);
+    Task_DefaultDestroy(a);
+}
+
+void Menu_DigidexTask(Actor *a) {
+    DexWork *w = (DexWork *)a->work;
+    s32 old;
+    u16 rep;
+
+    switch (a->stateLevel0) {
+    case 0:
+    default:
+        if (Math_RampToOne(0, &w->ramp) == 0) {
+            w->dirty = 1;
+            Task_NextState0(a);
+        }
+        break;
+    case 1:
+        old = w->sel;
+        rep = Pad_State[0].repeat;
+        if (rep & 0x1000) {
+            w->sel = w->sel > 0 ? w->sel - 1 : w->count - 1;
+        } else if (rep & 0x4000) {
+            w->sel = w->sel < w->count - 1 ? w->sel + 1 : 0;
+        } else if (rep & 0x8000) {
+            w->sel = w->sel - DEX_ROWS < 0 ? 0 : w->sel - DEX_ROWS;
+        } else if (rep & 0x2000) {
+            w->sel = w->sel + DEX_ROWS >= w->count ? w->count - 1 : w->sel + DEX_ROWS;
+        }
+        if (w->sel != old) {
+            Snd_PlayById(0xC, 0);
+        }
+        if (w->sel < w->top) {
+            w->top = w->sel;
+            w->dirty = 1;
+        } else if (w->sel >= w->top + DEX_ROWS) {
+            w->top = w->sel - DEX_ROWS + 1;
+            w->dirty = 1;
+        }
+        if (w->shownAll != Host_DexShowAll()) {
+            w->dirty = 1;
+        }
+        if (w->dirty) {
+            w->dirty = 0;
+            w->shownAll = Host_DexShowAll();
+            Dex_ListTexts(w);
+            Dex_TitleText(w);
+            w->shownSel = -1;
+        }
+        if (w->shownSel != w->sel) {
+            w->shownSel = w->sel;
+            Dex_InfoTexts(w);
+            Dex_SetModel(a, w, Dex_Ids[w->sel]);
+            w->rot[1] = 0;
+        }
+        w->silhouette = Dex_Shown(Dex_Ids[w->sel]) == 0;
+        w->rot[1] = (s16)((w->rot[1] + 11) & 0xFFF);
+        if (Pad_State[0].triangle > 0 || Pad_State[0].circle > 0) {
+            Snd_PlayById(0xB, 0);
+            Text_CloseArray(w->listText, DEX_ROWS);
+            Text_CloseArray(w->infoText, DEX_INFO_LINES);
+            Text_Close(&w->titleText);
+            Task_NextState0(a);
+        }
+        break;
+    case 2:
+        if (Math_RampToZero(0, &w->ramp) == 0) {
+            GsSetOffset(0, 0);
+            Task_SetState0(a, 3);
+        }
+        break;
+    }
+}
+
+void Menu_DigidexDraw(Actor *a) {
+    DexWork *w = (DexWork *)a->work;
+    static GsCOORDINATE2 coord;
+    GsRVIEW2 v;
+    AllocC40 *x;
+
+    if (w->ramp == 0) {
+        return;
+    }
+    /* the windows: the list, the model, the info */
+    Dex_DrawBoxLayer(4, 18, 132, 214, DEX_BOX_LAYER);
+    Dex_DrawBoxLayer(140, 18, 176, 104, DEX_BOX_LAYER);
+    Dex_DrawBoxLayer(140, 126, 176, 106, DEX_BOX_LAYER);
+    /* the selection: a bar of the menu cursor's colour under the row */
+    if (a->stateLevel0 == 1) {
+        s32 r = w->sel - w->top;
+        GfxPart *cur = (GfxPart *)Cd_GetFileEntry(0x459000A);
+
+        for (; cur->fileId != 0; cur++) {
+            if (cur->fileId == 0x04570003) {
+                GfxPart c = *cur;
+                GfxPart end[2];
+
+                c.x = (s16)(DEX_LIST_X - 160);
+                c.y = (s16)(DEX_LIST_Y + 4 + r * DEX_ROW_H - 120);
+                c.visible = 1;
+                c.palette = (u8)((a->elapsed >> 2) & 3);
+                end[0] = c;
+                Mem_Zero(&end[1], sizeof(end[1]));
+                Gfx_SetPartsScale((void *)end, 0x1000, 0x1000);
+                Gfx_DrawParts((s32)(sptr)end);
+                break;
+            }
+        }
+    }
+    if (w->modelId == 0 || a->stateLevel0 != 1) {
+        return;
+    }
+    /* the model, turning, in the right window */
+    GsSetOffset(68, w->fitScale != 0 ? w->fitY : 0);
+    RotMatrixYXZ((SVECTOR *)w->rot, &coord.coord);
+    coord.coord.t[0] = coord.coord.t[1] = coord.coord.t[2] = 0;
+    coord.flg = 0;
+    coord.super = NULL;
+    coord.sub = NULL;
+    Mem_Zero(&v, sizeof(v));
+    v.vpy = -0x180;
+    v.vpz = DEX_MODEL_Z;
+    v.super = &coord;
+    GsSetProjection(0x230);
+    GsSetRefView2(&v);
+    /* unmet: a silhouette, every vertex the flat colour black (Gfx_CalcNormalColors uses the
+     * model's flat colour when its clutRow is not 0; 1 would pick the other palette) */
+    a->model->clutRow = w->silhouette ? 2 : 0;
+    a->model->_pad38[0] = a->model->_pad38[1] = a->model->_pad38[2] = 0;
+    x = (AllocC40 *)a->u38.ptr38;
+    x->scaleX = x->scaleY = x->scaleZ = w->fitScale != 0 ? w->fitScale : 0x1000;
+    Anim_StepModelAnim(a);
+    Actor_UpdateTransform(a);
+    Gfx_CalcModelBoneMatrices(a);
+    if (w->fitScale == 0) {
+        /* first frame of a model: fit it, from where its bones project at scale 1 (the mesh
+         * reaches a little past the joints), to DEX_MODEL_H rows centred in the window */
+        ModelBone *e = a->model->bones;
+        s32 lo = 0x7FFF;
+        s32 hi = -0x7FFF;
+        s32 y;
+        s32 k;
+
+        for (k = 0; k < a->model->boneCount; k++, e++) {
+            MATRIX *m = (MATRIX *)&e->viewMat;
+
+            if (m->t[2] > 0) {
+                y = m->t[1] * 0x230 / m->t[2];
+                lo = y < lo ? y : lo;
+                hi = y > hi ? y : hi;
+            }
+        }
+        /* the model stands on its origin, which projects to row 0; its head reaches a little
+         * past the highest joint */
+        lo = lo * 115 / 100;
+        if (lo > -8) {
+            lo = -8;
+        }
+        y = 0x1000 * DEX_MODEL_H / -lo;
+        w->fitScale = y < 0x400 ? 0x400 : y > 0x2400 ? 0x2400 : y;
+        w->fitY = DEX_MODEL_CY - 120 - lo * w->fitScale / 0x1000 / 2;
+        __builtin_printf("[dex] fit %d: joints %d..%d (%d bones) -> scale %X, y %d\n", w->modelId, lo, hi, a->model->boneCount, w->fitScale, w->fitY);
+        return;
+    }
+    Gfx_DrawTexModel(a, 0);
+}
