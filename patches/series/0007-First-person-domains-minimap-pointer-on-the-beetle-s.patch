From cea71cf801f50f8241c253e5f114825a2e122d89 Mon Sep 17 00:00:00 2001
From: FP mod <fpmod@localhost>
Date: Mon, 26 Oct 2026 20:17:12 +0000
Subject: [PATCH 07/29] First-person domains: minimap pointer on the beetle's
 own marker

Instead of a large arrow over the marker, a small white triangle on the side
of the game's marker square the view faces.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01B1oHeiADE8njqFxkaQnJAX
---
 doc/FPVIEW.md                  |  7 ++++---
 src/stag4000/fpview_math.inc   |  2 +-
 src/stag4000/fpview_native.inc | 32 ++++++++++++++++----------------
 3 files changed, 21 insertions(+), 20 deletions(-)

diff --git a/doc/FPVIEW.md b/doc/FPVIEW.md
index f328e67..4ff1cbf 100644
--- a/doc/FPVIEW.md
+++ b/doc/FPVIEW.md
@@ -45,8 +45,9 @@ before, and the PS1 matching build is untouched: every change is inside `#ifdef
 - **Square tiles**: retail rows are 0x800 deep and columns 0xA00 wide (made for the angled
   overhead camera). In first person both are 0xA00, and entity positions go through
   `Stg40_FpWorldX / Z` to match. The FP world is centred on the beetle.
-- **Minimap arrow**: in first person a yellow arrow over the beetle on both automap views
-  points the way the view faces and turns with it (`Stg40_FpDrawMapArrow`).
+- **Minimap pointer**: in first person the beetle's own marker square on both automap views
+  gets a small white triangle on the side the view faces, turning with it
+  (`Stg40_FpDrawMapArrow`).
 - **Entities** beyond the retail 5-tile window are drawn through the 16:9 side models
   (out to the radius). Models behind the eye are dropped by the GTE error flags per bone.
 - **The beetle** and the models linked to it are not drawn (their anims still run).
@@ -55,7 +56,7 @@ before, and the PS1 matching build is untouched: every change is inside `#ifdef
 
 `src/stag4000/fpview_math.inc`: `FP_EYE` (eye height), `FP_H` (projection, about 80 degrees),
 `FP_PITCH` (look down), `FP_FOG_START / END`, `STG40_FP_RADIUS` (in `fpview.h`),
-`FP_TURN_STEP` (turn speed), `FP_MAP_ARROW` (minimap arrow size).
+`FP_TURN_STEP` (turn speed), `FP_MAP_ARROW` (minimap pointer size).
 
 ## Known limits
 
diff --git a/src/stag4000/fpview_math.inc b/src/stag4000/fpview_math.inc
index 6f9673a..7232aa3 100644
--- a/src/stag4000/fpview_math.inc
+++ b/src/stag4000/fpview_math.inc
@@ -18,7 +18,7 @@
 #define FP_FOG_END (FP_TILE * (STG40_FP_RADIUS - 0.5f))
 #define FP_FLOOR_BIAS 96        /* OT entries a floor sorts behind its centre (entities on it) */
 #define FP_SHADOW_BIAS (FP_FLOOR_BIAS - 6)
-#define FP_MAP_ARROW 1.0f       /* minimap arrow size: 1.0 = about one tile long */
+#define FP_MAP_ARROW 1.0f       /* minimap pointer size: 1.0 = 0.8 of a tile long */
 #define FP_CEILING_SHADE 0x58   /* ceilings a little darker than the floor (0x7F) */
 #define FP_TURN_STEP 0x100      /* camera yaw per frame (as the beetle turns) */
 #define FP_PACKET_BYTES 0x18000 /* the floor's own packet area per frame buffer */
diff --git a/src/stag4000/fpview_native.inc b/src/stag4000/fpview_native.inc
index e06bc58..32eae09 100644
--- a/src/stag4000/fpview_native.inc
+++ b/src/stag4000/fpview_native.inc
@@ -566,7 +566,7 @@ static void Stg40_FpMapTri(s32 *ot, const float *pts, u8 r, u8 g, u8 b) {
 }
 
 /* The beetle's facing on the automap window Stg40_AutomapDrawWindow draws at x, y around cell
- * (cx, cy) with `scale` pixels per cell: an arrow over the beetle's dot. Called before that
+ * (cx, cy) with `scale` pixels per cell: a small pointer on the beetle's marker square. Called before that
  * window links its quads into the same OT entry, so it draws over them (an entry draws its
  * packets newest first). A cell's texel is col + 4 (pix rows start one halfword in) and the
  * window shows texel left + 3 at x + (left - cx) * scale, so cell col sits at
@@ -583,7 +583,6 @@ void Stg40_FpDrawMapArrow(s32 x, s32 y, s32 cx, s32 cy, s32 scale, s32 fade) {
     float py;
     float pts[6];
     float k;
-    s32 pass;
 
     if (!Stg40_FpActive() || loc == NULL || fade <= 0) {
         return;
@@ -596,19 +595,20 @@ void Stg40_FpDrawMapArrow(s32 x, s32 y, s32 cx, s32 cy, s32 scale, s32 fade) {
     dy = cosf(a);
     px = -dy;      /* perpendicular */
     py = dx;
-    /* the arrow first, then its dark outline: the outline (linked later) draws first */
-    for (pass = 0; pass < 2; pass++) {
-        k = (pass == 0 ? 1.0f : 1.35f) * FP_MAP_ARROW * scale;
-        pts[0] = sx + dx * 0.85f * k;
-        pts[1] = sy + dy * 0.85f * k;
-        pts[2] = sx - dx * 0.5f * k + px * 0.55f * k;
-        pts[3] = sy - dy * 0.5f * k + py * 0.55f * k;
-        pts[4] = sx - dx * 0.5f * k - px * 0.55f * k;
-        pts[5] = sy - dy * 0.5f * k - py * 0.55f * k;
-        if (pass == 0) {
-            Stg40_FpMapTri(ot, pts, (u8)(0xFF * fade / 0xFF), (u8)(0xDC * fade / 0xFF), (u8)(0x28 * fade / 0xFF));
-        } else {
-            Stg40_FpMapTri(ot, pts, (u8)(0x20 * fade / 0xFF), (u8)(0x18 * fade / 0xFF), 0);
-        }
+    /* a pointer on the side of the game's own marker square the view faces: its base half a
+     * cell out (on the edge facing straight; just inside the corner facing diagonally), its tip
+     * 0.8 * FP_MAP_ARROW cells beyond. The square itself is left as the game draws it. */
+    k = FP_MAP_ARROW * scale;
+    {
+        float bx = sx + dx * 0.5f * scale;
+        float by = sy + dy * 0.5f * scale;
+
+        pts[0] = bx + dx * 0.8f * k;
+        pts[1] = by + dy * 0.8f * k;
+        pts[2] = bx + px * 0.45f * k;
+        pts[3] = by + py * 0.45f * k;
+        pts[4] = bx - px * 0.45f * k;
+        pts[5] = by - py * 0.45f * k;
     }
+    Stg40_FpMapTri(ot, pts, (u8)(0xF0 * fade / 0xFF), (u8)(0xF0 * fade / 0xFF), (u8)(0xF0 * fade / 0xFF));
 }
