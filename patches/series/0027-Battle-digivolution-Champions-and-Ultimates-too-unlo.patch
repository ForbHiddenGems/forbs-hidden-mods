 include/stag3000/evo_native.h |  7 ++--
 src/stag3000/battle.c         |  6 ++--
 src/stag3000/evo_native.inc   | 61 ++++++++++++++++++++++++-----------
 4 files changed, 53 insertions(+), 27 deletions(-)

