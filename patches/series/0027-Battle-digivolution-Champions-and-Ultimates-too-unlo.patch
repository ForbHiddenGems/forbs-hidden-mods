     s32 i;
 
 #ifdef DW2_NATIVE
-    Stg30_EvoReturnAll(); /* every battle end comes here: the Champion forms go back first */
+    Stg30_EvoReturnAll(); /* every battle end comes here: the digivolved forms go back first */
 #endif
     for (i = 0; i < 3; i++) {
         if (Stg30_Battle.digis[i].state >= 3) {
@@ -469,7 +469,7 @@ void Stg30_BattleUpdate(Actor *a0) {
             default:
 #ifdef DW2_NATIVE
                 if (Stg30_EvoStep(0)) {
-                    break; /* a Champion form returns before the commands */
+                    break; /* a digivolved form returns before the commands */
                 }
 #endif
                 for (n2 = 0; n2 < 7; n2++) {
@@ -787,7 +787,7 @@ void Stg30_BattleDestroy(Actor *a0) {
 
 #ifdef DW2_NATIVE
     for (i = 0; i < 3; i++) {
-        Stg30_EvoReturnData(i); /* never into the save as a Champion form */
+        Stg30_EvoReturnData(i); /* never into the save as a digivolved form */
     }
 #endif
     for (i = 0; i < 3; i++) {
