     DigiRosterEntry *d = &Stg30_Battle.digis[slot];
@@ -312,7 +335,7 @@ static void Stg30_EvoReturnData(s32 slot) {
         }
     }
     if (e->skillSlot >= 0) {
-        d->skills[e->skillSlot] = (u8)e->skillOld; /* the Champion's technique goes with it */
+        d->skills[e->skillSlot] = (u8)e->skillOld; /* the new form's technique goes with it */
