+/* The rotation to draw an entity with: the beetle's eased one in the 3D views with smooth
+ * turning, else the game's. */
+s32 Stg40_FpDrawHeading(void *ent, s32 rot) {
+    if (Stg40_FpActive() && Host_FpSmoothTurn() && ent == (void *)Stg40_RootState->playerEnt) {
+        return Stg40_FpBodyYaw;
+    }
+    return rot;
+}
+
+/* angle *a (0..0xFFF) toward target: eased (smooth turning) or at most `step` a frame. */
+static void Stg40_FpTurnToward(s32 *a, s32 target, s32 smooth, s32 step) {
+    s32 d = ((target - *a + 0x800) & 0xFFF) - 0x800; /* shortest way, -0x800..0x7FF */
+    s32 m;
+
+    if (smooth) {
+        if (d <= FP_TURN_SNAP && d >= -FP_TURN_SNAP) {
+            m = d;
+        } else {
+            m = (s32)lrintf(d * FP_TURN_EASE);
+            if (m == 0) {
+                m = d > 0 ? 1 : -1;
+            }
+        }
+    } else {
+        m = d > step ? step : d < -step ? -step : d;
+    }
+    *a = (*a + m) & 0xFFF;
+}
+
 s32 Stg40_FpHidesEnt(void *ent) {
