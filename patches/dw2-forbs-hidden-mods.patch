diff --git a/host/mods.c b/host/mods.c
new file mode 100644
index 0000000..301d4ae
--- /dev/null
+++ b/host/mods.c
@@ -0,0 +1,169 @@
+/* Model mods (native only): replacement game files in a mods/ folder.
+ *
+ * A file named <hex file id>.bin (e.g. 0A12.bin, as the dw2model Blender add-on exports it) in
+ * the folder named by mods-folder.txt next to the exe, in mods/ next to the exe, or in mods/ in
+ * the user data folder (the first one found wins), is served to the game instead of
+ * that file from dw2.pak. The pack itself is never changed and is still checked in full; with
+ * no mods folder (or an empty one) nothing changes. The game reads every model, animation and
+ * texture file through Cd_ReadFileAsync (src/main/cdread.c), which asks Host_ModFile first. */
+#include <SDL3/SDL.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "host.h"
+
+/* 0x001..0xE5A replace the disc's files; 0xE5B..0x7FFF are new files (a new Digimon's model and
+ * animations: the add-on numbers them 0x1000 + number * 16 + k) */
+#define MOD_IDS 0x8000
+
+static void *mod_data[MOD_IDS];
+static int mod_size[MOD_IDS];
+static int mod_count;
+static unsigned char mod_dir[MOD_IDS]; /* which folder it came from (1, 2, ...), for duplicates */
+static char *mod_name[MOD_IDS];
+static int dir_index;
+
+static int hexval(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* "0A12.bin" -> 0xA12 ("1AA0.bin" for new files), else -1. A label may follow the number after a
+ * space, "_" or "-": "005C Agumon model.bin" is file 005C too (only the first 4 characters count). */
+static int mod_id(const char *name) {
+    size_t n = strlen(name);
+    int id = 0;
+    int i;
+
+    if (n < 8 || SDL_strcasecmp(name + n - 4, ".bin") != 0) {
+        return -1;
+    }
+    if (n > 8 && name[4] != ' ' && name[4] != '_' && name[4] != '-') {
+        return -1;
+    }
+    for (i = 0; i < 4; i++) {
+        int v = hexval(name[i]);
+        if (v < 0) {
+            return -1;
+        }
+        id = id * 16 + v;
+    }
+    return id > 0 && id < MOD_IDS ? id : -1;
+}
+
+static SDL_EnumerationResult SDLCALL scan_one(void *dir, const char *dirname, const char *name) {
+    char *path = NULL;
+    size_t size = 0;
+    void *data;
+    int id = mod_id(name);
+
+    (void)dir;
+    if (id >= 0 && mod_data[id] != NULL && mod_dir[id] == dir_index) {
+        printf("[mods] skipped %s%s: file %04X is already %s in this folder\n", dirname, name, id, mod_name[id]);
+    }
+    if (id < 0 || mod_data[id] != NULL) {
+        return SDL_ENUM_CONTINUE; /* not a mod file, or already taken from a folder read earlier */
+    }
+    SDL_asprintf(&path, "%s%s", dirname, name);
+    data = path ? SDL_LoadFile(path, &size) : NULL;
+    if (data == NULL || size == 0 || size > 0x80000) {
+        printf("[mods] skipped %s (%s)\n", path ? path : name, data ? "bigger than 512 KB" : SDL_GetError());
+        SDL_free(data);
+    } else {
+        mod_data[id] = data;
+        mod_size[id] = (int)size;
+        mod_dir[id] = dir_index;
+        mod_name[id] = SDL_strdup(name);
+        mod_count++;
+        printf("[mods] file %04X <- %s (%d bytes)\n", id, path, (int)size);
+    }
+    SDL_free(path);
+    return SDL_ENUM_CONTINUE;
+}
+
+static void scan(const char *base) {
+    char *dir = NULL;
+    SDL_PathInfo info;
+
+    if (base == NULL) {
+        return;
+    }
+    SDL_asprintf(&dir, "%smods", base);
+    if (dir != NULL && SDL_GetPathInfo(dir, &info) && info.type == SDL_PATHTYPE_DIRECTORY) {
+        dir_index++;
+        SDL_EnumerateDirectory(dir, scan_one, NULL);
+    }
+    SDL_free(dir);
+}
+
+/* mods-folder.txt next to the exe: one line naming the mods folder to read first (absolute, or
+ * relative to the exe). Forbs Hidden Mods' forbs.py writes it so every build reads the one mods
+ * folder in the forbs-hidden-mods folder. */
+static void scan_listed(const char *base) {
+    char *txt = NULL;
+    char *line;
+    char *dir = NULL;
+    size_t size = 0;
+    size_t n;
+    int absolute;
+
+    if (base == NULL) {
+        return;
+    }
+    SDL_asprintf(&txt, "%smods-folder.txt", base);
+    line = txt ? (char *)SDL_LoadFile(txt, &size) : NULL;
+    SDL_free(txt);
+    if (line == NULL) {
+        return;
+    }
+    n = strcspn(line, "\r\n");
+    line[n] = '\0';
+    while (n > 0 && (line[n - 1] == '/' || line[n - 1] == '\\' || line[n - 1] == ' ')) {
+        line[--n] = '\0';
+    }
+    if (n > 0) {
+        absolute = line[0] == '/' || line[0] == '\\' || (n > 1 && line[1] == ':');
+        SDL_asprintf(&dir, "%s%s/", absolute ? "" : base, line);
+        if (dir != NULL) {
+            SDL_PathInfo info;
+            if (SDL_GetPathInfo(dir, &info) && info.type == SDL_PATHTYPE_DIRECTORY) {
+                printf("[mods] reading %s (from mods-folder.txt)\n", dir);
+                dir_index++;
+                SDL_EnumerateDirectory(dir, scan_one, NULL);
+            } else {
+                printf("[mods] mods-folder.txt names %s, which is not a folder\n", dir);
+            }
+        }
+        SDL_free(dir);
+    }
+    SDL_free(line);
+}
+
+void Host_ModsInit(void) {
+    char *pref = SDL_GetPrefPath("", "DW2-Online");
+
+    scan_listed(SDL_GetBasePath());
+    scan(SDL_GetBasePath());
+    scan(pref);
+    SDL_free(pref);
+    if (mod_count) {
+        printf("[mods] %d replacement file(s) in use\n", mod_count);
+        fflush(stdout);
+    }
+}
+
+const void *Host_ModFile(int id, int *size) {
+    if (id <= 0 || id >= MOD_IDS || mod_data[id] == NULL) {
+        return NULL;
+    }
+    if (size) {
+        *size = mod_size[id];
+    }
+    return mod_data[id];
+}
+
+int Host_ModsCount(void) {
+    return mod_count;
+}
