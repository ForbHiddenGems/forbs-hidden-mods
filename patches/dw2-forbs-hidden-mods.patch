diff --git a/src/stag3000/evo_native.inc b/src/stag3000/evo_native.inc
new file mode 100644
index 0000000..7b0354b
--- /dev/null
+++ b/src/stag3000/evo_native.inc
@@ -0,0 +1,753 @@
+/* Battle digivolution (Forbs Hidden Mods, native only; include/stag3000/evo_native.h).
+ * Included by battle.c under DW2_NATIVE.
+ *
+ * Energy: 0..EVO_MAX per party slot, charged after every action from the HP lost since the last
+ * one: taking damage (EVO_TAKE for a whole max HP), dealing it (EVO_DEAL for a whole enemy max HP)
+ * and EVO_ACT for having had a turn. Full, a Rookie, Champion or Ultimate whose digivolution table
+ * names a Digimon one level up (Digi_GetEvolutionTarget at its DP) can choose Digivolve, if the
+ * tamer's rank allows that step (Stg30_EvoRankNeeded): that is its turn (it guards, turn type
+ * 5). After the commands, before the turns run, the Digi-Lab's effect (model 0xDD9, animation 0xDDB,
+ * as Stg20_LabDigivolve) plays on it and halfway through it becomes the new form: battle copy
+ * digiId, the fighter's model and animations, HP / MP and attack / defense / speed up by EVO_BOOST
+ * percent. It fights 3 turns like that; at the start of the round after, the effect plays again and
+ * it returns, keeping the damage it took (its HP is never brought below 1 by the return). The end of
+ * the battle (won, lost, escaped) returns it at once, before the battle writes the party back. */
+
+#include <stdio.h>
+
+#include "stag3000/evo_native.h"
+
+extern u8 Digi_GetEvolutionTarget(s32 id, s32 val);
+extern void Mem_Free(ActorWork *arg0);
+extern s32 Cd_GetFileSync(s32 arg0);
+extern u8 Digi_GetLearnedSkill(s32 digiId);
+extern GfxTexSlot *Gfx_FindOrLoadTexSlot(s32 id);
+
+/* Actor.u38 transform with its Y rotation (Stg20Rot): the fighter spins in the effect. */
+typedef struct {
+    u8 _pad00[0x42];
+    /* 0x42 */ s16 rotY;
+} Stg30EvoXform;
+
+#define EVO_MAX 100
+#define EVO_TAKE 60  /* energy for losing a whole max HP */
+#define EVO_DEAL 45  /* energy for taking a whole max HP from enemies */
+#define EVO_ACT 4    /* energy for having had a turn */
+#define EVO_RATE 120 /* percent: every gain above times this (120 = 20 % faster) */
+#define EVO_TURNS 3  /* turns it fights in the new form */
+#define EVO_BOOST 30 /* percent more HP, MP, attack, defense and speed in the new form */
+#define EVO_BOX_GROW 13 /* rows the party HUD box grows by (and is raised by) for the DP row */
+#define EVO_FX_MODEL 0xDD9
+#define EVO_FX_ANIM 0xDDB
+#define EVO_FX_FRAMES 0x78
+#define EVO_SWAP_AT 0x3C /* frame of the effect at which the form changes */
+
+typedef struct {
+    s32 energy;
+    s32 requested;  /* chose Digivolve this round */
+    s32 turnsLeft;  /* > 0: digivolved; rounds still to end */
+    s32 revert;     /* return at the start of the next round */
+    /* the Rookie it was */
+    s32 fromId;
+    s32 skillSlot; /* its battle copy's skill list slot holding the new form's technique, -1 none */
+    s32 skillOld;  /* what that slot held */
+    s32 hpBonus;
+    s32 mpBonus;
+    s16 maxHp;
+    s16 maxMp;
+    s16 attack;
+    s16 defense;
+    s16 speed;
+} Stg30Evo;
+
+static Stg30Evo Stg30_Evo[3];
+static s16 Stg30_EvoHpSeen[6];
+/* The effect runs as a child task of the fighter (its slot 1, which its skill effects use only
+ * during actions): a task is only updated and drawn through its parent. */
+static s32 *Stg30_EvoFxSlot;
+static s32 Stg30_EvoLift; /* party HUD raised by this much for the DP row (0: off this battle) */
+static s32 Stg30_EvoSeqSlot = -1; /* party slot whose effect is playing, -1 none */
+static s32 Stg30_EvoSeqTimer;
+static s32 Stg30_EvoSeqBack;      /* the effect returns it (1) or digivolves it (0) */
+static s32 Stg30_EvoSeqSwapped;
+static s32 Stg30_EvoSeqSpinning;
+
+/* "Digivolve" */
+u8 Stg30_EvoCommandText[] = { 0x0D, 0x2C, 0x2A, 0x2C, 0x39, 0x32, 0x2F, 0x39, 0x28, 0xFF };
+
+typedef struct {
+    s32 modelFileId;
+    s32 animFileId;
+    s32 x;
+    s32 y;
+    s32 z;
+    s32 rotY;
+    s32 duration;
+} Stg30EvoFxArgs; /* Fx_ModelInit's 7 words (Stg20WarpFx) */
+
+/* The tamer rank (Save_GameState.rank, 0 Cadet .. 10 Master) a Digimon of level `from` (0 Rookie,
+ * 1 Champion, 2 Ultimate) needs to digivolve one level up in battle; -1: it can't (Mega). */
+static s32 Stg30_EvoRankNeeded(s32 from) {
+    switch (from) {
+    case 0:
+        return 0; /* Rookie -> Champion: any rank */
+    case 1:
+        return 5; /* Champion -> Ultimate: Pro */
+    case 2:
+        return 8; /* Ultimate -> Mega: Commander */
+    default:
+        return -1;
+    }
+}
+
+static s32 Stg30_EvoTarget(s32 slot) {
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+    s32 from;
+    s32 need;
+    s32 t;
+
+    if (d->state < 3 || d->digiId == 0) {
+        return 0;
+    }
+    from = Digi_GetRank(d->digiId);
+    need = Stg30_EvoRankNeeded(from);
+    if (need < 0 || Save_GameState.rank < need) {
+        return 0;
+    }
+    t = Digi_GetEvolutionTarget(d->digiId, d->dp);
+    if (t == 0 || Digi_GetRank(t) != from + 1 || Digi_GetModelFile(t) <= 0) {
+        return 0;
+    }
+    return t;
+}
+
+s32 Stg30_EvoCanDigivolve(s32 slot) {
+    if (!Host_FpBattleEvo() || slot < 0 || slot >= 3) {
+        return 0;
+    }
+    return Stg30_Evo[slot].energy >= EVO_MAX && Stg30_Evo[slot].turnsLeft == 0 && !Stg30_Evo[slot].revert &&
+           Stg30_Battle.digis[slot].hp != 0 && Stg30_EvoTarget(slot) != 0;
+}
+
+/* F2 dev overlay (host/devedit.c, in battle): every party Digimon that can digivolve now gets a
+ * full DP gauge. -> how many. */
+s32 Stg30_EvoDevFill(void) {
+    s32 n = 0;
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        Stg30Evo *e = &Stg30_Evo[i];
+
+        if (e->turnsLeft == 0 && !e->revert && Stg30_Battle.digis[i].hp != 0 && Stg30_EvoTarget(i) != 0) {
+            e->energy = EVO_MAX;
+            n++;
+        }
+    }
+    return n;
+}
+
+void Stg30_EvoRequest(s32 slot, s32 on) {
+    if (slot >= 0 && slot < 3) {
+        Stg30_Evo[slot].requested = on && Stg30_EvoCanDigivolve(slot);
+    }
+}
+
+static void Stg30_EvoSeenNow(void) {
+    s32 i;
+
+    for (i = 0; i < 6; i++) {
+        Stg30_EvoHpSeen[i] = Stg30_Battle.digis[i].hp;
+    }
+}
+
+static void Stg30_EvoBattleInit(void) {
+    Mem_Zero(Stg30_Evo, sizeof(Stg30_Evo));
+    Stg30_EvoFxSlot = NULL;
+    Stg30_EvoLift = Host_FpBattleEvo() ? EVO_BOX_GROW : 0;
+    Stg30_EvoSeqSlot = -1;
+    Stg30_EvoSeenNow();
+}
+
+static void Stg30_EvoAdd(s32 slot, s32 v) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+
+    if (v <= 0 || e->turnsLeft != 0 || e->revert || Stg30_EvoTarget(slot) == 0) {
+        return;
+    }
+    e->energy += (v * EVO_RATE + 99) / 100;
+    if (e->energy > EVO_MAX) {
+        e->energy = EVO_MAX;
+    }
+}
+
+/* After an action (battle.c, before the turn order moves on): charge from the HP lost since. */
+static void Stg30_EvoCredit(s32 actor) {
+    s32 dealt = 0;
+    s32 lost;
+    s32 i;
+
+    if (!Host_FpBattleEvo()) {
+        Stg30_EvoSeenNow();
+        return;
+    }
+    for (i = 0; i < 6; i++) {
+        DigiRosterEntry *d = &Stg30_Battle.digis[i];
+
+        lost = Stg30_EvoHpSeen[i] - d->hp;
+        if (lost <= 0 || d->maxHp <= 0) {
+            continue;
+        }
+        if (i < 3) {
+            Stg30_EvoAdd(i, (lost * EVO_TAKE + d->maxHp - 1) / d->maxHp);
+        } else {
+            dealt += (lost * EVO_DEAL + d->maxHp - 1) / d->maxHp;
+        }
+    }
+    if (actor >= 0 && actor < 3 && Stg30_Battle.digis[actor].hp != 0) {
+        Stg30_EvoAdd(actor, dealt + EVO_ACT);
+    }
+    Stg30_EvoSeenNow();
+}
+
+static Actor *Stg30_EvoFighter(s32 slot) {
+    return (Actor *)Task_FindFirst(0x509, -1, slot);
+}
+
+/* The fighter's model and animations become those of digiId: its model is built again (the old
+ * one's bone and vertex buffers are sized for the old model). */
+static void Stg30_EvoSwapModel(s32 slot, s32 digiId) {
+    Actor *a = Stg30_EvoFighter(slot);
+    Stg30FighterWork *w;
+    ActorModel *m;
+    Stg30ModelTint *t;
+
+    if (a == NULL) {
+        return;
+    }
+    w = (Stg30FighterWork *)a->work;
+    m = a->model;
+    if (m != NULL) {
+        if (m->screenXY != NULL) {
+            Mem_Free((ActorWork *)m->screenXY);
+        }
+        if (m->vertOtz != NULL) {
+            Mem_Free((ActorWork *)m->vertOtz);
+        }
+        if (m->vertColors != NULL) {
+            Mem_Free((ActorWork *)m->vertColors);
+        }
+        if (m->bones != NULL) {
+            Mem_Free((ActorWork *)m->bones);
+        }
+        Mem_Free((ActorWork *)m);
+        a->model = NULL;
+    }
+    a->digiId = digiId;
+    w->modelFile = Digi_GetModelFile(digiId);
+    Cd_GetFileSync(w->modelFile);
+    Cd_GetFileSync(Digi_GetAnimFile(digiId, 0));
+    t = (Stg30ModelTint *)Gfx_AttachModel(a, w->modelFile);
+    t->otIndex = 3;
+    t->flatR = t->flatG = t->flatB = 0x80;
+    t->clutRow = 0;
+    t->tpageBits = 0;
+    w->drawTex = 1;
+    w->drawWire = 0;
+    w->color.r = w->color.g = w->color.b = 0;
+    w->anim = -1;
+    if (Stg30_Battle.digis[slot].hp == 0) {
+        Stg30_FighterSetAnim(a, 0x64); /* stays down */
+    } else {
+        Stg30_FighterSetAnim(a, 0);
+    }
+}
+
+static s16 Stg30_EvoUp(s32 v) {
+    v += v * EVO_BOOST / 100;
+    return (s16)(v > 999 ? 999 : v);
+}
+
+static s16 Stg30_EvoDown(s32 v) {
+    v = v * 100 / (100 + EVO_BOOST);
+    return (s16)(v < 1 ? 1 : v);
+}
+
+static void Stg30_EvoBecome(s32 slot) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+    s32 t = Stg30_EvoTarget(slot);
+    s16 v;
+
+    if (t == 0) {
+        return;
+    }
+    e->fromId = d->digiId;
+    e->maxHp = d->maxHp;
+    e->maxMp = d->maxMp;
+    e->attack = Stg30_Battle.attackBase[slot];
+    e->defense = Stg30_Battle.defenseBase[slot];
+    e->speed = Stg30_Battle.speedBase[slot];
+    d->digiId = t;
+    v = Stg30_EvoUp(d->maxHp);
+    e->hpBonus = v - d->maxHp;
+    d->maxHp = v;
+    d->hp = d->hp + e->hpBonus > d->maxHp ? d->maxHp : d->hp + e->hpBonus;
+    v = Stg30_EvoUp(d->maxMp);
+    e->mpBonus = v - d->maxMp;
+    d->maxMp = v;
+    d->mp = d->mp + e->mpBonus > d->maxMp ? d->maxMp : d->mp + e->mpBonus;
+    Stg30_Battle.attackBase[slot] = Stg30_EvoUp(Stg30_Battle.attackBase[slot]);
+    Stg30_Battle.defenseBase[slot] = Stg30_EvoUp(Stg30_Battle.defenseBase[slot]);
+    Stg30_Battle.speedBase[slot] = Stg30_EvoUp(Stg30_Battle.speedBase[slot]);
+    Stg30_Battle.attackCur[slot] = Stg30_EvoUp(Stg30_Battle.attackCur[slot]);
+    Stg30_Battle.defenseCur[slot] = Stg30_EvoUp(Stg30_Battle.defenseCur[slot]);
+    Stg30_Battle.speedCur[slot] = Stg30_EvoUp(Stg30_Battle.speedCur[slot]);
+    d->attack = Stg30_Battle.attackCur[slot];
+    d->defense = Stg30_Battle.defenseCur[slot];
+    d->speed = Stg30_Battle.speedCur[slot];
+    e->energy = 0;
+    e->requested = 0;
+    e->turnsLeft = EVO_TURNS + 1; /* the round it digivolves in (it guards) ends first */
+    /* the new form's own technique (Digi_GetLearnedSkill, as the Digi-Lab gives it), for these
+     * turns only: in a free slot of its list, else in the last one */
+    e->skillSlot = -1;
+    {
+        s32 k = Digi_GetLearnedSkill(t);
+        s32 i;
+        s32 known = 0;
+
+        for (i = 0; i < 12; i++) {
+            known |= d->skills[i] == k;
+        }
+        if (k != 0 && !known) {
+            for (i = 0; i < 12 && d->skills[i] != 0; i++) {
+            }
+            e->skillSlot = i < 12 ? i : 11;
+            e->skillOld = d->skills[e->skillSlot];
+            d->skills[e->skillSlot] = (u8)k;
+        }
+    }
+    e->revert = 0;
+    Stg30_EvoHpSeen[slot] = d->hp;
+    printf("[evo] slot %d digivolves: %d -> %d\n", slot, e->fromId, t);
+}
+
+/* Back to the form it was: data only (the end of the battle calls this for every slot). */
+static void Stg30_EvoReturnData(s32 slot) {
+    Stg30Evo *e = &Stg30_Evo[slot];
+    DigiRosterEntry *d = &Stg30_Battle.digis[slot];
+
+    if (e->turnsLeft == 0 && !e->revert) {
+        return;
+    }
+    d->digiId = (u8)e->fromId;
+    d->maxHp = e->maxHp;
+    if (d->hp != 0) {
+        d->hp -= e->hpBonus;
+        if (d->hp < 1) {
+            d->hp = 1;
+        }
+        if (d->hp > d->maxHp) {
+            d->hp = d->maxHp;
+        }
+    }
+    if (e->skillSlot >= 0) {
+        d->skills[e->skillSlot] = (u8)e->skillOld; /* the new form's technique goes with it */
+        e->skillSlot = -1;
+    }
+    d->maxMp = e->maxMp;
+    d->mp -= e->mpBonus;
+    if (d->mp < 0) {
+        d->mp = 0;
+    }
+    if (d->mp > d->maxMp) {
+        d->mp = d->maxMp;
+    }
+    Stg30_Battle.attackBase[slot] = e->attack;
+    Stg30_Battle.defenseBase[slot] = e->defense;
+    Stg30_Battle.speedBase[slot] = e->speed;
+    Stg30_Battle.attackCur[slot] = Stg30_EvoDown(Stg30_Battle.attackCur[slot]);
+    Stg30_Battle.defenseCur[slot] = Stg30_EvoDown(Stg30_Battle.defenseCur[slot]);
+    Stg30_Battle.speedCur[slot] = Stg30_EvoDown(Stg30_Battle.speedCur[slot]);
+    d->attack = Stg30_Battle.attackCur[slot];
+    d->defense = Stg30_Battle.defenseCur[slot];
+    d->speed = Stg30_Battle.speedCur[slot];
+    e->turnsLeft = 0;
+    e->revert = 0;
+    e->energy = 0;
+    Stg30_EvoHpSeen[slot] = d->hp;
+    printf("[evo] slot %d returns to %d\n", slot, e->fromId);
+}
+
+/* The end of the battle: every digivolved form back at once (model too: the victory poses use the
+ * original's animations), before the party is written back. */
+static void Stg30_EvoReturnAll(void) {
+    s32 i;
+
+    if (Stg30_EvoFxSlot != NULL && *Stg30_EvoFxSlot != 0) {
+        Task_Destroy(Stg30_EvoFxSlot);
+    }
+    Stg30_EvoFxSlot = NULL;
+    Stg30_EvoSeqSlot = -1;
+    for (i = 0; i < 3; i++) {
+        if (Stg30_Evo[i].turnsLeft != 0 || Stg30_Evo[i].revert) {
+            Stg30_EvoReturnData(i);
+            Stg30_EvoSwapModel(i, Stg30_Battle.digis[i].digiId);
+        }
+        Stg30_Evo[i].requested = 0;
+    }
+}
+
+/* The end of a round (battle.c): count the digivolved forms' turns. */
+static void Stg30_EvoRoundEnd(void) {
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        Stg30Evo *e = &Stg30_Evo[i];
+
+        e->requested = 0;
+        if (e->turnsLeft != 0) {
+            if (--e->turnsLeft == 0 || Stg30_Battle.digis[i].hp == 0) {
+                e->turnsLeft = 1; /* still digivolved until the effect returns it */
+                e->revert = 1;
+            }
+        }
+    }
+}
+
+/* Runs the effect for one slot; 1 while it plays. */
+static s32 Stg30_EvoSequence(void) {
+    s32 slot = Stg30_EvoSeqSlot;
+    Actor *f = Stg30_EvoFighter(slot);
+    Stg30FighterWork *w;
+    Stg30EvoFxArgs args;
+    Actor *fx;
+
+    if (f == NULL) {
+        Stg30_EvoSeqSlot = -1;
+        return 0;
+    }
+    w = (Stg30FighterWork *)f->work;
+    if (Stg30_EvoSeqTimer == 0) {
+        Stg30_SetCameraShot(slot + 2);
+        Cd_GetFileSync(EVO_FX_MODEL);
+        Cd_GetFileSync(EVO_FX_ANIM);
+        args.modelFileId = EVO_FX_MODEL;
+        args.animFileId = EVO_FX_ANIM;
+        args.x = w->homeX;
+        args.y = w->homeY;
+        args.z = w->homeZ;
+        args.rotY = w->facing;
+        args.duration = EVO_FX_FRAMES;
+        Stg30_EvoFxSlot = &((s32 *)f->u34.children)[1];
+        Task_Create(7, Stg30_EvoFxSlot, (s32)(sptr)&args);
+        Stg30_EvoSeqSwapped = 0;
+        Snd_PlayById(0xA, 0);
+    }
+    Stg30_EvoSeqTimer++;
+    {
+        /* it spins, faster and faster up to the change, then slows to face the front again */
+        Stg30EvoXform *o = (Stg30EvoXform *)f->u38.ptr38;
+        s32 t = Stg30_EvoSeqTimer;
+        s32 v = t < EVO_SWAP_AT ? 0x24 + t * 9 : EVO_FX_FRAMES - t > 0 ? 0x24 + (EVO_FX_FRAMES - t) * 9 : 0x48;
+
+        if (o != NULL) {
+            if (t < EVO_FX_FRAMES || ((o->rotY - w->facing) & 0xFFF) > v) {
+                o->rotY = (s16)((o->rotY + v) & 0xFFF);
+                Stg30_EvoSeqSpinning = 1;
+            } else {
+                o->rotY = (s16)w->facing;
+                Stg30_EvoSeqSpinning = 0;
+            }
+        }
+    }
+    if (!Stg30_EvoSeqSwapped && Stg30_EvoSeqTimer >= EVO_SWAP_AT) {
+        Stg30_EvoSeqSwapped = 1;
+        if (Stg30_EvoSeqBack) {
+            Stg30_EvoReturnData(slot);
+        } else {
+            Stg30_EvoBecome(slot);
+        }
+        Stg30_EvoSwapModel(slot, Stg30_Battle.digis[slot].digiId);
+    }
+    fx = Stg30_EvoFxSlot != NULL ? (Actor *)P32(Actor, *Stg30_EvoFxSlot) : NULL;
+    if (Stg30_EvoSeqSpinning && Stg30_EvoSeqTimer < EVO_FX_FRAMES + 90) {
+        return 1; /* still turning back to the front */
+    }
+    if (Stg30_EvoSeqTimer < EVO_FX_FRAMES + 20 && (fx == NULL || fx->stateLevel0 != 3 ||
+                                                   Stg30_EvoSeqTimer < EVO_SWAP_AT + 20)) {
+        return 1;
+    }
+    {
+        Stg30EvoXform *o = (Stg30EvoXform *)f->u38.ptr38;
+
+        if (o != NULL) {
+            o->rotY = (s16)w->facing;
+        }
+    }
+    if (Stg30_EvoFxSlot != NULL && *Stg30_EvoFxSlot != 0) {
+        Task_Destroy(Stg30_EvoFxSlot);
+    }
+    Stg30_EvoFxSlot = NULL;
+    Stg30_SetCameraShot(1);
+    Stg30_EvoSeqSlot = -1;
+    return 0;
+}
+
+/* battle.c: phase 0 at the start of a round (returns), phase 1 after the commands (digivolves).
+ * 1 while an effect plays (the battle waits). */
+static s32 Stg30_EvoStep(s32 phase) {
+    s32 i;
+
+    if (Stg30_EvoSeqSlot >= 0 && Stg30_EvoSequence()) {
+        return 1;
+    }
+    for (i = 0; i < 3; i++) { /* the next one, if two or three digivolve at once */
+        Stg30Evo *e = &Stg30_Evo[i];
+
+        if (phase == 0 && e->revert) {
+            Stg30_EvoSeqBack = 1;
+        } else if (phase == 1 && e->requested && Stg30_Battle.turns[i].turnType == 5 &&
+                   Stg30_EvoCanDigivolve(i)) {
+            Stg30_EvoSeqBack = 0;
+        } else {
+            if (phase == 1) {
+                e->requested = 0;
+            }
+            continue;
+        }
+        e->requested = 0;
+        Stg30_EvoSeqSlot = i;
+        Stg30_EvoSeqTimer = 0;
+        return Stg30_EvoSequence();
+    }
+    return 0;
+}
+
+/* ---- the DP row (fighterhud.c) ---- */
+
+typedef struct {
+    GfxPartOTag tag;
+    u8 r, g, b, code;
+    s16 x, y;
+    u16 w, h;
+} Stg30EvoTile;
+
+static void Stg30_EvoTile(GfxPartOTag *ot, s32 x, s32 y, s32 w, s32 h, u32 rgb) {
+    Stg30EvoTile *p = (Stg30EvoTile *)Sys_State.packet.addr;
+    s32 sx = Sys_State.centerX.s == 0x140; /* as Gfx_DrawPartsEx: 640 wide, 480 high */
+    s32 sy = Sys_State.centerY.s == 0xF0;
+
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    x -= 160; /* 320 x 240 screen to centred coordinates */
+    y -= 120;
+    p->tag.len = 3;
+    p->code = 0x60; /* TILE */
+    p->r = rgb >> 16;
+    p->g = rgb >> 8;
+    p->b = rgb;
+    p->x = x << sx;
+    p->y = y << sy;
+    p->w = w << sx;
+    p->h = h << sy;
+    p->tag.addr = ot->addr;
+    ot->addr = (u32)(uptr)p;
+    Sys_State.packet.addr = (sptr)(p + 1);
+}
+
+s32 Stg30_EvoHudLift(void) {
+    return Stg30_EvoLift;
+}
+
+/* The party HUD box is one 96 x 49 sprite (013B entry 0x4A; layout 01A1 entries 0x23..0x25):
+ * the EL panel and the status panel on the left (columns 0..33), the HP / MP panel on the right
+ * (34..95), the name strip below (rows 31..48). The DP row makes it EVO_BOX_GROW rows taller:
+ * the right panel gets a third section like MP's (its gauge trough and the panel's shaded bottom,
+ * rows 18..30), the plain rows 11..17 going under the MP numbers instead; the left panel grows
+ * with plain rows from the EL panel (3..6) above its own shaded bottom (24..30); the name strip
+ * and the bottom edge move down. The whole box is raised by as much, so the name strip stays
+ * where it was. The DP gauge is the game's HP gauge drawn 26 rows lower, the label the HP
+ * label's P with a D drawn in its style. */
+#define EVO_BOX_FILE 0x013B004A
+#define EVO_GAUGE_FILE 0x013B001C
+#define EVO_DP_DY 26 /* HP section to DP section */
+
+typedef struct {
+    u8 dst;  /* first box row it is drawn at */
+    u8 src;  /* first sprite row */
+    u8 n;    /* rows */
+} Stg30EvoSlice;
+
+static const Stg30EvoSlice Stg30_EvoRight[] = { { 0, 0, 24 }, { 24, 11, 7 }, { 31, 18, 13 }, { 44, 31, 18 } };
+static const Stg30EvoSlice Stg30_EvoLeft[] = {
+    { 0, 0, 24 }, { 24, 3, 4 }, { 28, 3, 4 }, { 32, 3, 4 }, { 36, 3, 1 }, { 37, 24, 7 }, { 44, 31, 18 },
+};
+
+/* One textured quad from the box sprite: columns c0..c0+w, sprite rows src..src+n at box row dst. */
+static void Stg30_EvoBoxQuad(GfxPartOTag *ot, GfxPartCell *e, GfxPartTexSlot *t, s32 bx, s32 by, s32 c0, s32 w,
+                             const Stg30EvoSlice *sl) {
+    GfxPartPolyFT4 *p = (GfxPartPolyFT4 *)Sys_State.packet.addr;
+    s32 sx = Sys_State.centerX.s == 0x140;
+    s32 sy = Sys_State.centerY.s == 0xF0;
+    s32 x0 = bx + e->x + c0;
+    s32 y0 = by + e->y + sl->dst;
+    s32 u = e->u + t->u + c0;
+    s32 v = e->v + sl->src;
+    s32 i;
+
+    p->c.r = p->c.g = p->c.b = 0x80;
+    p->tag.len = 9;
+    p->c.code = 0x2C; /* POLY_FT4, as Gfx_DrawPartQuadsRot */
+    for (i = 0; i < 4; i++) {
+        p->v[i].x = (u16)((x0 + ((i & 1) ? w : 0)) << sx);
+        p->v[i].y = (u16)((y0 + ((i & 2) ? sl->n : 0)) << sy);
+        p->v[i].u = (u8)(u + ((i & 1) ? w : 0));
+        p->v[i].v = (u8)(v + ((i & 2) ? sl->n : 0));
+    }
+    if (p->v[1].u == 0) {
+        p->v[1].u = p->v[3].u = 0xFF;
+    }
+    p->v[0].extra = ((e->clutY + t->clutY + e->clutRow) << 6) | (((e->clutX + t->clutX) >> 4) & 0x3F);
+    p->v[1].extra = t->tpage;
+    p->tag.addr = ot->addr;
+    ot->addr = (u32)(uptr)p;
+    Sys_State.packet.addr = (sptr)(p + 1);
+}
+
+/* "D" and "P" in the HP label's 5 x 5 letters (the P is the label's own) */
+static const u8 Stg30_EvoGlyphs[2][5] = { { 0x1E, 0x11, 0x11, 0x11, 0x1E }, { 0x1E, 0x11, 0x11, 0x1E, 0x10 } };
+
+static s32 Stg30_EvoLit(s32 g, s32 i, s32 b) {
+    return i >= 0 && i < 5 && b >= 0 && b < 5 && (Stg30_EvoGlyphs[g][i] & (0x10 >> b));
+}
+
+static void Stg30_EvoLabel(GfxPartOTag *ot, s32 x, s32 y) {
+    s32 g;
+    s32 i;
+    s32 b;
+
+    /* drawn last = on top: the letters first, then their dark shadow one down and right */
+    for (g = 0; g < 2; g++) {
+        for (i = 0; i < 5; i++) {
+            for (b = 0; b < 5; b++) {
+                if (Stg30_EvoLit(g, i, b)) {
+                    Stg30_EvoTile(ot, x + g * 6 + b, y + i, 1, 1, 0x88C8C8);
+                }
+            }
+        }
+    }
+    for (g = 0; g < 2; g++) {
+        for (i = 0; i < 5; i++) {
+            for (b = 0; b < 5; b++) {
+                if (Stg30_EvoLit(g, i, b) && !Stg30_EvoLit(g, i + 1, b + 1)) {
+                    Stg30_EvoTile(ot, x + g * 6 + b + 1, y + i + 1, 1, 1, 0x000008);
+                }
+            }
+        }
+    }
+}
+
+/* The MP numbers' digit parts (013B 0x1F..0x24: max 0x80, current 0x100), and the "/" and a "%"
+ * in the digits' style: lit pixels in the label colour, each with its shadow down and right. */
+#define EVO_DIGITS_FIRST 0x013B001F
+#define EVO_DIGITS_LAST 0x013B0024
+#define EVO_PCT_DX 6
+static const u8 Stg30_EvoSlash[5] = { 0x2, 0x6, 0x4, 0xC, 0x8 };            /* the game's "/", 4 wide */
+static const u8 Stg30_EvoPercent[5] = { 0x19, 0x1A, 0x04, 0x0B, 0x13 };     /* 5 wide */
+
+static void Stg30_EvoGlyph(GfxPartOTag *ot, const u8 *rows, s32 w, s32 x, s32 y) {
+    s32 i;
+    s32 b;
+
+#define EVO_LIT(i, b) ((i) >= 0 && (i) < 5 && (b) >= 0 && (b) < w && (rows[i] & (1 << (w - 1 - (b)))))
+    for (i = 0; i < 5; i++) {
+        for (b = 0; b < w; b++) {
+            if (EVO_LIT(i, b)) {
+                Stg30_EvoTile(ot, x + b, y + i, 1, 1, 0x88C8C8);
+            }
+        }
+    }
+    for (i = 0; i < 5; i++) {
+        for (b = 0; b < w; b++) {
+            if (EVO_LIT(i, b) && !EVO_LIT(i + 1, b + 1)) {
+                Stg30_EvoTile(ot, x + b + 1, y + i + 1, 1, 1, 0x000008);
+            }
+        }
+    }
+#undef EVO_LIT
+}
+
+/* fighterhud.c, after it drew the (raised) parts with the box sprite hidden: the DP gauge and
+ * label, then the stretched box under everything. */
+void Stg30_EvoDrawBar(s32 slot, void *parts) {
+    static Stg30Part gauge[11]; /* the gauge's 4 parts and the percentage's 6 digits */
+    Stg30Evo *e;
+    Stg30Part *q;
+    Stg30Part *box = NULL;
+    GfxPartCell *cell;
+    GfxPartTexSlot *tex;
+    GfxPartOTag *ot;
+    s32 n = 0;
+    s32 pct;
+    s32 num;
+    s32 den;
+    s32 i;
+
+    if (Stg30_EvoLift == 0 || slot < 0 || slot >= 3 || parts == NULL) {
+        return;
+    }
+    e = &Stg30_Evo[slot];
+    for (q = (Stg30Part *)parts; q->fileId != 0; q++) {
+        if (q->fileId == EVO_BOX_FILE) {
+            box = q;
+        } else if (q->fileId == EVO_GAUGE_FILE && n < 10) {
+            gauge[n] = *q;
+            gauge[n].y += EVO_DP_DY;
+            n++;
+        } else if (q->fileId >= EVO_DIGITS_FIRST && q->fileId <= EVO_DIGITS_LAST && n < 10) {
+            /* the MP numbers' digits, one section lower and a little left (room for the %) */
+            gauge[n] = *q;
+            gauge[n].y += EVO_DP_DY - 13;
+            gauge[n].x -= EVO_PCT_DX;
+            n++;
+        }
+    }
+    if (box == NULL) {
+        return;
+    }
+    gauge[n].fileId = 0;
+    /* the gauge: energy; full and ready, it flashes; digivolved, the turns it has left */
+    if (e->turnsLeft != 0 || e->revert) {
+        num = e->revert ? 0 : e->turnsLeft > EVO_TURNS ? EVO_TURNS : e->turnsLeft;
+        den = EVO_TURNS;
+    } else {
+        num = Stg30_EvoTarget(slot) != 0 ? e->energy : 0;
+        den = EVO_MAX;
+        if (num >= EVO_MAX && Stg30_Battle.digis[slot].hp != 0 && ((Sys_State.frameCount >> 3) & 1)) {
+            num = 0;
+        }
+    }
+    Stg30_SetGaugeParts(gauge, 0x400, num, den);
+    /* under it, as MP's numbers: how full, "62/100%" (digivolved: the turns left, in %) */
+    pct = e->turnsLeft != 0 || e->revert ? (e->revert ? 0 : (e->turnsLeft > EVO_TURNS ? EVO_TURNS : e->turnsLeft) * 100 / EVO_TURNS)
+                                         : Stg30_EvoTarget(slot) != 0 ? e->energy * 100 / EVO_MAX : 0;
+    Gfx_SetPartsNumber((GfxPart *)gauge, 0x100, 3, pct);
+    Gfx_SetPartsNumber((GfxPart *)gauge, 0x80, 3, 100);
+    Gfx_DrawParts((s32)(sptr)gauge);
+    ot = (GfxPartOTag *)Sys_State.otLayers.addr[((u8 *)box)[0x0B]]; /* its otLayer (Rec1D6B4) */
+    cell = (GfxPartCell *)Cd_GetFileEntry(EVO_BOX_FILE);
+    /* the label where the HP label is, 26 rows lower (the label sprite: x -11, y -18) */
+    Stg30_EvoLabel(ot, 160 + box->x - 11, 120 + box->y - 18 + EVO_DP_DY);
+    /* the "/" between the numbers (the MP one's place, x 20) and a "%" after them */
+    Stg30_EvoGlyph(ot, Stg30_EvoSlash, 4, 160 + box->x + 20 - EVO_PCT_DX, 120 + box->y + EVO_DP_DY - 13);
+    Stg30_EvoGlyph(ot, Stg30_EvoPercent, 5, 160 + box->x + 37 + 6 - EVO_PCT_DX, 120 + box->y + EVO_DP_DY - 13);
+    tex = (GfxPartTexSlot *)Gfx_FindOrLoadTexSlot(EVO_BOX_FILE & 0xFFFF0000);
+    for (i = 0; i < (s32)(sizeof(Stg30_EvoRight) / sizeof(Stg30_EvoRight[0])); i++) {
+        Stg30_EvoBoxQuad(ot, cell, tex, box->x, box->y, 34, cell->w - 34, &Stg30_EvoRight[i]);
+    }
+    for (i = 0; i < (s32)(sizeof(Stg30_EvoLeft) / sizeof(Stg30_EvoLeft[0])); i++) {
+        Stg30_EvoBoxQuad(ot, cell, tex, box->x, box->y, 0, 34, &Stg30_EvoLeft[i]);
+    }
+}
