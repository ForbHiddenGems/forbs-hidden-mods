+    int fpview = Settings_Get(SET_FPVIEW);
+    bool fpceil = Settings_Get(SET_FPCEIL) != 0;
+    bool fpturn = Settings_Get(SET_FPSMOOTHTURN) != 0;
+    int mystery = Settings_Get(SET_FPMYSTERY);
+    bool rare = Settings_Get(SET_FPMYSTRARE) != 0;
+    bool boostChests = Settings_Get(SET_FPBOOSTCHEST) != 0;
+    bool boostBattles = Settings_Get(SET_FPBOOSTBATTLE) != 0;
+    bool battleEvo = Settings_Get(SET_FPBATTLEEVO) != 0;
+
+    ImGui::SeparatorText("Domains");
+    {
+        const char *views[] = { Host_FpViewName(0), Host_FpViewName(1), Host_FpViewName(2), Host_FpViewName(3) };
+
+        if (ImGui::Combo("Domain camera (F4)", &fpview, views, 4)) {
+            Host_RequestSetting(SET_FPVIEW, fpview);
+        }
+    }
+    ImGui::TextDisabled("F4 cycles the views; the camera moves smoothly between them. In the 3D");
+    ImGui::TextDisabled("views Up moves forward, Left / Right turn, Down turns around.");
+    if (ImGui::Checkbox("Ceilings in first person (F10)", &fpceil)) {
+        Host_RequestSetting(SET_FPCEIL, fpceil);
+    }
+    ImGui::TextDisabled("A roof with the floor's own texture over walled domains.");
+    if (ImGui::Checkbox("Smooth turning in 3D views", &fpturn)) {
+        Host_RequestSetting(SET_FPSMOOTHTURN, fpturn);
+    }
+    ImGui::TextDisabled("The camera and the Digi-Beetle ease round when turning (the game's own");
+    ImGui::TextDisabled("turns and timing stay the same). Off: they snap round as in the original.");
+    ImGui::SeparatorText("Mystery encounters");
+    {
+        /* listed in this order; the setting stores 0 off, 1 one per floor, 2 30 %, 3 all */
+        static const char *const names[] = { "1 per floor", "30% of encounters", "All except bosses", "Off" };
+        static const int values[] = { 1, 2, 3, 0 };
+        int pick = mystery == 0 ? 3 : mystery - 1;
+
+        if (ImGui::Combo("Mystery encounters", &pick, names, 4)) {
+            Host_RequestSetting(SET_FPMYSTERY, values[pick]);
+        }
+    }
+    ImGui::TextDisabled("Wandering Digimon shown as a ? until the battle starts (bosses never).");
+    if (ImGui::Checkbox("A ? holds a rarer Digimon", &rare)) {
+        Host_RequestSetting(SET_FPMYSTRARE, rare);
+    }
+    ImGui::TextDisabled("Swaps a ? for one of the floor's less common enemy groups, from that floor's");
+    ImGui::TextDisabled("own table and levels. Takes effect from the next floor you enter.");
+    ImGui::SeparatorText("LvlLimitBoostr");
+    ImGui::TextDisabled("Raises a party Digimon's level limit by 1 (at its limit, below 99).");
+    if (ImGui::Checkbox("1% of all chests", &boostChests)) {
+        Host_RequestSetting(SET_FPBOOSTCHEST, boostChests);
+    }
+    if (ImGui::Checkbox("1% of all ? encounters", &boostBattles)) {
+        Host_RequestSetting(SET_FPBOOSTBATTLE, boostBattles);
+    }
+    ImGui::SeparatorText("Battle digivolution");
+    if (ImGui::Checkbox("Digivolve in battle", &battleEvo)) {
+        Host_RequestSetting(SET_FPBATTLEEVO, battleEvo);
+    }
+    ImGui::TextDisabled("Your Digimon fill an energy bar by dealing and taking damage. Full, one can");
+    ImGui::TextDisabled("choose Digivolve and fight one level up for 3 turns. Tamer rank unlocks each step:");
+    ImGui::TextDisabled("Rookie to Champion at any rank, Champion to Ultimate at Pro (5),");
+    ImGui::TextDisabled("Ultimate to Mega at Commander (8).");
+    ImGui::SeparatorText("Model mods");
+    {
+        int n = Host_ModsCount();
+
+        if (n > 0) {
+            ImGui::Text("%d replacement file%s in use from the mods folder.", n, n == 1 ? "" : "s");
+        } else {
+            ImGui::TextDisabled("No model mods in use.");
+        }
+        ImGui::TextDisabled("Files in mods\\ next to dw2.exe replace the game's own (read at start).");
+    }
+}
