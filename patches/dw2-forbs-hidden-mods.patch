+++ b/include/stag3000/evo_native.h
@@ -0,0 +1,32 @@
+#ifndef STAG3000_EVO_NATIVE_H
+#define STAG3000_EVO_NATIVE_H
+
+/* Battle digivolution (Forbs Hidden Mods, native only; src/stag3000/evo_native.inc, built into
+ * battle.c). Each party Digimon has an energy bar that fills as it deals and takes damage. Full,
+ * a Rookie, Champion or Ultimate with a form one level up gets a third command, Digivolve (Rookie
+ * at any tamer rank, Champion from rank 5, Ultimate from rank 8): the Digi-Lab's digivolution
+ * effect plays on the battlefield and it fights as that form (model, animations, stronger stats)
+ * for 3 turns, then returns. The battle copy of the Digimon changes; the party in the save
+ * never does (it is reverted before the battle writes back). F1 > Forbs Hidden Mods toggles it. */
+
+#ifdef DW2_NATIVE
+
+#include "common.h"
+
+/* commandmenu.c / commandinput.c: slot 0..2 may digivolve now (shows the third command) */
+s32 Stg30_EvoCanDigivolve(s32 slot);
+/* commandinput.c: the Digimon in `slot` chose Digivolve (1) or the choice was taken back (0) */
+void Stg30_EvoRequest(s32 slot, s32 on);
+/* commandmenu.c: the command's text, glyphs, 0xFF ended */
+extern u8 Stg30_EvoCommandText[];
+/* fighterhud.c: the DP row of party slot 0..2 (its HUD parts `parts`, already raised and drawn
+ * with the box sprite hidden): the DP gauge and label, then the box stretched to hold them; and
+ * how far the party HUD is raised for it (0: off this battle) */
+void Stg30_EvoDrawBar(s32 slot, void *parts);
+s32 Stg30_EvoHudLift(void);
+/* host/devedit.c (F2, in battle): fill the DP gauge of every party Digimon that can digivolve;
+ * -> how many */
+s32 Stg30_EvoDevFill(void);
+
+#endif
+#endif
diff --git a/include/stag4000/fpview.h b/include/stag4000/fpview.h
new file mode 100644
index 0000000..a719d78
--- /dev/null
+++ b/include/stag4000/fpview.h
@@ -0,0 +1,71 @@
+#ifndef STAG4000_FPVIEW_H
+#define STAG4000_FPVIEW_H
+
+/* FP: 3D views in the domains (native build only, F4 cycles classic / high chase / low chase /
+ * first person, settings "domain_view"), moving smoothly between them.
+ *
+ * The camera sits in the Digi-Beetle and looks along its facing; the floor and its walls are
+ * drawn by Stg40_FpDrawFloor (floor.c) instead of the retail 9x9 window: cells all around the
+ * beetle out to STG40_FP_RADIUS, clipped against the near plane and the screen guard band in
+ * world space before the GTE projects them, so nothing behind the camera reaches the GTE, and
+ * faded to black with distance. Tiles are made square in this view (z * 40 like x, retail
+ * z * 32): entity positions go through Stg40_FpWorldX / Stg40_FpWorldZ for that.
+ *
+ * Presentation only: game state, turns, RNG and the retail window logic run as before. The
+ * pad mapping in Stg40_PlayerTryMove becomes relative to the facing (Up forward, Left / Right
+ * turn 90 degrees, Down turns around, Up + Left / Right steps diagonally). */
+
+#ifdef DW2_NATIVE
+
+#define STG40_FP_RADIUS 8 /* tiles drawn around the beetle */
+
+/* A 3D view or a transition is up (F4 cycles classic, high chase, low chase, first person):
+ * this file's renderer draws the floor, the classic one stays retail. */
+s32 Stg40_FpActive(void);
+/* World x / z (s16 range) of a map position for models: player-centred and square in FP,
+ * the retail view-centred values otherwise. */
+s32 Stg40_FpWorldX(s32 posX);
+s32 Stg40_FpWorldZ(s32 posY);
+/* A map position too far from the player for s16 world coordinates in FP. */
+s32 Stg40_FpOutOfRange(s32 posX, s32 posY);
+/* The entity / actor is the player, hidden while the camera is at its eye. */
+s32 Stg40_FpHidesEnt(void *ent);
+s32 Stg40_FpHidesActor(void *actor);
+/* The rotation to draw an entity with (the beetle eases round with smooth turning). */
+s32 Stg40_FpDrawHeading(void *ent, s32 rot);
+/* The texture animation of a hidden model (sets the texture slot the draw would set). */
+void Stg40_FpAnimateHiddenTex(void *actor);
+/* The pad as an absolute octant 0..7 for Stg40_PlayerTryMove, or -1 = no step this frame
+ * (turns in place are applied to the entity here). */
+s32 Stg40_FpPadOctant(void *ent);
+/* camera.c, after the retail GsSetRefView2: reads the retail camera back, moves the
+ * transition on and sets this frame's camera when a 3D view or a transition is up. */
+void Stg40_FpCameraTick(void *cameraWork);
+/* Turn-and-move controls (every view but classic, switching when a transition ends). */
+s32 Stg40_FpRelative(void);
+/* floor.c */
+void Stg40_FpDrawFloor(void *floorWork);
+void Stg40_FpDrawShadow(void *loc);
+void Stg40_FpReset(void);
+/* automap.c: the view's facing as an arrow over the beetle on an automap window (before
+ * Stg40_AutomapDrawWindow with the same x, y, cx, cy, scale; fade 0..0xFF). */
+void Stg40_FpDrawMapArrow(s32 x, s32 y, s32 cx, s32 cy, s32 scale, s32 fade);
+/* Mystery encounters: spawn.c notes each enemy party (boss flag, its pick, a roll), then the
+ * floor's one is picked and (rarer sets on) each ? party swapped for a rarer set of the
+ * floor; Stg40_FpMystery says whether an entity shows as a ? (the F1 setting); the ? itself. */
+void Stg40_FpNoteParty(s32 index, s32 boss, s32 pick);
+void Stg40_FpRollMystery(void);
+s32 Stg40_FpMystery(void *ent);
+void Stg40_FpDrawMystery(void *loc);
+/* LvlLimitBoostr: the pick-a-Digimon prompt (a player state's stateLevel2 from 10: 0 running,
+ * 1 used, 2 None), the battle and chest routes. */
+s32 Stg40_FpBoostPrompt(void *actor, s32 chest);
+void Stg40_FpNoteBattle(void *ent);
+s32 Stg40_FpBattleBoostDue(void);
+void Stg40_FpRollChestBoost(void);
+s32 Stg40_FpChestHasBoost(void *rec);
+void Stg40_FpChestBoostTaken(void *rec);
+
+#endif
+
+#endif /* STAG4000_FPVIEW_H */
