diff --git a/src/stag4000/fpview_math.inc b/src/stag4000/fpview_math.inc
new file mode 100644
index 0000000..da7c565
--- /dev/null
+++ b/src/stag4000/fpview_math.inc
@@ -0,0 +1,383 @@
+/* FP: the pure geometry of the 3D domain views (no game state, no GTE): tuning, camera poses
+ * and their blending, world -> camera, clipping against the near plane and the guard band,
+ * fog and the retail wall cull.
+ * Included by fpview_native.inc, and by a standalone preview renderer, so both run this
+ * same code. Needs s32 / u8 and <math.h>. */
+
+#ifndef STG40_FP_RADIUS
+#define STG40_FP_RADIUS 8
+#endif
+
+#define FP_TILE 0xA00           /* tile size in world units (x; z too in this view) */
+#define FP_HALF 0x500           /* half a tile */
+#define FP_EYE 0x2A0            /* eye height above the floor (walls are 0x500) */
+#define FP_PITCH 0x0C0          /* look down a little: reference point drop per 0x1000 ahead */
+#define FP_H 384                /* projection (GTE units, before the game's halving): ~80 deg */
+#define FP_NEAR 0x100           /* near plane, camera z */
+#define FP_GUARD 1.45f          /* clip guard band: x / y beyond the screen edge by this factor */
+#define FP_FOG_START (FP_TILE * 2.5f)          /* first person: fog from 2.5 tiles */
+#define FP_FOG_START_CHASE (FP_TILE * 4.5f)    /* chase views: fog from 4.5 tiles */
+#define FP_FOG_END (FP_TILE * (STG40_FP_RADIUS - 0.5f))
+#define FP_WALL 0x500           /* wall height */
+#define FP_HIDE_DIST 0xA00      /* the beetle is hidden while the eye is within a tile of it
+                                 * (sideways), so a camera moving in never passes through it */
+#define FP_BLEND_FRAMES 26      /* camera transition length in game frames (30 a second) */
+/* camera presets: pivot height above the floor, distance back from the pivot, pitch in
+ * degrees below the horizon, projection */
+#define FP_HIGH_PIVOT 0x300
+#define FP_HIGH_DIST 0x3800
+#define FP_HIGH_PITCH 50.0f
+#define FP_HIGH_H 420
+#define FP_LOW_PIVOT 0x380
+#define FP_LOW_DIST 0x1600
+#define FP_LOW_PITCH 18.0f
+#define FP_LOW_H 384
+#define FP_FLOOR_BIAS 96        /* OT entries a floor sorts behind its centre (entities on it) */
+#define FP_SHADOW_BIAS (FP_FLOOR_BIAS - 6)
+#define FP_MAP_ARROW 1.0f       /* minimap pointer size: 1.0 = 0.8 of a tile long */
+#define FP_CEILING_SHADE 0x58   /* ceilings a little darker than the floor (0x7F) */
+#define FP_TURN_STEP 0x100      /* camera yaw per frame (as the beetle turns) */
+#define FP_TURN_EASE 0.2f       /* smooth turning: share of the way left covered per frame */
+#define FP_TURN_SNAP 6          /* smooth turning: closer than this (of 0x1000) it lands */
+#define FP_PACKET_BYTES 0x40000 /* the floor's own packet area per frame buffer */
+#define FP_MYSTERY_PCT 30       /* mystery encounters, "30 %" setting */
+#define FP_MYSTERY_PIX 0x140    /* one pixel of the ? glyph, world units (it is 7 tall) */
+#define FP_MYSTERY_HEIGHT 0x700 /* the ? floats this high (its middle) */
+#define FP_MAXV 12              /* vertices of a clipped polygon (4 + 5 planes, rounded up) */
+
+typedef struct {
+    float w[3]; /* world (FP origin) */
+    float c[3]; /* camera space */
+    float u, v; /* texel */
+    float shade;
+} Stg40FpVert;
+
+typedef struct {
+    float m[3][3]; /* GsWSMATRIX rotation (1.0 = 0x1000) */
+    float t[3];
+    float gx;      /* guard band, GTE units */
+    float gy;
+    float H;       /* projection */
+    float fog;     /* 0 none .. 1 full */
+    float fogStart; /* horizontal distance from the beetle where the fade starts */
+} Stg40FpView;
+
+/* A camera, as a pivot over the beetle (offset offX / offZ in world units, pivotH above the
+ * floor) and the eye dist back from it along the view direction; yaw in the heading
+ * convention (heading a looks along map (-sin a, cos a), world (-sin a, -cos a)), pitch down
+ * from the horizon, both in radians; H the projection; q the depth of a tile row against its
+ * width (the retail overhead view squashes rows to 0.8, the 3D views use 1); fog 0..1 and
+ * where it starts. */
+typedef struct {
+    float offX;
+    float offZ;
+    float pivotH;
+    float dist;
+    float yaw;
+    float pitch;
+    float H;
+    float q;
+    float fog;
+    float fogStart;
+} Stg40FpPose;
+
+#define FP_PI 3.14159265358979323846f
+
+/* The eye and the unit view direction of a pose (world: y down, floor at 0). */
+static void Stg40_FpPoseEye(const Stg40FpPose *p, float eye[3], float fwd[3]) {
+    float cp = cosf(p->pitch);
+
+    fwd[0] = -sinf(p->yaw) * cp;
+    fwd[1] = sinf(p->pitch);
+    fwd[2] = -cosf(p->yaw) * cp;
+    eye[0] = p->offX - fwd[0] * p->dist;
+    eye[1] = -p->pivotH - fwd[1] * p->dist;
+    eye[2] = p->offZ - fwd[2] * p->dist;
+}
+
+/* A pose from a world-to-camera matrix (rows: camera x, y, z axes in world, row 1 scaled by
+ * the aspect factor GsSetRefView2 puts in) and its translation: the eye solves m e = -t (the
+ * rows are orthogonal), the pivot is where the view ray meets the floor. */
+static void Stg40_FpPoseFromMatrix(const float m[3][3], const float t[3], float H, Stg40FpPose *p) {
+    float eye[3];
+    float f[3];
+    float n;
+    float s;
+    s32 i;
+    s32 j;
+
+    for (j = 0; j < 3; j++) {
+        eye[j] = 0.0f;
+    }
+    for (i = 0; i < 3; i++) {
+        n = m[i][0] * m[i][0] + m[i][1] * m[i][1] + m[i][2] * m[i][2];
+        if (n <= 0.0f) {
+            continue;
+        }
+        for (j = 0; j < 3; j++) {
+            eye[j] -= m[i][j] * t[i] / n;
+        }
+    }
+    n = sqrtf(m[2][0] * m[2][0] + m[2][1] * m[2][1] + m[2][2] * m[2][2]);
+    for (j = 0; j < 3; j++) {
+        f[j] = n > 0.0f ? m[2][j] / n : 0.0f;
+    }
+    p->yaw = atan2f(-f[0], -f[2]);
+    p->pitch = atan2f(f[1], sqrtf(f[0] * f[0] + f[2] * f[2]));
+    s = (f[1] > 0.05f && eye[1] < 0.0f) ? -eye[1] / f[1] : 0x2000; /* along the ray to the floor */
+    p->dist = s;
+    p->offX = eye[0] + f[0] * s;
+    p->offZ = eye[2] + f[2] * s;
+    p->pivotH = -(eye[1] + f[1] * s);
+    p->H = H;
+    p->q = 0.8f;
+    p->fog = 0.0f;
+    p->fogStart = FP_FOG_START_CHASE;
+}
+
+static float Stg40_FpEase(float t) {
+    t = t < 0.0f ? 0.0f : t > 1.0f ? 1.0f : t;
+    return t * t * (3.0f - 2.0f * t);
+}
+
+/* a to b at t (0..1, eased by the caller); the yaw the shorter way round. */
+static void Stg40_FpPoseBlend(const Stg40FpPose *a, const Stg40FpPose *b, float t, Stg40FpPose *o) {
+    float dy = b->yaw - a->yaw;
+
+    while (dy > FP_PI) {
+        dy -= 2.0f * FP_PI;
+    }
+    while (dy < -FP_PI) {
+        dy += 2.0f * FP_PI;
+    }
+#define FP_LERP(f) o->f = a->f + (b->f - a->f) * t
+    FP_LERP(offX);
+    FP_LERP(offZ);
+    FP_LERP(pivotH);
+    FP_LERP(dist);
+    FP_LERP(pitch);
+    FP_LERP(H);
+    FP_LERP(q);
+    FP_LERP(fog);
+    FP_LERP(fogStart);
+#undef FP_LERP
+    o->yaw = a->yaw + dy * t;
+}
+
+static void Stg40_FpToCamera(const Stg40FpView *c, Stg40FpVert *v) {
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        v->c[i] = c->t[i] + (c->m[i][0] * v->w[0] + c->m[i][1] * v->w[1] + c->m[i][2] * v->w[2]);
+    }
+}
+
+/* Distance of a camera-space point inside plane k (>= 0 inside). */
+static float Stg40_FpPlane(const Stg40FpView *c, const float *p, s32 k) {
+    switch (k) {
+    case 0:
+        return p[2] - FP_NEAR;
+    case 1:
+        return c->H * p[0] + c->gx * p[2];
+    case 2:
+        return c->gx * p[2] - c->H * p[0];
+    case 3:
+        return c->H * p[1] + c->gy * p[2];
+    default:
+        return c->gy * p[2] - c->H * p[1];
+    }
+}
+
+static void Stg40_FpLerp(Stg40FpVert *o, const Stg40FpVert *a, const Stg40FpVert *b, float t) {
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        o->w[i] = a->w[i] + (b->w[i] - a->w[i]) * t;
+        o->c[i] = a->c[i] + (b->c[i] - a->c[i]) * t;
+    }
+    o->u = a->u + (b->u - a->u) * t;
+    o->v = a->v + (b->v - a->v) * t;
+    o->shade = a->shade + (b->shade - a->shade) * t;
+}
+
+/* Sutherland-Hodgman against the near plane and the guard band. */
+static s32 Stg40_FpClip(const Stg40FpView *c, Stg40FpVert *v, s32 n) {
+    Stg40FpVert tmp[FP_MAXV];
+    float d[FP_MAXV];
+    s32 k;
+    s32 i;
+    s32 m;
+    s32 j;
+
+    for (k = 0; k < 5 && n >= 3; k++) {
+        s32 in = 0;
+
+        for (i = 0; i < n; i++) {
+            d[i] = Stg40_FpPlane(c, v[i].c, k);
+            in += d[i] >= 0.0f;
+        }
+        if (in == n) {
+            continue;
+        }
+        if (in == 0) {
+            return 0;
+        }
+        m = 0;
+        for (i = 0; i < n; i++) {
+            j = (i + 1) % n;
+            if (d[i] >= 0.0f && m < FP_MAXV) {
+                tmp[m++] = v[i];
+            }
+            if ((d[i] >= 0.0f) != (d[j] >= 0.0f) && m < FP_MAXV) {
+                Stg40_FpLerp(&tmp[m++], &v[i], &v[j], d[i] / (d[i] - d[j]));
+            }
+        }
+        for (i = 0; i < m; i++) {
+            v[i] = tmp[i];
+        }
+        n = m;
+    }
+    return n >= 3 ? n : 0;
+}
+
+static u8 Stg40_FpByte(float f) {
+    s32 i = (s32)lrintf(f);
+
+    return (u8)(i < 0 ? 0 : i > 255 ? 255 : i);
+}
+
+/* Brightness 0..1 of a world point by its horizontal distance from the beetle (the origin). */
+static float Stg40_FpFog(const Stg40FpView *c, const float *w) {
+    float d = sqrtf(w[0] * w[0] + w[2] * w[2]);
+    float f = (FP_FOG_END - d) / (FP_FOG_END - c->fogStart);
+
+    f = f < 0.0f ? 0.0f : f > 1.0f ? 1.0f : f;
+    return 1.0f - c->fog * (1.0f - f);
+}
+
+/* A quad in packet corner order (P0 P1 / P2 P3, as POLY_FT4) with its four texels uv[k],
+ * into v[] as a clipped convex polygon (loop P0 P1 P3 P2), shade faded by distance. Returns
+ * the vertex count, 0 = nothing to draw. cull: keep only the side retail Stg40_DrawTileWalls
+ * draws: it culls when cross(b0 - a0, b1 - a0) > 0 on screen, a negative area of the loop
+ * a1 b1 b0 a0 (= P0 P1 P3 P2). */
+static s32 Stg40_FpPrepQuad(const Stg40FpView *c, const float p[4][3], const float uv[4][2], s32 shade, s32 cull,
+                            Stg40FpVert *v) {
+    static const u8 loop[4] = { 0, 1, 3, 2 };
+    float area;
+    s32 n;
+    s32 i;
+    s32 k;
+
+    for (i = 0; i < 4; i++) {
+        k = loop[i];
+        v[i].w[0] = p[k][0];
+        v[i].w[1] = p[k][1];
+        v[i].w[2] = p[k][2];
+        v[i].u = uv[k][0];
+        v[i].v = uv[k][1];
+        Stg40_FpToCamera(c, &v[i]);
+        v[i].shade = shade * Stg40_FpFog(c, v[i].w);
+    }
+    n = Stg40_FpClip(c, v, 4);
+    if (n == 0 || !cull) {
+        return n;
+    }
+    area = 0.0f;
+    for (i = 0; i < n; i++) {
+        k = (i + 1) % n;
+        area += (v[i].c[0] / v[i].c[2]) * (v[k].c[1] / v[k].c[2]) -
+                (v[k].c[0] / v[k].c[2]) * (v[i].c[1] / v[i].c[2]);
+    }
+    return area < 0.0f ? 0 : n;
+}
+
+/* Floor template index of a map cell from its flags and its Rand_GetAt value, as
+ * Stg40_FillTileCache picks it. */
+static s32 Stg40_FpCellPrimFrom(u16 flags, u16 r) {
+    s32 k = flags & 0xF;
+    s32 a;
+
+    switch (k) {
+    case 0:
+        return 0;
+    case 1:
+    case 2:
+        a = k == 1 ? 0x18 : 0;
+        a += (flags >> 9) & 1;
+        if (flags & 0x80) {
+            a += 2;
+        }
+        if (flags & 0x800) {
+            a += 4;
+        }
+        if (r < 0x200) {
+            a += 8;
+        }
+        if (r < 0x400) {
+            a += 8;
+        }
+        if (r < 0x400) {
+            a |= 0x80;
+        }
+        return a;
+    default:
+        a = k + 0x2D;
+        if (r < 0x400) {
+            a |= 0x80;
+        }
+        return a;
+    }
+}
+
+/* Ring order around (pc, pr): ring 0 is the centre, ring r has 8r cells. */
+static void Stg40_FpRingCell(s32 pc, s32 pr, s32 ring, s32 i, s32 *col, s32 *row) {
+    if (ring == 0) {
+        *col = pc;
+        *row = pr;
+    } else if (i < 2 * ring) {
+        *col = pc - ring + i;
+        *row = pr - ring;
+    } else if (i < 4 * ring) {
+        *col = pc + ring;
+        *row = pr - ring + (i - 2 * ring);
+    } else if (i < 6 * ring) {
+        *col = pc + ring - (i - 4 * ring);
+        *row = pr + ring;
+    } else {
+        *col = pc - ring;
+        *row = pr + ring - (i - 6 * ring);
+    }
+}
+
+/* Subdivision of the quads: big polygons near the eye warp their textures when the PS1 maps
+ * them affine, so without precise (perspective-correct) geometry every floor is cut 2 x 2 and
+ * every wall 2 x 1 (pieces 0x500 square). One level for all cells: shared edges then split
+ * alike, so no T-junction opens a crack. With precise geometry (no wobble or smooth frames)
+ * the renderer corrects perspective itself and nothing is cut. */
+static s32 Stg40_FpSubdiv(s32 precise) {
+    return precise ? 1 : 2;
+}
+
+/* Piece (i, j) of nu x nv of a quad in packet corner order (P0 P1 / P2 P3), positions and
+ * texels interpolated bilinearly; i runs P0 -> P1, j runs P0 -> P2. */
+static void Stg40_FpSubQuad(const float p[4][3], const float uv[4][2], s32 i, s32 j, s32 nu, s32 nv, float sp[4][3],
+                            float suv[4][2]) {
+    s32 k;
+    s32 a;
+
+    for (k = 0; k < 4; k++) {
+        float s = (float)(i + (k & 1)) / nu;
+        float t = (float)(j + (k >> 1)) / nv;
+        float w0 = (1 - s) * (1 - t);
+        float w1 = s * (1 - t);
+        float w2 = (1 - s) * t;
+        float w3 = s * t;
+
+        for (a = 0; a < 3; a++) {
+            sp[k][a] = w0 * p[0][a] + w1 * p[1][a] + w2 * p[2][a] + w3 * p[3][a];
+        }
+        for (a = 0; a < 2; a++) {
+            suv[k][a] = w0 * uv[0][a] + w1 * uv[1][a] + w2 * uv[2][a] + w3 * uv[3][a];
+        }
+    }
+}
diff --git a/src/stag4000/fpview_native.inc b/src/stag4000/fpview_native.inc
new file mode 100644
index 0000000..81feb69
--- /dev/null
+++ b/src/stag4000/fpview_native.inc
@@ -0,0 +1,1607 @@
+/* FP: the 3D domain views (native build only): high chase, low chase, first person, and the
+ * camera moves between them and the classic view. Included by floor.c inside
+ * #ifdef DW2_NATIVE, so the matching PS1 build never sees it (and no build globs a .inc).
+ * Overview in include/stag4000/fpview.h; the pure geometry is in fpview_math.inc. */
+
+#include <math.h>
+#include <string.h>
+#include "stag4000/fpview.h"
+#include "fpview_math.inc"
+
+extern void Gfx_AnimateModelTex(Actor *a0);
+
+/* The floor's own packets, one area per frame buffer: a static array lies in the exe image,
+ * in the 16 MB window the 24-bit OT links reach (psyq/ps1mem.h), so the floor never takes
+ * room the game's models need in its packet buffer. */
+static u32 Stg40_FpPkt[2][FP_PACKET_BYTES / 4];
+static s32 Stg40_FpPktUsed;  /* bytes used in the area of Stg40_FpPktBuf this frame */
+static s32 Stg40_FpPktBuf = -1;
+static s32 Stg40_FpPktFrame;
+
+/* ---- state ------------------------------------------------------------------------------- */
+
+/* The view the host asks for (F4): 0 classic (the retail renderer), 1 high chase, 2 low chase,
+ * 3 first person. Any other view, and every transition, draws with this file's renderer. */
+enum { FP_VIEW_CLASSIC, FP_VIEW_HIGH, FP_VIEW_LOW, FP_VIEW_FIRST, FP_VIEW_COUNT };
+
+static s32 Stg40_FpSynced;  /* facing / yaw taken from the beetle */
+static void *Stg40_FpEnt;   /* the entity they were taken from */
+static s32 Stg40_FpFacing;  /* octant the view faces, 0..7 (retail octants: 0 down, 2 left ...) */
+static s32 Stg40_FpYaw;     /* camera yaw, 0..0xFFF, chases Stg40_FpFacing << 9 */
+static s32 Stg40_FpBodyYaw; /* the beetle's drawn rotation, 0..0xFFF (smooth turning) */
+
+static s32 Stg40_FpInit;    /* the state below is set up for this dungeon visit */
+static s32 Stg40_FpTo;      /* the view shown, or being moved to */
+static s32 Stg40_FpCtrl;    /* turn-and-move controls (switch when a transition ends) */
+static float Stg40_FpT;     /* transition 0..1 (1 = done) */
+static Stg40FpPose Stg40_FpFrom; /* where the transition started */
+static Stg40FpPose Stg40_FpCur;  /* the camera of this frame */
+static Stg40FpPose Stg40_FpClassic; /* the retail camera, read back each frame */
+static s32 Stg40_FpClassicOk;
+static float Stg40_FpEyeH;  /* eye height above the floor this frame */
+static float Stg40_FpEyeXZ; /* eye distance from the beetle across the floor this frame */
+
+/* The dungeon is rebuilt (a new floor, back from a battle, a menu): the camera snaps to the
+ * chosen view at its next use; no transition carries over. */
+void Stg40_FpReset(void) {
+    Stg40_FpSynced = 0;
+    Stg40_FpEnt = NULL;
+    Stg40_FpInit = 0;
+    Stg40_FpClassicOk = 0;
+}
+
+static s32 Stg40_FpReady(void) {
+    return Stg40_RootState != NULL && Stg40_RootState->playerEnt != NULL && Dung_StatePtr != NULL &&
+           Dung_StatePtr->floorHdr != NULL && Stg40_FloorWork != NULL;
+}
+
+static void Stg40_FpSync(Stg40Ent48 *e) {
+    if (Stg40_FpSynced && Stg40_FpEnt == e) {
+        return;
+    }
+    Stg40_FpFacing = ((u16)e->targetHeading >> 9) & 7;
+    Stg40_FpYaw = Stg40_FpFacing << 9;
+    Stg40_FpEnt = e;
+    Stg40_FpSynced = 1;
+}
+
+/* The camera of view `mode` this frame. */
+static void Stg40_FpLivePose(s32 mode, Stg40FpPose *p) {
+    float h = (float)Stg40_RootState->playerEnt->loc.height;
+
+    if (mode == FP_VIEW_CLASSIC) {
+        if (Stg40_FpClassicOk) {
+            *p = Stg40_FpClassic;
+        } else {
+            /* not read back yet (the first frame): a steep overhead stand-in */
+            p->offX = 0.0f;
+            p->offZ = 0.0f;
+            p->pivotH = 0.0f;
+            p->dist = 0x5000;
+            p->yaw = 0.0f;
+            p->pitch = 62.0f * FP_PI / 180.0f;
+            p->H = 512;
+            p->q = 0.8f;
+            p->fog = 0.0f;
+            p->fogStart = FP_FOG_START_CHASE;
+        }
+        return;
+    }
+    p->offX = 0.0f;
+    p->offZ = 0.0f;
+    p->yaw = Stg40_FpYaw * (2.0f * FP_PI / 4096.0f);
+    p->q = 1.0f;
+    p->fog = 1.0f;
+    p->fogStart = FP_FOG_START_CHASE;
+    switch (mode) {
+    case FP_VIEW_HIGH:
+        p->pivotH = FP_HIGH_PIVOT + h;
+        p->dist = FP_HIGH_DIST;
+        p->pitch = FP_HIGH_PITCH * FP_PI / 180.0f;
+        p->H = FP_HIGH_H;
+        break;
+    case FP_VIEW_LOW:
+        p->pivotH = FP_LOW_PIVOT + h;
+        p->dist = FP_LOW_DIST;
+        p->pitch = FP_LOW_PITCH * FP_PI / 180.0f;
+        p->H = FP_LOW_H;
+        break;
+    default:
+        p->pivotH = FP_EYE + h;
+        p->dist = 0.0f;
+        p->pitch = atan2f((float)FP_PITCH, 4096.0f);
+        p->H = FP_H;
+        p->fogStart = FP_FOG_START;
+        break;
+    }
+}
+
+/* Follows the host's view: set up on first use, a new transition when F4 picks another. */
+static s32 Stg40_FpPoll(void) {
+    s32 mode;
+
+    if (!Stg40_FpReady()) {
+        return 0;
+    }
+    mode = Host_FpView();
+    if (mode < 0 || mode >= FP_VIEW_COUNT) {
+        mode = FP_VIEW_CLASSIC;
+    }
+    if (!Stg40_FpInit) {
+        Stg40_FpInit = 1;
+        Stg40_FpTo = mode;
+        Stg40_FpT = 1.0f;
+        Stg40_FpCtrl = mode != FP_VIEW_CLASSIC;
+        Stg40_FpSync(Stg40_RootState->playerEnt);
+        Stg40_FpBodyYaw = (u16)Stg40_RootState->playerEnt->heading & 0xFFF;
+        Stg40_FpLivePose(mode, &Stg40_FpCur);
+        {
+            float eye[3];
+            float f[3];
+
+            Stg40_FpPoseEye(&Stg40_FpCur, eye, f);
+            Stg40_FpEyeH = -eye[1];
+            Stg40_FpEyeXZ = sqrtf(eye[0] * eye[0] + eye[2] * eye[2]);
+        }
+    } else if (mode != Stg40_FpTo) {
+        Stg40_FpFrom = Stg40_FpCur;
+        Stg40_FpTo = mode;
+        Stg40_FpT = 0.0f;
+    }
+    return 1;
+}
+
+s32 Stg40_FpActive(void) {
+    if (!Stg40_FpPoll()) {
+        return 0;
+    }
+    return Stg40_FpTo != FP_VIEW_CLASSIC || Stg40_FpT < 1.0f;
+}
+
+s32 Stg40_FpRelative(void) {
+    return Stg40_FpPoll() && Stg40_FpCtrl;
+}
+
+/* The origin of the 3D world: the player's (moving) map position. */
+static s32 Stg40_FpOriginX(void) {
+    return Stg40_RootState->playerEnt->loc.posX;
+}
+
+static s32 Stg40_FpOriginY(void) {
+    return Stg40_RootState->playerEnt->loc.posY;
+}
+
+s32 Stg40_FpWorldX(s32 posX) {
+    if (!Stg40_FpActive()) {
+        return (s16)((posX - Stg40_RootState->viewX) * 40);
+    }
+    return (s16)((posX - Stg40_FpOriginX()) * 40);
+}
+
+s32 Stg40_FpWorldZ(s32 posY) {
+    if (!Stg40_FpActive()) {
+        return (s16)-(((posY - Stg40_RootState->viewY) << 11) / 64);
+    }
+    return (s16)lrintf(-(posY - Stg40_FpOriginY()) * 40.0f * Stg40_FpCur.q);
+}
+
+s32 Stg40_FpOutOfRange(s32 posX, s32 posY) {
+    s32 dx;
+    s32 dy;
+
+    if (!Stg40_FpActive()) {
+        return 0;
+    }
+    dx = posX - Stg40_FpOriginX();
+    dy = posY - Stg40_FpOriginY();
+    return dx < -12 * 64 || dx > 12 * 64 || dy < -12 * 64 || dy > 12 * 64;
+}
+
+/* The eye is at (or close to) the beetle: first person, or a camera moving into it. */
+static s32 Stg40_FpInBeetle(void) {
+    return Stg40_FpActive() && Stg40_FpEyeXZ < FP_HIDE_DIST;
+}
+
+/* The rotation to draw an entity with: the beetle's eased one in the 3D views with smooth
+ * turning, else the game's. */
+s32 Stg40_FpDrawHeading(void *ent, s32 rot) {
+    if (Stg40_FpActive() && Host_FpSmoothTurn() && ent == (void *)Stg40_RootState->playerEnt) {
+        return Stg40_FpBodyYaw;
+    }
+    return rot;
+}
+
+/* angle *a (0..0xFFF) toward target: eased (smooth turning) or at most `step` a frame. */
+static void Stg40_FpTurnToward(s32 *a, s32 target, s32 smooth, s32 step) {
+    s32 d = ((target - *a + 0x800) & 0xFFF) - 0x800; /* shortest way, -0x800..0x7FF */
+    s32 m;
+
+    if (smooth) {
+        if (d <= FP_TURN_SNAP && d >= -FP_TURN_SNAP) {
+            m = d;
+        } else {
+            m = (s32)lrintf(d * FP_TURN_EASE);
+            if (m == 0) {
+                m = d > 0 ? 1 : -1;
+            }
+        }
+    } else {
+        m = d > step ? step : d < -step ? -step : d;
+    }
+    *a = (*a + m) & 0xFFF;
+}
+
+s32 Stg40_FpHidesEnt(void *ent) {
+    return Stg40_FpInBeetle() && ent == (void *)Stg40_RootState->playerEnt;
+}
+
+s32 Stg40_FpHidesActor(void *actor) {
+    return Stg40_FpInBeetle() && actor == (void *)Stg40_RootState->playerEnt->actor;
+}
+
+/* A hidden model's texture animation (eye blinks: Rand_Next, VRAM moves). Gfx_AnimateModelTex
+ * reads model->texSlot, which only Gfx_DrawTexModel sets: a model attached while FP is on (the
+ * beetle after a battle) has never been drawn, so set it here the way the draw does. */
+void Stg40_FpAnimateHiddenTex(void *actor) {
+    Actor *a0 = (Actor *)actor;
+    ActorModel *m = a0->model;
+
+    if (m == NULL) {
+        return;
+    }
+    m->texSlot = (struct GfxModelTexSlot *)Gfx_FindOrLoadTexSlot(m->fileId << 16);
+    Gfx_AnimateModelTex(a0);
+}
+
+/* ---- controls ---------------------------------------------------------------------------- */
+
+s32 Stg40_FpPadOctant(void *ent) {
+    Stg40Ent48 *e = (Stg40Ent48 *)ent;
+    s32 turn = 0;
+    s32 rel = 0;
+
+    Stg40_FpSync(e);
+    if (Pad_State[0].up == 0) {
+        /* Left / Right turn a quarter, Down turns around: on the press, not while held.
+         * Retail octants run 0 down, 2 left, 4 up, 6 right (clockwise on the map): facing up
+         * (4), the left hand points left (2), so left of facing is -2 */
+        if (Pad_State[0].left > 0) {
+            turn = -2;
+        } else if (Pad_State[0].right > 0) {
+            turn = 2;
+        } else if (Pad_State[0].down > 0) {
+            turn = 4;
+        }
+        Stg40_FpFacing = (Stg40_FpFacing + turn) & 7;
+        /* the beetle turns to the view (also back after a diagonal step) */
+        if ((u16)e->targetHeading != (u16)(Stg40_FpFacing << 9)) {
+            e->targetHeading = Stg40_FpFacing << 9;
+            e->octant = Stg40_FpFacing;
+        }
+        return -1;
+    }
+    if (Pad_State[0].left != 0) {
+        rel = -1;
+    } else if (Pad_State[0].right != 0) {
+        rel = 1;
+    }
+    return (Stg40_FpFacing + rel) & 7;
+}
+
+/* ---- camera ------------------------------------------------------------------------------ */
+
+/* Every camera frame, after the retail camera has set GsWSMATRIX (camera.c): read that camera
+ * back as the classic pose (in the 3D world: player-centred, rows 0.8 deep), move the facing
+ * and the transition on, and when a 3D view or a transition is up, set this frame's camera
+ * over the retail one. */
+void Stg40_FpCameraTick(void *cameraWork) {
+    Stg40CameraWork *w = (Stg40CameraWork *)cameraWork;
+    Stg40Ent48 *e;
+    Stg40FpPose live;
+    Stg40RView v;
+    Mat1F668 mtx;
+    float m[3][3];
+    float t[3];
+    float eye[3];
+    float f[3];
+    s32 target;
+    s32 smooth;
+    s32 i;
+
+    if (!Stg40_FpPoll()) {
+        return;
+    }
+    e = Stg40_RootState->playerEnt;
+
+    /* the retail camera, in the 3D world's terms */
+    mtx = GsWSMATRIX;
+    for (i = 0; i < 9; i++) {
+        m[i / 3][i % 3] = mtx.m[i / 3][i % 3] / 4096.0f;
+    }
+    for (i = 0; i < 3; i++) {
+        t[i] = (float)mtx.t[i];
+    }
+    Stg40_FpPoseFromMatrix((const float(*)[3])m, t, (float)w->view.words[6], &Stg40_FpClassic);
+    Stg40_FpClassic.offX += (Stg40_RootState->viewX - Stg40_FpOriginX()) * 40.0f;
+    Stg40_FpClassic.offZ -= (Stg40_RootState->viewY - Stg40_FpOriginY()) * 32.0f;
+    Stg40_FpClassicOk = 1;
+
+    /* the facing: the beetle's own with the retail controls, the view's with turn-and-move;
+     * the camera turns toward it, eased with smooth turning (the game's own heading and turn
+     * timing are not touched: only the camera and the beetle's drawn rotation ease) */
+    smooth = Host_FpSmoothTurn();
+    if (!Stg40_FpCtrl) {
+        Stg40_FpFacing = ((u16)e->targetHeading >> 9) & 7;
+        Stg40_FpEnt = e;
+        Stg40_FpSynced = 1;
+        target = (u16)e->heading & 0xFFF;
+        if (smooth && Stg40_FpActive()) {
+            Stg40_FpTurnToward(&Stg40_FpYaw, target, 1, 0);
+        } else {
+            Stg40_FpYaw = target;
+        }
+    } else {
+        Stg40_FpSync(e);
+        Stg40_FpTurnToward(&Stg40_FpYaw, Stg40_FpFacing << 9, smooth, FP_TURN_STEP);
+    }
+    Stg40_FpTurnToward(&Stg40_FpBodyYaw, (u16)e->heading & 0xFFF, smooth, 0x1000);
+
+    /* the transition; the controls change when it ends, never half way */
+    if (Stg40_FpT < 1.0f) {
+        Stg40_FpT += 1.0f / FP_BLEND_FRAMES;
+        if (Stg40_FpT >= 1.0f) {
+            s32 rel = Stg40_FpTo != FP_VIEW_CLASSIC;
+
+            Stg40_FpT = 1.0f;
+            if (rel && !Stg40_FpCtrl) {
+                Stg40_FpFacing &= 6; /* turn-and-move faces a side, not a diagonal */
+            }
+            Stg40_FpCtrl = rel;
+        }
+    }
+    Stg40_FpLivePose(Stg40_FpTo, &live);
+    if (Stg40_FpT < 1.0f) {
+        Stg40_FpPoseBlend(&Stg40_FpFrom, &live, Stg40_FpEase(Stg40_FpT), &Stg40_FpCur);
+    } else {
+        Stg40_FpCur = live;
+    }
+    Stg40_FpPoseEye(&Stg40_FpCur, eye, f);
+    Stg40_FpEyeH = -eye[1];
+    Stg40_FpEyeXZ = sqrtf(eye[0] * eye[0] + eye[2] * eye[2]);
+    if (!Stg40_FpActive()) {
+        return; /* classic: the retail camera stands */
+    }
+
+    /* the super coordinate: identity at the origin (the player) */
+    for (i = 0; i < 9; i++) {
+        w->coord.coord.m[i / 3][i % 3] = (i % 4 == 0) ? 0x1000 : 0;
+    }
+    w->coord.coord.t[0] = 0;
+    w->coord.coord.t[1] = 0;
+    w->coord.coord.t[2] = 0;
+    w->coord.flg = 0;
+    v.vpvr[0] = (s32)lrintf(eye[0]);
+    v.vpvr[1] = (s32)lrintf(eye[1]);
+    v.vpvr[2] = (s32)lrintf(eye[2]);
+    v.vpvr[3] = (s32)lrintf(eye[0] + f[0] * 0x1000);
+    v.vpvr[4] = (s32)lrintf(eye[1] + f[1] * 0x1000);
+    v.vpvr[5] = (s32)lrintf(eye[2] + f[2] * 0x1000);
+    v.rz = 0;
+    v.super = &w->coord;
+    GsSetProjection((s32)lrintf(Stg40_FpCur.H));
+    GsSetRefView2((void *)&v);
+}
+
+/* ---- floor ------------------------------------------------------------------------------- */
+
+/* POLY_GT3 (gouraud textured triangle), 0x28 bytes, 9 words after the tag. */
+typedef struct {
+    Stg40Tag tag;
+    u8 r0, g0, b0, code;
+    s16 x0, y0;
+    u8 u0, v0;
+    u16 clut;
+    u8 r1, g1, b1, p1;
+    s16 x1, y1;
+    u8 u1, v1;
+    u16 tpage;
+    u8 r2, g2, b2, p2;
+    s16 x2, y2;
+    u8 u2, v2;
+    u16 pad2;
+} Stg40FpGT3;
+
+typedef struct {
+    Stg40FpView view;
+    s32 shiftX; /* the game halves 640 x 480 GTE coordinates for its 320 x 240 screen */
+    s32 shiftY;
+    s32 shiftZ; /* OT index = otz >> shiftZ */
+    s32 maxOtz;
+    u8 *pkt;    /* packet cursor */
+    u8 *end;    /* end of this frame's area */
+    s32 full;
+    float q;    /* tile row depth against its width (Stg40FpPose.q) */
+} Stg40FpCtx;
+
+static s16 Stg40_FpS16(float f) {
+    return (s16)(f < -32767.0f ? -32767 : f > 32767.0f ? 32767 : lrintf(f));
+}
+
+/* One quad in packet corner order (P0 P1 / P2 P3, as POLY_FT4), textured from tpl, flat shade
+ * `shade` faded by distance; cull: draw only the side the retail wall test draws. otBias moves
+ * it back in the OT (entries). The clipped polygon goes through the GTE vertex by vertex (all
+ * in front of the near plane now, so the PGXP hook records their precise positions too) and
+ * out as a fan of POLY_GT3. */
+static void Stg40_FpQuad(Stg40FpCtx *c, const float p[4][3], const float uv[4][2], const Stg40FT4 *tpl, s32 shade,
+                         s32 cull, s32 otBias) {
+    Stg40FpVert v[FP_MAXV];
+    s32 sx[FP_MAXV];
+    s32 sy[FP_MAXV];
+    u32 *ot;
+    s32 otz;
+    s32 n;
+    s32 i;
+
+    if (c->full) {
+        return;
+    }
+    n = Stg40_FpPrepQuad(&c->view, p, uv, shade, cull, v);
+    if (n == 0) {
+        return;
+    }
+    otz = 0;
+    for (i = 0; i < n; i++) {
+        SVECTOR sv;
+        int sxy = 0;
+        int dummy = 0;
+        int flag = 0;
+
+        sv.vx = Stg40_FpS16(v[i].w[0]);
+        sv.vy = Stg40_FpS16(v[i].w[1]);
+        sv.vz = Stg40_FpS16(v[i].w[2]);
+        sv.pad = 0;
+        otz += RotTransPers(&sv, &sxy, &dummy, &flag);
+        sx[i] = (s16)(sxy & 0xFFFF) >> c->shiftX;
+        sy[i] = (s16)((u32)sxy >> 16) >> c->shiftY;
+    }
+    otz = (otz / n >> c->shiftZ) + otBias;
+    if (otz < 1) {
+        otz = 1;
+    } else if (otz > c->maxOtz) {
+        otz = c->maxOtz;
+    }
+    ot = &Sys_State.otLayers.u[3][otz];
+    for (i = 1; i + 1 < n; i++) {
+        Stg40FpGT3 *g = (Stg40FpGT3 *)c->pkt;
+        s32 k[3];
+        s32 j;
+
+        if (c->pkt + sizeof(Stg40FpGT3) > c->end) {
+            c->full = 1;
+            return;
+        }
+        k[0] = 0;
+        k[1] = i;
+        k[2] = i + 1;
+        g->tag.word = 0;
+        g->tag.b.len = 9;
+        g->code = 0x34 | (tpl->code & 2);
+        g->clut = tpl->clut;
+        g->tpage = tpl->tpage;
+        g->p1 = 0;
+        g->p2 = 0;
+        g->pad2 = 0;
+        for (j = 0; j < 3; j++) {
+            Stg40FpVert *q = &v[k[j]];
+            u8 s = Stg40_FpByte(q->shade);
+            s16 x = sx[k[j]];
+            s16 y = sy[k[j]];
+            u8 tu = Stg40_FpByte(q->u);
+            u8 tv = Stg40_FpByte(q->v);
+
+            if (j == 0) {
+                g->r0 = g->g0 = g->b0 = s;
+                g->x0 = x;
+                g->y0 = y;
+                g->u0 = tu;
+                g->v0 = tv;
+            } else if (j == 1) {
+                g->r1 = g->g1 = g->b1 = s;
+                g->x1 = x;
+                g->y1 = y;
+                g->u1 = tu;
+                g->v1 = tv;
+            } else {
+                g->r2 = g->g2 = g->b2 = s;
+                g->x2 = x;
+                g->y2 = y;
+                g->u2 = tu;
+                g->v2 = tv;
+            }
+        }
+        g->tag.word = (g->tag.word & 0xFF000000) | (*ot & 0xFFFFFF);
+        *ot = (*ot & 0xFF000000) | ((u32)(uintptr_t)c->pkt & 0xFFFFFF);
+        c->pkt += sizeof(Stg40FpGT3);
+    }
+}
+
+/* The template's four texels as floats. */
+static void Stg40_FpTplUv(const Stg40FT4 *tpl, float uv[4][2]) {
+    uv[0][0] = tpl->u0;
+    uv[0][1] = tpl->v0;
+    uv[1][0] = tpl->u1;
+    uv[1][1] = tpl->v1;
+    uv[2][0] = tpl->u2;
+    uv[2][1] = tpl->v2;
+    uv[3][0] = tpl->u3;
+    uv[3][1] = tpl->v3;
+}
+
+/* Stg40_FpQuad in nu x nv pieces. */
+static void Stg40_FpQuadN(Stg40FpCtx *c, const float p[4][3], const Stg40FT4 *tpl, s32 shade, s32 cull, s32 otBias,
+                          s32 nu, s32 nv) {
+    float uv[4][2];
+    float sp[4][3];
+    float suv[4][2];
+    s32 i;
+    s32 j;
+
+    Stg40_FpTplUv(tpl, uv);
+    for (j = 0; j < nv; j++) {
+        for (i = 0; i < nu; i++) {
+            Stg40_FpSubQuad(p, (const float(*)[2])uv, i, j, nu, nv, sp, suv);
+            Stg40_FpQuad(c, (const float(*)[3])sp, (const float(*)[2])suv, tpl, shade, cull, otBias);
+        }
+    }
+}
+
+/* POLY_F3 (flat triangle), 0x14 bytes, 4 words after the tag. */
+typedef struct {
+    Stg40Tag tag;
+    u8 r0, g0, b0, code;
+    s16 x0, y0;
+    s16 x1, y1;
+    s16 x2, y2;
+} Stg40FpF3;
+
+/* A black quad (the retail tops of solid cells, Stg40_DrawTileTop with no flags), clipped like
+ * the others and sent as a POLY_F3 fan. */
+static void Stg40_FpQuadBlack(Stg40FpCtx *c, const float p[4][3]) {
+    static const float uv[4][2] = { { 0, 0 }, { 0, 0 }, { 0, 0 }, { 0, 0 } };
+    Stg40FpVert v[FP_MAXV];
+    s32 sx[FP_MAXV];
+    s32 sy[FP_MAXV];
+    u32 *ot;
+    s32 otz;
+    s32 n;
+    s32 i;
+
+    if (c->full) {
+        return;
+    }
+    n = Stg40_FpPrepQuad(&c->view, p, uv, 0, 0, v);
+    if (n == 0) {
+        return;
+    }
+    otz = 0;
+    for (i = 0; i < n; i++) {
+        SVECTOR sv;
+        int sxy = 0;
+        int dummy = 0;
+        int flag = 0;
+
+        sv.vx = Stg40_FpS16(v[i].w[0]);
+        sv.vy = Stg40_FpS16(v[i].w[1]);
+        sv.vz = Stg40_FpS16(v[i].w[2]);
+        sv.pad = 0;
+        otz += RotTransPers(&sv, &sxy, &dummy, &flag);
+        sx[i] = (s16)(sxy & 0xFFFF) >> c->shiftX;
+        sy[i] = (s16)((u32)sxy >> 16) >> c->shiftY;
+    }
+    otz = otz / n >> c->shiftZ;
+    if (otz < 1) {
+        otz = 1;
+    } else if (otz > c->maxOtz) {
+        otz = c->maxOtz;
+    }
+    ot = &Sys_State.otLayers.u[3][otz];
+    for (i = 1; i + 1 < n; i++) {
+        Stg40FpF3 *t = (Stg40FpF3 *)c->pkt;
+
+        if (c->pkt + sizeof(Stg40FpF3) > c->end) {
+            c->full = 1;
+            return;
+        }
+        t->tag.word = 0;
+        t->tag.b.len = 4;
+        t->code = 0x20;
+        t->r0 = 0;
+        t->g0 = 0;
+        t->b0 = 0;
+        t->x0 = sx[0];
+        t->y0 = sy[0];
+        t->x1 = sx[i];
+        t->y1 = sy[i];
+        t->x2 = sx[i + 1];
+        t->y2 = sy[i + 1];
+        t->tag.word = (t->tag.word & 0xFF000000) | (*ot & 0xFFFFFF);
+        *ot = (*ot & 0xFF000000) | ((u32)(uintptr_t)c->pkt & 0xFFFFFF);
+        c->pkt += sizeof(Stg40FpF3);
+    }
+}
+
+/* Loads GsWSMATRIX into the GTE (PushMatrix; Stg40_FpEnd pops). 0 = no packet room. */
+static s32 Stg40_FpBegin(Stg40FpCtx *c) {
+    Mat1F668 mtx = GsWSMATRIX;
+    s32 margin;
+    s32 buf = Sys_State.bufIndex & 1;
+    s32 i;
+    s32 j;
+
+    if (buf != Stg40_FpPktBuf || Sys_State.frameCount != Stg40_FpPktFrame) {
+        Stg40_FpPktBuf = buf;
+        Stg40_FpPktFrame = Sys_State.frameCount;
+        Stg40_FpPktUsed = 0;
+    }
+
+    for (i = 0; i < 3; i++) {
+        for (j = 0; j < 3; j++) {
+            c->view.m[i][j] = mtx.m[i][j] / 4096.0f;
+        }
+        c->view.t[i] = (float)mtx.t[i];
+    }
+    c->shiftX = Sys_State.centerX.s != 0x140;
+    c->shiftY = Sys_State.centerY.s != 0xF0;
+    c->shiftZ = Sys_State.otLayerLen[3] - 2;
+    c->maxOtz = 0x3FFF >> c->shiftZ;
+    margin = Host_WideMargin(Sys_State.centerX.s * 2);
+    c->view.gx = (float)((Sys_State.centerX.s + margin) << c->shiftX) * FP_GUARD;
+    c->view.gy = (float)(Sys_State.centerY.s << c->shiftY) * FP_GUARD;
+    c->view.H = Stg40_FpCur.H;
+    c->view.fog = Stg40_FpCur.fog;
+    c->view.fogStart = Stg40_FpCur.fogStart;
+    c->q = Stg40_FpCur.q;
+    c->pkt = (u8 *)Stg40_FpPkt[buf] + Stg40_FpPktUsed;
+    c->end = (u8 *)Stg40_FpPkt[buf] + FP_PACKET_BYTES;
+    c->full = c->pkt + sizeof(Stg40FpGT3) > c->end;
+    PushMatrix();
+    SetRotMatrix((void *)&mtx);
+    SetTransMatrix((void *)&mtx);
+    return !c->full;
+}
+
+static void Stg40_FpEnd(Stg40FpCtx *c) {
+    PopMatrix();
+    Stg40_FpPktUsed = (s32)(c->pkt - (u8 *)Stg40_FpPkt[Stg40_FpPktBuf]);
+}
+
+static void Stg40_FpDrawCell(Stg40FpCtx *c, Stg40FloorWork *w, s32 mapCol, s32 mapRow, s32 ox, s32 oy,
+                             s32 step, s32 sub) {
+    Stg40FloorHeader *hdr = Dung_StatePtr->floorHdr;
+    Stg40Cell *cell = &((Stg40Cell *)Dung_StatePtr->cells)[mapRow * hdr->cols + mapCol];
+    u16 flags = cell->flags;
+    s32 prim = Stg40_FpCellPrimFrom(flags, Rand_GetAt(mapCol + (mapRow << 6)));
+    float cx = (float)((mapCol * 64 - ox) * 40);
+    float cz = -(mapRow * 64 - oy) * 40.0f * c->q;
+    float xs[2];
+    float zs[2];
+    float p[4][3];
+    s32 i;
+
+    xs[0] = cx - FP_HALF; /* left, right */
+    xs[1] = cx + FP_HALF;
+    zs[0] = cz + FP_HALF * c->q; /* top (map row above), bottom */
+    zs[1] = cz - FP_HALF * c->q;
+    if (flags == 0) {
+        /* a solid cell: black at the wall tops, as retail draws it, when the eye is above
+         * them (from there it hides what lies behind the rock) */
+        if (step < 0 && Stg40_FpEyeH > FP_WALL) {
+            for (i = 0; i < 4; i++) {
+                p[i][0] = xs[i & 1];
+                p[i][1] = (float)step;
+                p[i][2] = zs[i >> 1];
+            }
+            Stg40_FpQuadBlack(c, (const float(*)[3])p);
+        }
+        return;
+    }
+    {
+        /* P0 top-left, P1 top-right, P2 bottom-left, P3 bottom-right, as Stg40_DrawTileTop */
+        for (i = 0; i < 4; i++) {
+            p[i][0] = xs[i & 1];
+            p[i][1] = 0.0f;
+            p[i][2] = zs[i >> 1];
+        }
+        Stg40_FpQuadN(c, (const float(*)[3])p, &w->prims[Stg40_FloorPrimIdx[prim & 0x7F]], 0x7F, 0,
+                      FP_FLOOR_BIAS, sub, sub);
+        /* ceiling: the same tile's floor texture at the wall tops, on floors whose walls go
+         * up (step < 0), only with the eye below them; platform floors have no walls above */
+        if (Host_FpCeiling() && step < 0 && Stg40_FpEyeH < FP_WALL - 0x80) {
+            for (i = 0; i < 4; i++) {
+                p[i][1] = (float)step;
+            }
+            Stg40_FpQuadN(c, (const float(*)[3])p, &w->prims[Stg40_FloorPrimIdx[prim & 0x7F]], FP_CEILING_SHADE, 0,
+                          FP_FLOOR_BIAS, sub, sub);
+        }
+    }
+    if (flags & 0xF00) {
+        const u8 *base = &Stg40_WallPrimIdx[(u16)hdr->wallStyle * 5];
+
+        for (i = 0; i < 4; i++) {
+            Stg40WallSide *rec = &Stg40_WallSides[i];
+            s32 k;
+
+            if ((flags & rec->wallMask) == 0) {
+                continue;
+            }
+            k = (cell->wallBits >> rec->wallBitShift) & 3;
+            if (k == 0 && (prim & 0x80)) {
+                k = 4;
+            }
+            /* as Stg40_DrawTileWalls: P0 a high, P1 b high, P2 a low, P3 b low ("high" is the
+             * second level, y = step) */
+            p[0][0] = xs[rec->ax];
+            p[0][1] = (float)step;
+            p[0][2] = zs[rec->ay];
+            p[1][0] = xs[rec->bx];
+            p[1][1] = (float)step;
+            p[1][2] = zs[rec->by];
+            p[2][0] = xs[rec->ax];
+            p[2][1] = 0.0f;
+            p[2][2] = zs[rec->ay];
+            p[3][0] = xs[rec->bx];
+            p[3][1] = 0.0f;
+            p[3][2] = zs[rec->by];
+            Stg40_FpQuadN(c, (const float(*)[3])p, &w->prims[base[k]], rec->shade, 1, 0, sub,
+                          1); /* walls are half a tile high */
+        }
+    }
+}
+
+void Stg40_FpDrawFloor(void *floorWork) {
+    Stg40FloorWork *w = (Stg40FloorWork *)floorWork;
+    Stg40FloorHeader *hdr = Dung_StatePtr->floorHdr;
+    Stg40FpCtx c;
+    s32 ox = Stg40_FpOriginX();
+    s32 oy = Stg40_FpOriginY();
+    s32 pc = (ox + 32) >> 6;
+    s32 pr = (oy + 32) >> 6;
+    s32 step = hdr->field_4 != 0 ? -0x500 : 0x500;
+    s32 sub = Stg40_FpSubdiv(Host_PreciseGeometry());
+    s32 ring;
+    s32 i;
+
+    if (!Stg40_FpBegin(&c)) {
+        PopMatrix();
+        return;
+    }
+    /* nearest cells first, so a full packet buffer drops the far ones */
+    for (ring = 0; ring <= STG40_FP_RADIUS && !c.full; ring++) {
+        s32 n = ring == 0 ? 1 : ring * 8;
+
+        for (i = 0; i < n && !c.full; i++) {
+            s32 col;
+            s32 row;
+            Stg40FpVert t;
+
+            Stg40_FpRingCell(pc, pr, ring, i, &col, &row);
+            if (col < 0 || row < 0 || col >= hdr->cols || row >= hdr->rows) {
+                continue;
+            }
+            /* cells wholly behind the eye or past the fog */
+            t.w[0] = (float)((col * 64 - ox) * 40);
+            t.w[1] = 0.0f;
+            t.w[2] = -(row * 64 - oy) * 40.0f * c.q;
+            Stg40_FpToCamera(&c.view, &t);
+            if (t.c[2] < -FP_TILE * 0.75f) {
+                continue;
+            }
+            if (c.view.fog > 0.999f && sqrtf(t.w[0] * t.w[0] + t.w[2] * t.w[2]) > FP_FOG_END + FP_TILE) {
+                continue;
+            }
+            Stg40_FpDrawCell(&c, w, col, row, ox, oy, step, sub);
+        }
+    }
+    Stg40_FpEnd(&c);
+}
+
+void Stg40_FpDrawShadow(void *locp) {
+    Stg40Loc *loc = (Stg40Loc *)locp;
+    Stg40FpCtx c;
+    s32 dx = loc->posX - Stg40_FpOriginX();
+    s32 dy = loc->posY - Stg40_FpOriginY();
+    float x = (float)(dx * 40);
+    float z = -dy * 40.0f * Stg40_FpCur.q;
+    float p[4][3];
+    s32 i;
+
+    if (dx > STG40_FP_RADIUS * 64 || -dx > STG40_FP_RADIUS * 64 || dy > STG40_FP_RADIUS * 64 ||
+        -dy > STG40_FP_RADIUS * 64) {
+        return;
+    }
+    if (!Stg40_FpBegin(&c)) {
+        PopMatrix();
+        return;
+    }
+    /* Stg40_ShadowCorners: x +-0x500, z +-0x400 on the retail 0x800 rows (q 0.8) */
+    for (i = 0; i < 4; i++) {
+        p[i][0] = x + Stg40_ShadowCorners.v[i * 2];
+        p[i][1] = -8.0f;
+        p[i][2] = z + Stg40_ShadowCorners.v[i * 2 + 1] * (Stg40_FpCur.q / 0.8f);
+    }
+    Stg40_FpQuadN(&c, (const float(*)[3])p, &Stg40_FloorWork->prims[Stg40_ShadowPrimIdx], 0x7F, 0,
+                  FP_SHADOW_BIAS, 1, 1);
+    Stg40_FpEnd(&c);
+}
+
+/* ---- minimap arrow ----------------------------------------------------------------------- */
+
+static void Stg40_FpMapTri(s32 *ot, const float *pts, u8 r, u8 g, u8 b) {
+    Stg40FpF3 *t = (Stg40FpF3 *)(sptr)Sys_State.packet.addr;
+
+    t->tag.word = 0;
+    t->tag.b.len = 4;
+    t->code = 0x20;
+    t->r0 = r;
+    t->g0 = g;
+    t->b0 = b;
+    t->x0 = (s16)lrintf(pts[0]);
+    t->y0 = (s16)lrintf(pts[1]);
+    t->x1 = (s16)lrintf(pts[2]);
+    t->y1 = (s16)lrintf(pts[3]);
+    t->x2 = (s16)lrintf(pts[4]);
+    t->y2 = (s16)lrintf(pts[5]);
+    t->tag.word = (t->tag.word & 0xFF000000) | (*ot & 0xFFFFFF);
+    *ot = (*ot & 0xFF000000) | ((s32)(sptr)t & 0xFFFFFF);
+    Sys_State.packet.addr = (s32)(sptr)(t + 1);
+}
+
+/* The beetle's facing on the automap window Stg40_AutomapDrawWindow draws at x, y around cell
+ * (cx, cy) with `scale` pixels per cell: a small pointer on the beetle's marker square. Called before that
+ * window links its quads into the same OT entry, so it draws over them (an entry draws its
+ * packets newest first). A cell's texel is col + 4 (pix rows start one halfword in) and the
+ * window shows texel left + 3 at x + (left - cx) * scale, so cell col sits at
+ * x + (col + 1 - cx) * scale, row at y + (row + 1 - cy) * scale. */
+void Stg40_FpDrawMapArrow(s32 x, s32 y, s32 cx, s32 cy, s32 scale, s32 fade) {
+    Stg40Loc *loc = Dung_StatePtr->playerLoc;
+    s32 *ot = Sys_State.otLayers.s[1];
+    float sx;
+    float sy;
+    float a;
+    float dx;
+    float dy;
+    float px;
+    float py;
+    float pts[6];
+    float k;
+
+    if (!Stg40_FpRelative() || loc == NULL || fade <= 0) {
+        return; /* the pointer shows in the views that turn with the beetle */
+    }
+    Stg40_FpSync(Stg40_RootState->playerEnt);
+    sx = x + (loc->posX / 64.0f + 1.5f - cx) * scale;
+    sy = y + (loc->posY / 64.0f + 1.5f - cy) * scale;
+    a = Stg40_FpYaw * (float)(2.0 * 3.14159265358979323846 / 4096.0);
+    dx = -sinf(a); /* map direction of the view (x right, y down, as on screen) */
+    dy = cosf(a);
+    px = -dy;      /* perpendicular */
+    py = dx;
+    /* a pointer on the side of the game's own marker square the view faces: its base half a
+     * cell out (on the edge facing straight; just inside the corner facing diagonally), its tip
+     * 0.8 * FP_MAP_ARROW cells beyond. The square itself is left as the game draws it. */
+    k = FP_MAP_ARROW * scale;
+    {
+        float bx = sx + dx * 0.5f * scale;
+        float by = sy + dy * 0.5f * scale;
+
+        pts[0] = bx + dx * 0.8f * k;
+        pts[1] = by + dy * 0.8f * k;
+        pts[2] = bx + px * 0.45f * k;
+        pts[3] = by + py * 0.45f * k;
+        pts[4] = bx - px * 0.45f * k;
+        pts[5] = by - py * 0.45f * k;
+    }
+    Stg40_FpMapTri(ot, pts, (u8)(0xF0 * fade / 0xFF), (u8)(0xF0 * fade / 0xFF), (u8)(0xF0 * fade / 0xFF));
+}
+
+/* ---- mystery encounters ------------------------------------------------------------------ */
+
+/* Notes kept in host memory (they survive the overlay reload after a battle): note i for enemy
+ * party i = FP_NOTE_VALID | (boss ? FP_NOTE_BOSS : 0) | its pick (1-based index into the
+ * floor's enemySets) << FP_NOTE_PICK_SHIFT | roll 0..99; note 15 = the floor's chosen party
+ * (FP_NOTE_VALID | index), or 0 for none. */
+#define FP_NOTE_VALID 0x200
+#define FP_NOTE_BOSS 0x100
+#define FP_NOTE_PICK_SHIFT 10
+#define FP_NOTE_SWAPPED 0x4000
+#define FP_NOTE_PARTIES 10   /* notes 0..9: the floor's enemy parties (at most 10) */
+#define FP_NOTE_WON 12       /* set by the battle stage when a battle is won (stag3000) */
+#define FP_NOTE_BATTLE 13    /* the party of the battle under way: FP_NOTE_VALID | index, mystery */
+#define FP_NOTE_BATTLE_MYST 0x400
+#define FP_NOTE_ROLLED 11    /* the floor's chests already rolled for a LvlLimitBoostr (bit mask) */
+#define FP_NOTE_CHEST 14     /* the floor's chests holding a LvlLimitBoostr (bit mask) */
+#define FP_NOTE_CHOSEN 15
+
+/* Stg40_SpawnEnemyParties, per party: its boss flag, its pick, a roll from the mod's own
+ * generator. */
+void Stg40_FpNoteParty(s32 index, s32 boss, s32 pick) {
+    Host_FpSetNote(index, FP_NOTE_VALID | (boss ? FP_NOTE_BOSS : 0) | ((pick & 0xF) << FP_NOTE_PICK_SHIFT) |
+                              (s32)(Host_FpRandom() % 100));
+}
+
+/* Whether party idx shows as a ? under setting `mode` (its notes). */
+static s32 Stg40_FpMysteryIdx(s32 idx, s32 mode) {
+    s32 v;
+
+    if (mode == 0 || idx < 0 || idx >= FP_NOTE_PARTIES || Dung_StatePtr == NULL || idx >= Dung_StatePtr->partyCount) {
+        return 0;
+    }
+    v = Host_FpGetNote(idx);
+    if (!(v & FP_NOTE_VALID) || (v & FP_NOTE_BOSS)) {
+        return 0;
+    }
+    switch (mode) {
+    case 1:
+        return Host_FpGetNote(FP_NOTE_CHOSEN) == (FP_NOTE_VALID | idx);
+    case 2:
+        return (v & 0xFF) < FP_MYSTERY_PCT;
+    default:
+        return 1;
+    }
+}
+
+/* The enemy set id of a 1-based pick on this floor, 0 when the floor has none there, or it is
+ * not in the set file, or it is a boss fight. */
+static s32 Stg40_FpUsableSet(s32 pick) {
+    Stg40DungFloor *floor = (Stg40DungFloor *)(sptr)Stg40_RootState->floorMap; /* as spawn.c reads it */
+    Out1DB68 out;
+    s32 id;
+
+    if (pick < 1 || pick > 4 || floor == NULL) {
+        return 0;
+    }
+    id = floor->enemySets[pick];
+    if (id == 0 || Cd_GetFileOrNull(0xC6F) == 0 || Enemy_FindSetById(id) == NULL) {
+        return 0;
+    }
+    Enemy_GetSetSummary((void *)(sptr)id, &out);
+    return out.isBossFight ? 0 : id;
+}
+
+/* Party idx (a ? when rarer sets are on) becomes one of the floor's less common sets: every
+ * spawn point of every layout of the floor lists four picks, so a pick listed fewer times
+ * turns up less often. Only sets the floor really uses (listed somewhere) and strictly rarer
+ * than the party's own, weighted toward the rarest (1 / count); none: it stays. The party and
+ * its entity are filled in as Stg40_SpawnEnemyParties fills a new one. */
+static void Stg40_FpSwapRarer(s32 idx) {
+    Stg40DungFloor *floor = (Stg40DungFloor *)(sptr)Stg40_RootState->floorMap; /* as spawn.c reads it */
+    Stg40Drop *r;
+    Stg40EnemyParty *s = (Stg40EnemyParty *)Dung_StatePtr->parties[idx];
+    Stg40Ent48 *e = NULL;
+    Out1DB68 out;
+    s32 note = Host_FpGetNote(idx);
+    s32 cur = (note >> FP_NOTE_PICK_SHIFT) & 0xF;
+    s32 cnt[16];
+    float w[5];
+    float total = 0.0f;
+    float x;
+    s32 id;
+    s32 k;
+    s32 i;
+    s32 m;
+
+    if (floor == NULL) {
+        return;
+    }
+    for (k = 0; k < 16; k++) {
+        cnt[k] = 0;
+    }
+    for (i = 0; i < 8; i++) {
+        Stg40DungLayout *lay;
+
+        if (floor->layouts[i] == 0) {
+            continue;
+        }
+        lay = P32(Stg40DungLayout, floor->layouts[i]);
+        if (lay->enemyParties == 0) {
+            continue;
+        }
+        for (r = P32(Stg40Drop, lay->enemyParties); r->x != 0xFF; r++) {
+            cnt[r->pick0]++;
+            cnt[r->pick1]++;
+            cnt[r->pick2]++;
+            cnt[r->pick3]++;
+        }
+    }
+    if (cur < 1 || cur > 4) {
+        return;
+    }
+    for (k = 1; k <= 4; k++) {
+        w[k] = 0.0f;
+        if (k == cur || cnt[k] == 0 || cnt[k] >= cnt[cur] || Stg40_FpUsableSet(k) == 0 ||
+            Stg40_FpUsableSet(k) == s->setId) {
+            continue;
+        }
+        w[k] = 1.0f / cnt[k];
+        total += w[k];
+    }
+    if (total <= 0.0f) {
+        return;
+    }
+    x = (Host_FpRandom() % 10000) / 10000.0f * total;
+    for (k = 1; k < 4 && x >= w[k]; k++) {
+        x -= w[k];
+    }
+    while (k > 1 && w[k] <= 0.0f) {
+        k--; /* rounding landed past the last weighted pick */
+    }
+    if (w[k] <= 0.0f) {
+        return;
+    }
+    id = Stg40_FpUsableSet(k);
+    for (i = 0; i < Dung_StatePtr->entCount; i++) {
+        if (Dung_StatePtr->ents[i].kind == 1 && Dung_StatePtr->ents[i].params == (u8 *)s) {
+            e = &Dung_StatePtr->ents[i];
+            break;
+        }
+    }
+    if (e == NULL) {
+        return;
+    }
+    Enemy_GetSetSummary((void *)(sptr)id, &out);
+    e->digiId = out.mapDigiId;
+    if (e->digiId >= 500 && e->digiId <= 532) {
+        e->scaleX = e->scaleY = e->scaleZ = 0xD99;
+    } else {
+        e->scaleX = e->scaleY = e->scaleZ = 0x1000;
+    }
+    s->setId = id;
+    s->useDungeonBgm = out.useDungeonBgm != 0;
+    s->likedGift = out.likedGift;
+    s->pointsPerLevel = out.pointsPerLevel != 0 ? out.pointsPerLevel : 1;
+    s->giftsTaken = 0;
+    s->giftPoints = 0;
+    s->stepsPerBurst = Stg40_EnemyPaceTable[out.paceType * 2];
+    s->idleTicks = Stg40_EnemyPaceTable[out.paceType * 2 + 1];
+    s->cellCode = Stg40_EnemyAiTable[out.aiType * 2];
+    m = s->pathMode = Stg40_EnemyAiTable[out.aiType * 2 + 1];
+    if (m == 2 && s->cellCode != (Stg40_GetCellFlags(e->loc.u0.pair.field_0, e->loc.u0.pair.field_2) & 0xF)) {
+        s->cellCode = m;
+        s->pathMode = 0;
+    }
+    s->digiCount = 0;
+    for (i = 0; i < 3; i++) {
+        if ((s16)out.digiIds[i] == 0) {
+            break;
+        }
+        s->digiIds[i] = out.digiIds[i];
+        s->levels[i] = out.levels[i];
+        s->digiCount++;
+    }
+    Host_FpSetNote(idx, (note & ~(0xF << FP_NOTE_PICK_SHIFT)) | (k << FP_NOTE_PICK_SHIFT) | FP_NOTE_SWAPPED);
+}
+
+/* Stg40_SpawnEnemyParties, at the end: clears notes of unused slots, picks the floor's one
+ * mystery party among those that are not bosses, and (rarer sets on) swaps each party that
+ * will show as a ? under the current setting for a rarer set of the floor. */
+void Stg40_FpRollMystery(void) {
+    s32 n = Dung_StatePtr->partyCount;
+    s32 mode = Host_FpMystery();
+    s32 pick[16];
+    s32 count = 0;
+    s32 i;
+
+    for (i = 0; i < FP_NOTE_PARTIES; i++) {
+        s32 v = Host_FpGetNote(i);
+
+        if (i >= n) {
+            Host_FpSetNote(i, 0);
+        } else if ((v & FP_NOTE_VALID) && !(v & FP_NOTE_BOSS)) {
+            pick[count++] = i;
+        }
+    }
+    Host_FpSetNote(FP_NOTE_CHOSEN, count != 0 ? FP_NOTE_VALID | pick[Host_FpRandom() % count] : 0);
+    if (mode != 0 && Host_FpMysteryRare()) {
+        for (i = 0; i < n && i < FP_NOTE_PARTIES; i++) {
+            if (Stg40_FpMysteryIdx(i, mode)) {
+                Stg40_FpSwapRarer(i);
+            }
+        }
+    }
+}
+
+/* The entity is a wandering enemy party shown as a ? (the F1 setting, its notes). */
+s32 Stg40_FpMystery(void *ent) {
+    Stg40Ent48 *e = (Stg40Ent48 *)ent;
+    sptr off;
+
+    if (Host_FpMystery() == 0 || e == NULL || e->kind != 1 || e->params == NULL || Dung_StatePtr == NULL) {
+        return 0;
+    }
+    off = (sptr)e->params - (sptr)Dung_StatePtr->parties[0];
+    if (off < 0 || off % (sptr)sizeof(Dung_StatePtr->parties[0]) != 0) {
+        return 0;
+    }
+    return Stg40_FpMysteryIdx((s32)(off / (sptr)sizeof(Dung_StatePtr->parties[0])), Host_FpMystery());
+}
+
+/* ---- LvlLimitBoostr ---------------------------------------------------------------------- */
+
+/* A one-use item, never kept in the bag (so saves stay readable by the official port): found,
+ * it asks at once which party Digimon gets +1 to its level limit, or None. Usable on a
+ * Digimon at its limit whose limit is below 99. Found (F1 checkboxes, on by default) in 1 % of
+ * all chests, rolled the first time each is opened (None leaves it in the chest, which stays
+ * closed), and in 1 % of won ? encounters, right after the battle (None loses it). */
+
+/* ASCII to game glyphs (host/devedit.c's table): '^' a new line, '{' the (X) button, '}' the
+ * (O) button, '>' the cursor; 0xFF ends. */
+static s32 Stg40_FpGlyphs(const char *s, u8 *out, s32 at, s32 max) {
+    static const char punct[] = "&?!/-,.'\";:%+=#>";
+    static const u8 punctGlyph[] = { 0x42, 0x44, 0x45, 0x46, 0x49, 0x54, 0x55, 0x56, 0x57,
+                                     0x58, 0x59, 0x5A, 0x5B, 0x5C, 0x5D, 0x53 };
+    const char *p;
+
+    for (; *s != 0 && at < max - 1; s++) {
+        char ch = *s;
+
+        if (ch >= '0' && ch <= '9') {
+            out[at++] = (u8)(ch - '0');
+        } else if (ch >= 'A' && ch <= 'Z') {
+            out[at++] = (u8)(0x0A + ch - 'A');
+        } else if (ch >= 'a' && ch <= 'z') {
+            out[at++] = (u8)(0x24 + ch - 'a');
+        } else if (ch == ' ') {
+            out[at++] = 0xFD;
+        } else if (ch == '^') {
+            out[at++] = 0xFE;
+        } else if (ch == '{') {
+            out[at++] = 0x3F;
+        } else if (ch == '}') {
+            out[at++] = 0x3E;
+        } else if ((p = strchr(punct, ch)) != NULL) {
+            out[at++] = punctGlyph[p - punct];
+        }
+    }
+    out[at] = 0xFF;
+    return at;
+}
+
+/* A number as glyphs (digits are glyphs 0..9). */
+static s32 Stg40_FpGlyphNum(s32 v, u8 *out, s32 at, s32 max) {
+    char b[12];
+    s32 n = 0;
+
+    if (v < 0) {
+        v = 0;
+    }
+    do {
+        b[n++] = (char)(v % 10);
+        v /= 10;
+    } while (v != 0 && n < 11);
+    while (n > 0 && at < max - 1) {
+        out[at++] = (u8)b[--n];
+    }
+    out[at] = 0xFF;
+    return at;
+}
+
+/* A Digimon's name (already glyphs, 0xFF-ended, at most 13). */
+static s32 Stg40_FpGlyphName(const u8 *name, u8 *out, s32 at, s32 max) {
+    s32 i;
+
+    for (i = 0; i < 13 && name[i] != 0xFF && at < max - 1; i++) {
+        out[at++] = name[i];
+    }
+    out[at] = 0xFF;
+    return at;
+}
+
+#define FP_BOOST_PCT 1     /* % of chests, and of won ? encounters, that give one */
+#define FP_TEXT_MAX 192
+
+static struct {
+    s32 sel;               /* 0..count-1 a party Digimon, count = None */
+    s32 count;
+    DigiRosterEntry *party[3];
+    s32 used;              /* the result: 1 used, 2 none */
+    s32 shown;             /* what the open prompt shows (rebuilt on a change) */
+    s32 frames;            /* frames the prompt has been up (no input in the first ones) */
+} Stg40_FpBoost;
+static u8 Stg40_FpBoostText[FP_TEXT_MAX];
+
+static s32 Stg40_FpBoostOk(const DigiRosterEntry *e) {
+    return e->level >= e->maxLevel && e->maxLevel < 99;
+}
+
+/* The prompt's text: a box, the title, the selected choice and a hint (3 lines). */
+static void Stg40_FpBoostBuild(s32 chest) {
+    u8 *t = Stg40_FpBoostText;
+    s32 n = 0;
+
+    t[n++] = 0xFA; /* the message box (as the dungeon's messages open it) */
+    t[n++] = 0x00;
+    n = Stg40_FpGlyphs("A LvlLimitBoostr! Use it on:^", t, n, FP_TEXT_MAX);
+    if (Stg40_FpBoost.sel < Stg40_FpBoost.count) {
+        DigiRosterEntry *e = Stg40_FpBoost.party[Stg40_FpBoost.sel];
+
+        n = Stg40_FpGlyphs("> ", t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphName(e->name, t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphs(" Lv", t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphNum(e->level, t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphs("/", t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphNum(e->maxLevel, t, n, FP_TEXT_MAX);
+        if (e->maxLevel >= 99) {
+            n = Stg40_FpGlyphs("^Its limit is already 99.", t, n, FP_TEXT_MAX);
+        } else if (e->level < e->maxLevel) {
+            n = Stg40_FpGlyphs("^Not at its level limit yet.", t, n, FP_TEXT_MAX);
+        } else {
+            n = Stg40_FpGlyphs("^{ Use   } None   Up/Down", t, n, FP_TEXT_MAX);
+        }
+    } else {
+        n = Stg40_FpGlyphs("> None^", t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphs(chest ? "{ Leave it in the chest" : "{ Leave it", t, n, FP_TEXT_MAX);
+    }
+    t[n] = 0xFF;
+}
+
+static void Stg40_FpBoostOpen(void) {
+    TextOpenArgs arg;
+
+    memset(&arg, 0, sizeof(arg));
+    arg.bigFont = 1;
+    arg.color = 0;
+    arg.x = 0;
+    arg.y = 0;
+    arg.charAdvance = 0;
+    arg.lineAdvance = 0xF;
+    arg.text = (s32)(sptr)Stg40_FpBoostText;
+    arg.charDelay = 0; /* shown at once: drawn whole each frame, so it can be rewritten */
+    arg.strArg0 = 0;
+    arg.strArg1 = 0;
+    Text_Open(&Stg40_MsgWinTexts[1], &arg);
+}
+
+/* The result message ((X) closes it). */
+static void Stg40_FpBoostResult(s32 chest) {
+    u8 *t = Stg40_FpBoostText;
+    s32 n = 0;
+    TextOpenArgs arg;
+
+    t[n++] = 0xFA;
+    t[n++] = 0x00;
+    if (Stg40_FpBoost.used == 1) {
+        DigiRosterEntry *e = Stg40_FpBoost.party[Stg40_FpBoost.sel];
+
+        n = Stg40_FpGlyphName(e->name, t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphs("'s level limit^rose to ", t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphNum(e->maxLevel, t, n, FP_TEXT_MAX);
+        n = Stg40_FpGlyphs("!", t, n, FP_TEXT_MAX);
+    } else {
+        n = Stg40_FpGlyphs(chest ? "You left the LvlLimitBoostr^in the chest." : "You left the LvlLimitBoostr.", t,
+                           n, FP_TEXT_MAX);
+    }
+    t[n++] = 0xFB; /* wait for (X) */
+    t[n] = 0xFF;
+    memset(&arg, 0, sizeof(arg));
+    arg.bigFont = 1;
+    arg.color = 0;
+    arg.x = 0;
+    arg.y = 0;
+    arg.charAdvance = 0;
+    arg.lineAdvance = 0xF;
+    arg.text = (s32)(sptr)Stg40_FpBoostText;
+    arg.charDelay = 1;
+    arg.strArg0 = 0;
+    arg.strArg1 = 0;
+    Text_Open(&Stg40_MsgWinTexts[1], &arg);
+}
+
+/* The prompt, run by a player state (a0->stateLevel2 from 10 on): 0 while it runs, then 1 the
+ * item was used, 2 None. */
+s32 Stg40_FpBoostPrompt(void *actor, s32 chest) {
+    Actor *a0 = (Actor *)actor;
+    s32 i;
+
+    switch (a0->stateLevel2) {
+    case 10:
+    default:
+        Stg40_FpBoost.count = 0;
+        for (i = 0; i < 3; i++) {
+            if (Save_GameState.elems[i].state >= 3) {
+                Stg40_FpBoost.party[Stg40_FpBoost.count++] = &Save_GameState.elems[i];
+            }
+        }
+        Stg40_FpBoost.sel = Stg40_FpBoost.count; /* None, unless someone can take it */
+        for (i = Stg40_FpBoost.count - 1; i >= 0; i--) {
+            if (Stg40_FpBoostOk(Stg40_FpBoost.party[i])) {
+                Stg40_FpBoost.sel = i;
+            }
+        }
+        Stg40_FpBoost.used = 0;
+        Stg40_FpBoost.frames = 0;
+        Stg40_FpBoost.shown = Stg40_FpBoost.sel;
+        Stg40_FpBoostBuild(chest);
+        Stg40_FpBoostOpen();
+        Snd_PlayById(0x19, 0);
+        Task_SetState2(a0, 11);
+        return 0;
+    case 11:
+        if (++Stg40_FpBoost.frames < 8) {
+            return 0; /* let the box open, and the button that got here go */
+        }
+        if (Pad_State[0].up > 0 || Pad_State[0].left > 0) {
+            Stg40_FpBoost.sel = Stg40_FpBoost.sel == 0 ? Stg40_FpBoost.count : Stg40_FpBoost.sel - 1;
+        } else if (Pad_State[0].down > 0 || Pad_State[0].right > 0) {
+            Stg40_FpBoost.sel = Stg40_FpBoost.sel >= Stg40_FpBoost.count ? 0 : Stg40_FpBoost.sel + 1;
+        } else if (Pad_State[0].circle > 0) {
+            Stg40_FpBoost.sel = Stg40_FpBoost.count;
+            Stg40_FpBoost.used = 2;
+        } else if (Pad_State[0].cross > 0) {
+            if (Stg40_FpBoost.sel >= Stg40_FpBoost.count) {
+                Stg40_FpBoost.used = 2;
+            } else if (Stg40_FpBoostOk(Stg40_FpBoost.party[Stg40_FpBoost.sel])) {
+                Stg40_FpBoost.party[Stg40_FpBoost.sel]->maxLevel++;
+                Stg40_FpBoost.used = 1;
+            } else {
+                Snd_PlayById(0x1C, 0); /* can't: the bag-full sound */
+            }
+        }
+        if (Stg40_FpBoost.used != 0) {
+            Stg40_MsgWinClose(1);
+            Snd_PlayById(Stg40_FpBoost.used == 1 ? 0x19 : 0x13, 0);
+            Task_SetState2(a0, 12);
+            return 0;
+        }
+        if (Stg40_FpBoost.sel != Stg40_FpBoost.shown) {
+            /* the next choice: the open box's text is rewritten in place (the text engine
+             * reads it again each frame; its one command, the box, stays first and done) */
+            Snd_PlayById(0xC, 0);
+            Stg40_FpBoost.shown = Stg40_FpBoost.sel;
+            Stg40_FpBoostBuild(chest);
+        }
+        return 0;
+    case 12:
+        Stg40_FpBoostResult(chest);
+        Task_SetState2(a0, 13);
+        return 0;
+    case 13:
+        if (Stg40_MsgWinCloseIfDone(1) == 1) {
+            return Stg40_FpBoost.used;
+        }
+        return 0;
+    }
+}
+
+/* Battle start (stag4000.c, the encounter): which party, and whether it shows as a ?. */
+void Stg40_FpNoteBattle(void *ent) {
+    Stg40Ent48 *e = (Stg40Ent48 *)ent;
+    sptr off = (sptr)e->params - (sptr)Dung_StatePtr->parties[0];
+    s32 idx = (s32)(off / (sptr)sizeof(Dung_StatePtr->parties[0]));
+
+    Host_FpSetNote(FP_NOTE_WON, 0);
+    Host_FpSetNote(FP_NOTE_BATTLE, FP_NOTE_VALID | (idx & 0xFF) | (Stg40_FpMystery(e) ? FP_NOTE_BATTLE_MYST : 0));
+}
+
+/* Back from a battle (once): a won ? battle gives a LvlLimitBoostr 1 % of the time (F1). */
+s32 Stg40_FpBattleBoostDue(void) {
+    s32 b = Host_FpGetNote(FP_NOTE_BATTLE);
+    s32 won = Host_FpGetNote(FP_NOTE_WON);
+
+    Host_FpSetNote(FP_NOTE_BATTLE, 0);
+    Host_FpSetNote(FP_NOTE_WON, 0);
+    if (!(b & FP_NOTE_VALID) || !(b & FP_NOTE_BATTLE_MYST) || won == 0) {
+        return 0;
+    }
+    return Host_FpBoostBattles() && Host_FpRandom() % 100 < FP_BOOST_PCT;
+}
+
+/* After Stg40_SpawnChests on a new floor: no chest rolled or holding one yet. */
+void Stg40_FpRollChestBoost(void) {
+    Host_FpSetNote(FP_NOTE_ROLLED, 0);
+    Host_FpSetNote(FP_NOTE_CHEST, 0);
+}
+
+/* The bit of a chest record (Stg40_SpawnChests: chests[n + 1], 12 records), -1 none. */
+static s32 Stg40_FpChestBit(void *rec) {
+    sptr off = (u8 *)rec - Dung_StatePtr->chests[0];
+
+    if (off < 0 || off % (sptr)sizeof(Dung_StatePtr->chests[0]) != 0) {
+        return -1;
+    }
+    off /= (sptr)sizeof(Dung_StatePtr->chests[0]);
+    return off < 12 ? (s32)off : -1;
+}
+
+/* The chest holds a LvlLimitBoostr (asked once as it is opened, Stg40_PlayerTakeChestItem):
+ * every chest is rolled the first time it is opened, 1 % (F1); one left with None keeps it. */
+s32 Stg40_FpChestHasBoost(void *rec) {
+    s32 bit = Stg40_FpChestBit(rec);
+    s32 rolled;
+
+    if (bit < 0) {
+        return 0;
+    }
+    if (Host_FpGetNote(FP_NOTE_CHEST) & (1 << bit)) {
+        return 1;
+    }
+    rolled = Host_FpGetNote(FP_NOTE_ROLLED);
+    if (rolled & (1 << bit)) {
+        return 0; /* rolled before: a bag that was full can't roll it again */
+    }
+    Host_FpSetNote(FP_NOTE_ROLLED, rolled | (1 << bit));
+    if (Host_FpBoostChests() && Host_FpRandom() % 100 < FP_BOOST_PCT) {
+        Host_FpSetNote(FP_NOTE_CHEST, Host_FpGetNote(FP_NOTE_CHEST) | (1 << bit));
+        return 1;
+    }
+    return 0;
+}
+
+/* The chest's LvlLimitBoostr was used. */
+void Stg40_FpChestBoostTaken(void *rec) {
+    s32 bit = Stg40_FpChestBit(rec);
+
+    if (bit >= 0) {
+        Host_FpSetNote(FP_NOTE_CHEST, Host_FpGetNote(FP_NOTE_CHEST) & ~(1 << bit));
+    }
+}
+
+/* POLY_G3 (gouraud flat triangle), 0x1C bytes, 6 words after the tag. */
+typedef struct {
+    Stg40Tag tag;
+    u8 r0, g0, b0, code;
+    s16 x0, y0;
+    u8 r1, g1, b1, p1;
+    s16 x1, y1;
+    u8 r2, g2, b2, p2;
+    s16 x2, y2;
+} Stg40FpG3;
+
+/* A flat-coloured quad (corner order P0 P1 / P2 P3), both sides, faded like the floor. */
+static void Stg40_FpQuadColor(Stg40FpCtx *c, const float p[4][3], u8 r, u8 g, u8 b) {
+    static const float uv[4][2] = { { 0, 0 }, { 0, 0 }, { 0, 0 }, { 0, 0 } };
+    Stg40FpVert v[FP_MAXV];
+    s32 sx[FP_MAXV];
+    s32 sy[FP_MAXV];
+    u32 *ot;
+    s32 otz;
+    s32 n;
+    s32 i;
+
+    if (c->full) {
+        return;
+    }
+    n = Stg40_FpPrepQuad(&c->view, p, uv, 255, 0, v);
+    if (n == 0) {
+        return;
+    }
+    otz = 0;
+    for (i = 0; i < n; i++) {
+        SVECTOR sv;
+        int sxy = 0;
+        int dummy = 0;
+        int flag = 0;
+
+        sv.vx = Stg40_FpS16(v[i].w[0]);
+        sv.vy = Stg40_FpS16(v[i].w[1]);
+        sv.vz = Stg40_FpS16(v[i].w[2]);
+        sv.pad = 0;
+        otz += RotTransPers(&sv, &sxy, &dummy, &flag);
+        sx[i] = (s16)(sxy & 0xFFFF) >> c->shiftX;
+        sy[i] = (s16)((u32)sxy >> 16) >> c->shiftY;
+    }
+    otz = otz / n >> c->shiftZ;
+    if (otz < 1) {
+        otz = 1;
+    } else if (otz > c->maxOtz) {
+        otz = c->maxOtz;
+    }
+    ot = &Sys_State.otLayers.u[3][otz];
+    for (i = 1; i + 1 < n; i++) {
+        Stg40FpG3 *t = (Stg40FpG3 *)c->pkt;
+        s32 k[3];
+        s32 j;
+
+        if (c->pkt + sizeof(Stg40FpG3) > c->end) {
+            c->full = 1;
+            return;
+        }
+        k[0] = 0;
+        k[1] = i;
+        k[2] = i + 1;
+        t->tag.word = 0;
+        t->tag.b.len = 6;
+        t->code = 0x30;
+        t->p1 = 0;
+        t->p2 = 0;
+        for (j = 0; j < 3; j++) {
+            float f = v[k[j]].shade / 255.0f;
+            u8 cr = Stg40_FpByte(r * f);
+            u8 cg = Stg40_FpByte(g * f);
+            u8 cb = Stg40_FpByte(b * f);
+
+            if (j == 0) {
+                t->r0 = cr;
+                t->g0 = cg;
+                t->b0 = cb;
+                t->x0 = sx[k[j]];
+                t->y0 = sy[k[j]];
+            } else if (j == 1) {
+                t->r1 = cr;
+                t->g1 = cg;
+                t->b1 = cb;
+                t->x1 = sx[k[j]];
+                t->y1 = sy[k[j]];
+            } else {
+                t->r2 = cr;
+                t->g2 = cg;
+                t->b2 = cb;
+                t->x2 = sx[k[j]];
+                t->y2 = sy[k[j]];
+            }
+        }
+        t->tag.word = (t->tag.word & 0xFF000000) | (*ot & 0xFFFFFF);
+        *ot = (*ot & 0xFF000000) | ((u32)(uintptr_t)c->pkt & 0xFFFFFF);
+        c->pkt += sizeof(Stg40FpG3);
+    }
+}
+
+/* A floating ? over a map position, bobbing, always facing the camera (a sign, so it reads
+ * from any view, the steep classic one too), in whichever view is up: world positions come
+ * from Stg40_FpWorldX / Z, the camera from GsWSMATRIX (its rows are the camera's axes). */
+void Stg40_FpDrawMystery(void *locp) {
+    static const char glyph[7][6] = { ".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.." };
+    Stg40Loc *loc = (Stg40Loc *)locp;
+    Stg40FpCtx c;
+    float right[3];
+    float up[3];
+    float cx;
+    float cz;
+    float cy;
+    float n;
+    float half = FP_MYSTERY_PIX * 0.5f;
+    s32 gx;
+    s32 gy;
+    s32 k;
+
+    if (!Stg40_FpPoll() || Stg40_FpOutOfRange(loc->posX, loc->posY)) {
+        return;
+    }
+    if (!Stg40_FpBegin(&c)) {
+        PopMatrix();
+        return;
+    }
+    n = sqrtf(c.view.m[0][0] * c.view.m[0][0] + c.view.m[0][1] * c.view.m[0][1] + c.view.m[0][2] * c.view.m[0][2]);
+    for (k = 0; k < 3; k++) {
+        right[k] = n > 0.0f ? c.view.m[0][k] / n : (k == 0);
+    }
+    n = sqrtf(c.view.m[1][0] * c.view.m[1][0] + c.view.m[1][1] * c.view.m[1][1] + c.view.m[1][2] * c.view.m[1][2]);
+    for (k = 0; k < 3; k++) {
+        up[k] = n > 0.0f ? -c.view.m[1][k] / n : -(float)(k == 1); /* camera y points down */
+    }
+    cx = (float)Stg40_FpWorldX(loc->posX);
+    cz = (float)Stg40_FpWorldZ(loc->posY);
+    cy = -(FP_MYSTERY_HEIGHT + loc->height + sinf(Sys_State.frameCount * 0.1f) * 0x80);
+    for (gy = 0; gy < 7; gy++) {
+        for (gx = 0; gx < 5; gx++) {
+            float lx;
+            float ly;
+            float p[4][3];
+
+            if (glyph[gy][gx] != '#') {
+                continue;
+            }
+            lx = (gx - 2) * (float)FP_MYSTERY_PIX;
+            ly = (3 - gy) * (float)FP_MYSTERY_PIX; /* up from the middle */
+            for (k = 0; k < 4; k++) {
+                float sx = lx + ((k & 1) ? half : -half);
+                float sy = ly + ((k & 2) ? -half : half);
+
+                p[k][0] = cx + right[0] * sx + up[0] * sy;
+                p[k][1] = cy + right[1] * sx + up[1] * sy;
+                p[k][2] = cz + right[2] * sx + up[2] * sy;
+            }
+            Stg40_FpQuadColor(&c, (const float(*)[3])p, 0xFF, 0xD8, 0x30);
+        }
+    }
+    Stg40_FpEnd(&c);
+}
